          calendarRules,
        })
      : false;

  return (
    <Pressable
      key={s.id}
      disabled={applyActionPending}
      onPress={() => {
        if (!applyEventTarget || applyActionPending) return;

        const nextEventTitle =
          typeof applyEventTarget.eventTitle === "string" &&
          applyEventTarget.eventTitle.trim().length > 0
            ? applyEventTarget.eventTitle.trim()
            : "Selected event";

        setApplyActionMenuTarget({
          goalId: selectedGoalForApply,
          subtaskId: s.id,
          subtaskTitle: s.title,
          mode: "unlinked",
          existingLinkedTitle: null,
          nextEventTitle,
        });
      }}
      style={[
  styles.applyGoalOption,
  isSuggestedApplySubtask && styles.applyActionSheetOptionSuggested,
  //isPossibleApplyMatchSubtask && styles.applyActionSheetOptionPossible,
