) : (
selectedSplit.due.map((t) => {
  const key = `${t.goalId}:${t.subtaskId}:${dateKey(t.date)}`;
 const pending = pendingKeys.has(key);
const pendingSuggestedTime = pendingSuggestedTimeKeys.has(key);
const pendingSnooze = pendingSnoozeKeys.has(key);
const pendingSkip = pendingSkipKeys.has(key);
const pendingUnscheduled = pendingUnscheduledKeys.has(key);
const pendingClearOverride = pendingClearOverrideKeys.has(key);
const pendingReassign = pendingReassignKeys.has(key);
const recentlyRescheduled = recentlyRescheduledKeys.has(key);
const overlapEntry = selectedDayOverlapMap.get(key);
  const overlappingEvents = overlapEntry?.overlappingEvents ?? [];
  const suggestedSlot = overlapEntry?.suggestedSlot ?? null;
  const pendingReassignTomorrow = pendingReassignTomorrowKeys.has(key);
const linkedEventActionPending = pendingLinkedEventActionKeys.has(
  getLinkedEventActionKey(t)
);

const isCompleted = completedSubtaskIdsForDay.has(t.subtaskId);
const pendingAnyOverrideAction =
  pendingSuggestedTime ||
  pendingSnooze ||
  pendingSkip ||
  pendingUnscheduled ||
  pendingClearOverride ||
  pendingReassign ||
  pendingReassignTomorrow;
const linkedEventTimeMismatched = isLinkedEventTimeMismatched(
  t,
  allGoogleEventsById
);
const shouldShowLinkedEvent = shouldShowLinkedEventForItem(t);
const recoveryNotBeforeMs = getRecoverySuggestionNotBeforeMs({
  itemDate: t.date,
  dueAtMs: t.dueAtMs ?? null,
});

const recoverySlot = findFirstAvailableSlotOnDateNotBefore(
  t.date,
  selectedDayGoogleEvents,
  DEFAULT_SUGGESTED_SLOT_MINUTES,
  recoveryNotBeforeMs
);

const linkedEventMissing = isLinkedEventMissing(t, allGoogleEventsById);
const latestLinkedEventHistory =
  latestLinkedEventHistoryBySubtaskId[t.subtaskId] ?? null;

  const linkedEventAlignmentHint = formatLinkedEventAlignmentHint(
  latestLinkedEventHistory
);

const linkedEventHistoryReasonLabel = formatLinkedEventHistoryReason(
  latestLinkedEventHistory?.reason ?? null
