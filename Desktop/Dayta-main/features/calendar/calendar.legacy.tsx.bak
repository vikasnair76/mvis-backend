    </Text>

    <Text style={styles.suggestedTaskGoalText}>
      Goal: {suggestedTaskMatch.topMatch.item.goalTitle}
    </Text>

    {savedPreferenceForSuggestedTask && (
      <View style={styles.savedPreferenceBadge}>
        <Text style={styles.savedPreferenceBadgeText}>✨ Saved preference</Text>
      </View>
    )}

    

    <Text style={styles.suggestedTaskReasonText}>
      Apply will jump straight to this goal’s subtasks
    </Text>

