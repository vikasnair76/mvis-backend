};

type LatestLinkedEventHistory = {
  decision: string | null;
  reason: string | null;
  previousHandledStartMs: number | null;
  nextEventStartMs: number | null;
  handledAtMs: number | null;
  oldOverrideDueAtMs: number | null;
  oldOverrideSource: string | null;
};

function monthRangeDayKeys(anchor: Date, tz: string) {
  const y = anchor.getFullYear();
  const m = anchor.getMonth();
  const start = new Date(y, m, 1);
  const end = new Date(y, m + 1, 0);
  return {
    startDayKey: dayKeyFromDate(start, tz),
    endDayKey: dayKeyFromDate(end, tz),
  };
}

function weekRangeDayKeys(weekDates: Date[], tz: string) {
  const start = weekDates[0];
  const end = weekDates[6];
  return {
    startDayKey: dayKeyFromDate(start, tz),
    endDayKey: dayKeyFromDate(end, tz),
  };
}

function buildHeatmapFromCompletionSnapshot(
  snap: any,
  activeGoalIds?: Set<string>
): HeatmapByDayKey {
  const heat: HeatmapByDayKey = {};

  snap.forEach((docSnap: any) => {
    const data = docSnap.data() as any;

    const dayKey = String(data?.dayKey ?? "");
    const goalId = String(data?.goalId ?? "");
    if (!dayKey) return;

    if (activeGoalIds && goalId && !activeGoalIds.has(goalId)) return;

    const mv = data?.metricValue;
    const metricValue =
      typeof mv === "number" && Number.isFinite(mv) ? mv : 0;

    if (!heat[dayKey]) {
      heat[dayKey] = { count: 0, metricSum: 0 };
    }

    heat[dayKey].count += 1;
    heat[dayKey].metricSum += metricValue;
  });

  return heat;
}

function getCombinedCompletionCountForDay(
  dayKey: string,
  heatByDayKey: HeatmapByDayKey,
  goalCompletionCountsByDay: Record<string, number>
) {
  const subtaskCount = heatByDayKey[dayKey]?.count ?? 0;
  const goalCount = goalCompletionCountsByDay[dayKey] ?? 0;
  return subtaskCount + goalCount;
}

