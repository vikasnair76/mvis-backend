      ? currentEvent.rawUpdated.trim()
      : null,

  linkedCalendarLastHandledStartMs:
    typeof currentEvent?.startMs === "number"
      ? currentEvent.startMs
      : typeof subtask.linkedCalendarLastHandledStartMs === "number"
      ? subtask.linkedCalendarLastHandledStartMs
      : typeof subtask.linkedCalendarEventStartMs === "number"
      ? subtask.linkedCalendarEventStartMs
      : null,

  linkedCalendarLastHandledEndMs:
    typeof currentEvent?.endMs === "number"
      ? currentEvent.endMs
      : null,

  linkedCalendarLastHandledUpdatedRaw:
    typeof currentEvent?.rawUpdated === "string" &&
    currentEvent.rawUpdated.trim().length > 0
      ? currentEvent.rawUpdated.trim()
      : null,

  linkedCalendarLastSyncedAtMs: now,
});

applyLocalSubtaskPatch(subtask.goalId, subtask.id, {
  linkedCalendarLastKnownMissing: false,
  linkedCalendarMissingAtMs: null,

  linkedCalendarEventTitle:
    typeof currentEvent?.title === "string" &&
    currentEvent.title.trim().length > 0
      ? currentEvent.title.trim()
      : typeof subtask.linkedCalendarEventTitle === "string"
      ? subtask.linkedCalendarEventTitle
      : null,

  linkedCalendarEventStartMs:
    typeof currentEvent?.startMs === "number"
      ? currentEvent.startMs
      : typeof subtask.linkedCalendarEventStartMs === "number"
      ? subtask.linkedCalendarEventStartMs
      : null,

  linkedCalendarEventEndMs:
    typeof currentEvent?.endMs === "number"
      ? currentEvent.endMs
      : null,

  linkedCalendarEventUpdatedRaw:
    typeof currentEvent?.rawUpdated === "string" &&
    currentEvent.rawUpdated.trim().length > 0
      ? currentEvent.rawUpdated.trim()
      : null,

  linkedCalendarLastHandledStartMs:
    typeof currentEvent?.startMs === "number"
      ? currentEvent.startMs
      : typeof subtask.linkedCalendarLastHandledStartMs === "number"
      ? subtask.linkedCalendarLastHandledStartMs
      : typeof subtask.linkedCalendarEventStartMs === "number"
      ? subtask.linkedCalendarEventStartMs
      : null,

  linkedCalendarLastHandledEndMs:
    typeof currentEvent?.endMs === "number"
      ? currentEvent.endMs
      : null,

  linkedCalendarLastHandledUpdatedRaw:
    typeof currentEvent?.rawUpdated === "string" &&
    currentEvent.rawUpdated.trim().length > 0
      ? currentEvent.rawUpdated.trim()
      : null,

  linkedCalendarLastSyncedAtMs: now,
});

if (lastKnownMissing) {
  await writeLinkedEventHistory({
    userId: auth.currentUser?.uid ?? "",
    goalId: subtask.goalId,
    subtaskId: subtask.id,

    eventId:
      typeof subtask.linkedCalendarEventId === "string"
        ? subtask.linkedCalendarEventId
        : null,
    eventTitle:
      typeof currentEvent?.title === "string"
        ? currentEvent.title
        : typeof subtask.linkedCalendarEventTitle === "string"
        ? subtask.linkedCalendarEventTitle
        : null,

    previousHandledStartMs:
      typeof subtask.linkedCalendarLastHandledStartMs === "number"
        ? subtask.linkedCalendarLastHandledStartMs
        : typeof subtask.linkedCalendarEventStartMs === "number"
        ? subtask.linkedCalendarEventStartMs
        : null,

    previousLinkedEventStartMs:
      typeof subtask.linkedCalendarEventStartMs === "number"
        ? subtask.linkedCalendarEventStartMs
        : null,

    nextEventStartMs:
      typeof currentEvent?.startMs === "number"
        ? currentEvent.startMs
        : null,

    nextEventEndMs:
      typeof currentEvent?.endMs === "number"
        ? currentEvent.endMs
        : null,

    previousDayKey:
      typeof subtask.linkedCalendarEventStartMs === "number"
        ? dayKeyFromDate(new Date(subtask.linkedCalendarEventStartMs), tz)
        : null,

    nextDayKey:
      typeof currentEvent?.startMs === "number"
        ? dayKeyFromDate(new Date(currentEvent.startMs), tz)
        : null,

    decision: "missing_event_state",
    reason: "linked_event_returned",

    hadOldDayOverride: false,
    oldOverrideDueAtMs: null,
    oldOverrideIsSkipped: false,
    oldOverrideIsUnscheduled: false,
    oldOverrideSource: null,
  });
}

console.log("[Calendar] cleared linked event missing state and resynced returned event", {
  goalId: subtask.goalId,
  subtaskId: subtask.id,
  eventId: linkedEventId,
  eventTitle:
    typeof currentEvent?.title === "string" ? currentEvent.title : null,
  startMs:
    typeof currentEvent?.startMs === "number" ? currentEvent.startMs : null,
  endMs:
    typeof currentEvent?.endMs === "number" ? currentEvent.endMs : null,
  rawUpdated:
    typeof currentEvent?.rawUpdated === "string" ? currentEvent.rawUpdated : null,
});
        }
      } catch (e) {
        console.error("[Calendar] Failed to sync missing linked event state", {
          goalId: subtask.goalId,
          subtaskId: subtask.id,
          eventId: linkedEventId,
          error: e,
        });
      } finally {
        syncingMissingLinkedEventKeysRef.current.delete(syncKey);
      }
    }
  };

  void run();

  return () => {
    cancelled = true;
  };
}, [authReady, user, linkedCalendarSubtasks, allGoogleEventsById]);

useEffect(() => {
  console.log("[Calendar] apply flow state changed", {
    applyStep,
    selectedGoalForApply,
    hasApplyEventTarget: !!applyEventTarget,
    applyEventTarget: applyEventTarget
      ? {
          eventId: applyEventTarget.eventId,
          eventTitle: applyEventTarget.eventTitle,
        }
      : null,
  });
}, [applyStep, selectedGoalForApply, applyEventTarget]);

useEffect(() => {
  if (!authReady || !user) return;
  if (selectedDayGoogleEvents.length === 0) return;
  if (calendarRules.length === 0) return;

  const candidateItems = [
    ...selectedSplit.due,
    ...selectedDayUnscheduledItems,
  ];

  const run = async () => {
    for (const event of selectedDayGoogleEvents) {
      const autoLinkMatch = getAutoLinkRuleMatchForEvent({
        eventTitle: event.title ?? "Untitled event",
        items: candidateItems,
        calendarRules,
      });

      console.log("[Calendar] auto-link candidate check", {
  eventId: event.id,
  eventTitle: event.title ?? null,
  candidateCount: candidateItems.length,
  autoLinkMatch: autoLinkMatch
    ? {
        goalId: autoLinkMatch.goalId,
        subtaskId: autoLinkMatch.subtaskId,
        subtaskTitle: autoLinkMatch.subtaskTitle,
        boost: autoLinkMatch.boost,
      }
    : null,
  autoLinkRuleCount: calendarRules.filter((rule) => rule.type === "auto_link").length,
});

      if (!autoLinkMatch) continue;

      const targetItem = candidateItems.find(
        (item) =>
          item.goalId === autoLinkMatch.goalId &&
          item.subtaskId === autoLinkMatch.subtaskId
      );

      console.log("[Calendar] auto-link target lookup", {
  eventId: event.id,
  goalId: autoLinkMatch?.goalId ?? null,
  subtaskId: autoLinkMatch?.subtaskId ?? null,
  foundTargetItem: !!targetItem,
  targetLinkedEventId: targetItem?.linkedCalendarEventId ?? null,
});

      if (!targetItem) continue;

      if (
        targetItem.linkedCalendarEventId &&
        targetItem.linkedCalendarEventId === event.id
      ) {
        continue;
      }

      const autoLinkKey = getAutoLinkKey(
        event.id,
        autoLinkMatch.goalId,
        autoLinkMatch.subtaskId
      );

      if (suppressedAutoLinkKeys.has(autoLinkKey)) {
  console.log("[Calendar] auto-link suppressed by manual unlink", {
    eventId: event.id,
    goalId: autoLinkMatch.goalId,
    subtaskId: autoLinkMatch.subtaskId,
  });
  continue;
}

      if (pendingAutoLinkKeys.has(autoLinkKey)) continue;

      try {
        setPendingAutoLinkKeys((prev) => new Set(prev).add(autoLinkKey));

        const subtaskRef = doc(
          db,
          "goals",
          autoLinkMatch.goalId,
          "subtasks",
          autoLinkMatch.subtaskId
        );

        const now = Date.now();

        await updateDoc(subtaskRef, {
  linkedCalendarEventId: event.id,
  linkedCalendarEventTitle: event.title ?? "Untitled event",
  linkedCalendarEventStartMs: event.startMs,
  linkedCalendarEventEndMs: event.endMs ?? null,
  linkedCalendarCalendarId: event.calendarId ?? null,
  linkedCalendarEventUpdatedRaw: event.rawUpdated ?? null,
  linkedCalendarLinkedAtMs: now,

  linkedCalendarLastSyncedAtMs: now,
  linkedCalendarLastHandledStartMs: event.startMs,
  linkedCalendarLastHandledEndMs: event.endMs ?? null,
  linkedCalendarLastHandledUpdatedRaw: event.rawUpdated ?? null,
});


        applyLocalSubtaskPatch(autoLinkMatch.goalId, autoLinkMatch.subtaskId, {
  linkedCalendarEventId: event.id,
  linkedCalendarEventTitle: event.title ?? "Untitled event",
  linkedCalendarEventStartMs: event.startMs,
  linkedCalendarEventEndMs: event.endMs ?? null,
  linkedCalendarCalendarId: event.calendarId ?? null,
  linkedCalendarEventUpdatedRaw: event.rawUpdated ?? null,
  linkedCalendarLinkedAtMs: now,

  linkedCalendarLastSyncedAtMs: now,
  linkedCalendarLastHandledStartMs: event.startMs,
  linkedCalendarLastHandledEndMs: event.endMs ?? null,
  linkedCalendarLastHandledUpdatedRaw: event.rawUpdated ?? null,
});

        console.log("[Calendar] auto-link applied", {
          eventId: event.id,
          eventTitle: event.title ?? null,
          goalId: autoLinkMatch.goalId,
          subtaskId: autoLinkMatch.subtaskId,
          subtaskTitle: autoLinkMatch.subtaskTitle,
        });
      } catch (e) {
        console.error("[Calendar] auto-link failed", {
          eventId: event.id,
          goalId: autoLinkMatch.goalId,
          subtaskId: autoLinkMatch.subtaskId,
          error: e,
        });
      } finally {
        setPendingAutoLinkKeys((prev) => {
          const next = new Set(prev);
          next.delete(autoLinkKey);
          return next;
        });
      }
    }
  };

  run();
}, [
  authReady,
  user,
  selectedDayGoogleEvents,
  selectedSplit.due,
  selectedDayUnscheduledItems,
  calendarRules,
  pendingAutoLinkKeys,
]);

useEffect(() => {
  if (!postApplyAutomationPrompt) return;

  const timer = setTimeout(() => {
    scrollViewRef.current?.scrollTo({
      y: Math.max(automationPromptYRef.current - 24, 0),
      animated: true,
    });
  }, 100);

  return () => clearTimeout(timer);
}, [postApplyAutomationPrompt]);

useEffect(() => {
  if (!authReady || !user) return;
  if (selectedDayGoogleEvents.length === 0) return;
  if (calendarRules.length === 0) return;

  const candidateItems = [
    ...selectedSplit.due,
    ...selectedDayUnscheduledItems,
  ];

  const run = async () => {
    for (const event of selectedDayGoogleEvents) {

            const unsuppressedCandidateItems = candidateItems.filter((item) => {
        const autoApplyKey = getAutoApplyDurationKey(
          event.id,
          item.goalId,
          item.subtaskId
        );

        return !suppressedAutoApplyDurationKeys.has(autoApplyKey);
      });

      const autoApplyMatch = getAutoApplyDurationRuleMatchForEvent({
        eventTitle: event.title ?? "Untitled event",
        items: unsuppressedCandidateItems,
        calendarRules,
      });
      

      const durationMs =
        typeof event.startMs === "number" &&
        typeof event.endMs === "number"
          ? event.endMs - event.startMs
          : 0;

      console.log("[Calendar] auto-apply duration candidate check", {
        eventId: event.id,
        eventTitle: event.title ?? null,
        autoApplyRuleCount: calendarRules.filter(
          (rule) => rule.type === "auto_apply_duration"
        ).length,
        candidateCount: candidateItems.length,
unsuppressedCandidateCount: unsuppressedCandidateItems.length,
        autoApplyMatch: autoApplyMatch
        
          ? {
              goalId: autoApplyMatch.goalId,
              subtaskId: autoApplyMatch.subtaskId,
              subtaskTitle: autoApplyMatch.subtaskTitle,
              boost: autoApplyMatch.boost,
            }
          : null,
        durationMs,
      });

      if (!autoApplyMatch) continue;
      if (durationMs <= 0) continue;

      const targetItem = candidateItems.find(
        (item) =>
          item.goalId === autoApplyMatch.goalId &&
          item.subtaskId === autoApplyMatch.subtaskId
      );

      console.log("[Calendar] auto-apply duration target lookup", {
        eventId: event.id,
        goalId: autoApplyMatch.goalId,
        subtaskId: autoApplyMatch.subtaskId,
        foundTargetItem: !!targetItem,
        targetTitle: targetItem?.title ?? null,
        contributesToMetric: targetItem?.contributesToMetric ?? null,
      });

      if (!targetItem) continue;
      if (!targetItem.contributesToMetric) continue;

      const autoApplyKey = getAutoApplyDurationKey(
        event.id,
        autoApplyMatch.goalId,
        autoApplyMatch.subtaskId
      );

            

      if (pendingAutoApplyDurationKeys.has(autoApplyKey)) {
        continue;
      }

      const durationMetricValue = convertEventDurationToMetricValue(
  targetItem,
  {
    startMs: event.startMs,
    endMs: event.endMs ?? null,
  }
);

      if (
        typeof durationMetricValue !== "number" ||
        !Number.isFinite(durationMetricValue) ||
        durationMetricValue <= 0
      ) {
        console.log("[Calendar] auto-apply duration skipped invalid metric value", {
          eventId: event.id,
          goalId: autoApplyMatch.goalId,
          subtaskId: autoApplyMatch.subtaskId,
          durationMs,
          durationMetricValue,
        });
        continue;
      }

      try {
        setPendingAutoApplyDurationKeys((prev) => {
          const next = new Set(prev);
          next.add(autoApplyKey);
          return next;
        });

        const uid = auth.currentUser?.uid;
        if (!uid) {
          throw new Error("Not signed in");
        }

        console.log("[Calendar] auto-apply duration progress start", {
          eventId: event.id,
          eventTitle: event.title ?? null,
          goalId: autoApplyMatch.goalId,
          subtaskId: autoApplyMatch.subtaskId,
          subtaskTitle: autoApplyMatch.subtaskTitle,
          durationMs,
          durationMetricValue,
        });

        await applySubtaskMetricProgressTx(
          autoApplyMatch.goalId,
          autoApplyMatch.subtaskId,
          uid,
          durationMetricValue
        );

        setSuppressedAutoApplyDurationKeys((prev) => {
          const next = new Set(prev);
          next.add(autoApplyKey);
          return next;
        });

        console.log("[Calendar] auto-apply duration progress applied", {
          eventId: event.id,
          eventTitle: event.title ?? null,
          goalId: autoApplyMatch.goalId,
          subtaskId: autoApplyMatch.subtaskId,
          subtaskTitle: autoApplyMatch.subtaskTitle,
          durationMs,
          durationMetricValue,
        });
      } catch (e) {
        console.error("[Calendar] auto-apply duration failed", {
          eventId: event.id,
          eventTitle: event.title ?? null,
          goalId: autoApplyMatch.goalId,
          subtaskId: autoApplyMatch.subtaskId,
          subtaskTitle: autoApplyMatch.subtaskTitle,
          durationMs,
          durationMetricValue,
          error: e,
        });
      } finally {
        setPendingAutoApplyDurationKeys((prev) => {
          const next = new Set(prev);
          next.delete(autoApplyKey);
          return next;
        });
      }
    }
  };

  void run();
}, [
  authReady,
  user,
  selectedDayGoogleEvents,
  selectedSplit.due,
  selectedDayUnscheduledItems,
  calendarRules,
  pendingAutoApplyDurationKeys,
  suppressedAutoApplyDurationKeys,
]);

useEffect(() => {
  if (automationHistory.length <= collapsedAutomationHistoryCount && showAllAutomationHistory) {
    setShowAllAutomationHistory(false);
  }
}, [automationHistory.length, collapsedAutomationHistoryCount, showAllAutomationHistory]);

useEffect(() => {
  if (
    Platform.OS === "android" &&
    UIManager.setLayoutAnimationEnabledExperimental
  ) {
    UIManager.setLayoutAnimationEnabledExperimental(true);
  }
}, []);

const clearLinkedEventFields = {
  linkedCalendarEventId: null,
  linkedCalendarEventTitle: null,
  linkedCalendarEventStartMs: null,
  linkedCalendarEventEndMs: null,
  linkedCalendarCalendarId: null,
  linkedCalendarEventUpdatedRaw: null,
  linkedCalendarLinkedAtMs: null,
  linkedCalendarLastSyncedAtMs: null,

  linkedCalendarLastHandledStartMs: null,
  linkedCalendarLastHandledEndMs: null,
  linkedCalendarLastHandledUpdatedRaw: null,

  linkedCalendarLastKnownMissing: null,
  linkedCalendarMissingAtMs: null,
};

const disableAutoLinkForItem = async (item: CalendarItem & { date: Date }) => {
  const uid = auth.currentUser?.uid;
  if (!uid) {
    throw new Error("Not signed in");
  }

  const linkedEventTitle =
    typeof item.linkedCalendarEventTitle === "string" &&
    item.linkedCalendarEventTitle.trim().length > 0
      ? item.linkedCalendarEventTitle.trim()
      : null;

  if (!linkedEventTitle) {
    console.log("[CalendarRules] no linked event title available for auto-link cleanup", {
      goalId: item.goalId,
      subtaskId: item.subtaskId,
      itemTitle: item.title,
    });
    return 0;
  }

  const deletedCount = await deleteCalendarRules({
    userId: uid,
    type: "auto_link",
    eventTitle: linkedEventTitle,
    goalId: item.goalId,
    subtaskId: item.subtaskId,
  });

  console.log("[CalendarRules] auto-link cleanup after unlink", {
    eventTitle: linkedEventTitle,
    goalId: item.goalId,
    subtaskId: item.subtaskId,
    deletedCount,
  });

  return deletedCount;
};

const runUnlinkEvent = async (
  item: CalendarItem & { date: Date },
  options?: { suppressSuccessAlert?: boolean }
) => {
  const pendingKey = getLinkedEventActionKey(item);

  if (pendingLinkedEventActionKeys.has(pendingKey)) return;

  const linkedEventId =
    typeof item.linkedCalendarEventId === "string"
      ? item.linkedCalendarEventId.trim()
      : "";

  try {
    setPendingLinkedEventActionKeys((prev) => {
      const next = new Set(prev);
      next.add(pendingKey);
      return next;
    });

    const subtaskRef = doc(db, "goals", item.goalId, "subtasks", item.subtaskId);

    await updateDoc(subtaskRef, clearLinkedEventFields);

    applyLocalSubtaskPatch(item.goalId, item.subtaskId, clearLinkedEventFields);

    if (linkedEventId) {
      const autoLinkKey = getAutoLinkKey(linkedEventId, item.goalId, item.subtaskId);

      setSuppressedAutoLinkKeys((prev) => {
        const next = new Set(prev);
        next.add(autoLinkKey);
        return next;
      });

      if (linkedEventId) {
  const autoLinkKey = getAutoLinkKey(linkedEventId, item.goalId, item.subtaskId);

  setSuppressedAutoLinkKeys((prev) => {
    const next = new Set(prev);
    next.add(autoLinkKey);
    return next;
  });

  console.log("[Calendar] auto-link suppressed after unlink", {
    eventId: linkedEventId,
    goalId: item.goalId,
    subtaskId: item.subtaskId,
  });
}
    }

    if (!options?.suppressSuccessAlert) {
  Alert.alert("Event unlinked", `"${item.title}" is no longer linked to a calendar event.`);
}
  } catch (e: any) {
    console.error("unlink event failed", e);
    Alert.alert("Update failed", e?.message ?? "Unknown error");
  } finally {
    setPendingLinkedEventActionKeys((prev) => {
      const next = new Set(prev);
      next.delete(pendingKey);
      return next;
    });
  }
};

const showAdvancedUnlinkOptions = async (item: CalendarItem & { date: Date }) => {
  const linkedEventTitle =
    typeof item.linkedCalendarEventTitle === "string" &&
    item.linkedCalendarEventTitle.trim().length > 0
      ? item.linkedCalendarEventTitle.trim()
      : "this event";

  Alert.alert(
    "Advanced unlink options",
    `Choose what to do for "${item.title}" linked to "${linkedEventTitle}"`,
    [
      {
        text: "Cancel",
        style: "cancel",
      },
      {
        text: "Disable auto-link",
        onPress: async () => {
          try {
            const deletedCount = await disableAutoLinkForItem(item);
            await runUnlinkEvent(item, { suppressSuccessAlert: true });

            Alert.alert(
              "Auto-link disabled",
              deletedCount > 0
                ? `"${item.title}" was unlinked and its saved auto-link rule was removed.`
                : `"${item.title}" was unlinked. No saved auto-link rule was found.`
            );
          } catch (e: any) {
            console.error("unlink + disable auto-link failed", e);
            Alert.alert("Update failed", e?.message ?? "Unknown error");
          }
        },
      },
      {
        text: "Forget preference",
        style: "destructive",
        onPress: async () => {
          try {
            const uid = auth.currentUser?.uid;
            if (!uid) throw new Error("Not signed in");

            const rawLinkedEventTitle =
              typeof item.linkedCalendarEventTitle === "string" &&
              item.linkedCalendarEventTitle.trim().length > 0
                ? item.linkedCalendarEventTitle.trim()
                : null;

            if (!rawLinkedEventTitle) {
              await runUnlinkEvent(item, { suppressSuccessAlert: true });

              Alert.alert(
                "Unlinked",
                `"${item.title}" was unlinked, but there was no saved event title preference to forget.`
              );
              return;
            }

            const deleted = await forgetAllRulesForEventTitle({
              userId: uid,
              eventTitle: rawLinkedEventTitle,
            });

            await runUnlinkEvent(item, { suppressSuccessAlert: true });

            Alert.alert(
              "Preference forgotten",
              `"${item.title}" was unlinked and saved preferences for "${rawLinkedEventTitle}" were removed.\n\nAuto-link: ${deleted.autoLinkDeleted}\nSuggest: ${deleted.suggestDeleted}\nAuto-apply: ${deleted.autoApplyDeleted}`
            );
          } catch (e: any) {
            console.error("unlink + forget preference failed", e);
            Alert.alert("Update failed", e?.message ?? "Unknown error");
          }
        },
      },
    ]
  );
};

const handleUnlinkEvent = async (item: CalendarItem & { date: Date }) => {
  const linkedEventTitle =
    typeof item.linkedCalendarEventTitle === "string" &&
    item.linkedCalendarEventTitle.trim().length > 0
      ? item.linkedCalendarEventTitle.trim()
      : "this event";

  Alert.alert(
    "Unlink event",
    `What would you like to do for "${item.title}"?\n\nCurrent linked event: ${linkedEventTitle}`,
    [
      {
        text: "Cancel",
        style: "cancel",
      },
      {
        text: "Unlink only",
        onPress: async () => {
          await runUnlinkEvent(item);
        },
      },
      {
  text: "More options",
  style: "destructive",
  onPress: async () => {
    await showAdvancedUnlinkOptions(item);
  },
},
    ]
  );
};

const handleUseLinkedEventTime = async (item: CalendarItem & { date: Date }) => {
  const pendingKey = getLinkedEventActionKey(item);
  if (pendingLinkedEventActionKeys.has(pendingKey)) return;

  try {
    addPendingLinkedEventActionKey(pendingKey, setPendingLinkedEventActionKeys);

    const baseSubtask = getBaseSubtask(item.goalId, item.subtaskId);

    if (!baseSubtask) {
      throw new Error("Subtask not found");
    }

    const linkedStartMs = getLinkedEventStartMsFromSubtask(baseSubtask);

    if (!linkedStartMs) {
      throw new Error("No linked event time found");
    }

    const currentTimeLabel =
      typeof item.dueAtMs === "number"
        ? new Date(item.dueAtMs).toLocaleTimeString([], {
            hour: "numeric",
            minute: "2-digit",
          })
        : "No current time";

    const linkedTimeLabel = new Date(linkedStartMs).toLocaleTimeString([], {
      hour: "numeric",
      minute: "2-digit",
    });

    const confirmed = await confirmAction(
      "Use linked event time?",
      `${item.title}\n\nCurrent: ${currentTimeLabel}\nLinked event: ${linkedTimeLabel}`
    );

    if (!confirmed) return;

    await applyEventTimeToSubtask({
      goalId: item.goalId,
      subtaskId: item.subtaskId,
      eventStartMs: linkedStartMs,
    });

    Alert.alert(
      "Task time updated",
      `${item.title}\n\n${currentTimeLabel} → ${linkedTimeLabel}`
    );
  } catch (e: any) {
    console.error("use linked event time failed", e);
    Alert.alert("Update failed", e?.message ?? "Unknown error");
  } finally {
    removePendingLinkedEventActionKey(pendingKey, setPendingLinkedEventActionKeys);
  }
}; 

const handleApplyEventDurationToProgress = async (
  goalId: string,
  subtaskId: string,
  eventTarget: NonNullable<typeof applyEventTarget>
) => {
  if (applyActionPending) return;

  try {
    setApplyActionPending(true);

    const baseSubtask = getBaseSubtask(goalId, subtaskId);

    if (!baseSubtask) {
      throw new Error("Subtask not found");
    }

    const metricValue = convertEventDurationToMetricValue(
      baseSubtask,
      eventTarget
    );

    if (metricValue == null) {
      throw new Error(
        "This subtask does not support duration-based progress yet."
      );
    }

    const eventDate = new Date(eventTarget.startMs);

    const uid = auth.currentUser?.uid;
if (!uid) {
  throw new Error("Not signed in");
}

await applySubtaskMetricProgressTx(goalId, subtaskId, uid, metricValue);

    const unitKind = getTimeMetricUnitKind(baseSubtask?.metricUnit);

const valueLabel =
  unitKind === "hours"
    ? `${formatMetricValueLabel(metricValue)} hr`
    : unitKind === "minutes"
    ? `${formatMetricValueLabel(metricValue)} min`
    : `${formatMetricValueLabel(metricValue)}`;

Alert.alert(
  "Progress applied",
  `"${baseSubtask.title}" was updated with ${valueLabel} from "${eventTarget.eventTitle}".`
);

    resetApplyFlow();
  } catch (e: any) {
    console.error("apply event duration to progress failed", e);
    Alert.alert("Update failed", e?.message ?? "Unknown error");
  } finally {
    setApplyActionPending(false);
  }
};

const handleSnoozeOptions = (item: CalendarItem & { date: Date }) => {
  if (typeof item.dueAtMs !== "number") return;
  setSnoozeMenuTarget(item);
};

const handleSnoozeChoice = async (
  item: CalendarItem & { date: Date },
  choice: "30" | "60" | "tomorrow"
) => {
  if (typeof item.dueAtMs !== "number") return;

  const baseMs =
    item.frequency === "once"
      ? item.dueAtMs
      : withDayAndTime(item.date, item.dueAtMs);

  if (choice === "30") {
    await applySnoozeToMs(item, baseMs + 30 * 60 * 1000);
    return;
  }

  if (choice === "60") {
    await applySnoozeToMs(item, baseMs + 60 * 60 * 1000);
    return;
  }

  if (choice === "tomorrow") {
    await applySnoozeToMs(item, getTomorrowMorningMs(item.date));
  }
};

const closeSnoozeMenu = () => {
  setSnoozeMenuTarget(null);
};

const runSnoozeChoice = async (choice: "30" | "60" | "tomorrow") => {
  if (!snoozeMenuTarget) return;

  const target = snoozeMenuTarget;
  setSnoozeMenuTarget(null);

  try {
    await handleSnoozeChoice(target, choice);
  } catch (e) {
    console.error("custom snooze choice failed", e);
  }
};

const applySkipForDay = async (item: CalendarItem & { date: Date }) => {
  const dayKey = dateKey(item.date);
  const itemKey = `${item.goalId}:${item.subtaskId}:${dayKey}`;

  if (pendingSkipKeys.has(itemKey)) return;

  setPendingSkipKeys((prev) => new Set(prev).add(itemKey));

  try {
    const overrideRef = doc(
      db,
      "goals",
      item.goalId,
      "subtasks",
      item.subtaskId,
      "scheduleOverrides",
      dayKey
    );

    const overridePatch = buildRecurringSkippedOverride({
  userId: auth.currentUser?.uid ?? "",
  goalId: item.goalId,
  subtaskId: item.subtaskId,
  dayKey,
});


await setDoc(overrideRef, overridePatch, { merge: true });

    setScheduleOverridesByKey((prev) => ({
      ...prev,
      [getScheduleOverrideKey(item.subtaskId, dayKey)]: {
        ...(prev[getScheduleOverrideKey(item.subtaskId, dayKey)] ?? {}),
        dueAtMs: null,
        isSkipped: true,
        isUnscheduled: false,
        source: "skip",
      },
    }));
  } catch (e: any) {
    console.error("skip for day failed", e);

    if (Platform.OS === "web") {
      window.alert(`Update failed\n\n${e?.message ?? "Unknown error"}`);
    } else {
      Alert.alert("Update failed", e?.message ?? "Unknown error");
    }
  } finally {
    setPendingSkipKeys((prev) => {
      const next = new Set(prev);
      next.delete(itemKey);
      return next;
    });
  }
};

const applyMarkUnscheduledForDay = async (item: CalendarItem & { date: Date }) => {
  const dayKey = dateKey(item.date);
  const itemKey = `${item.goalId}:${item.subtaskId}:${dayKey}`;

  if (pendingUnscheduledKeys.has(itemKey)) return;

  setPendingUnscheduledKeys((prev) => new Set(prev).add(itemKey));

  try {
    const baseSubtask = getBaseSubtask(item.goalId, item.subtaskId);

    if (!baseSubtask) {
      throw new Error("Subtask not found");
    }

    const scheduleType = getScheduleType(baseSubtask);

    if (scheduleType === "oneTime") {
      const ref = doc(db, "goals", item.goalId, "subtasks", item.subtaskId);

      const patch = buildOneTimeSchedulePatch(null, null);

await updateDoc(ref, patch);
applyLocalSubtaskPatch(item.goalId, item.subtaskId, patch);
    } else {
      const overrideRef = doc(
        db,
        "goals",
        item.goalId,
        "subtasks",
        item.subtaskId,
        "scheduleOverrides",
        dayKey
      );

      const overridePatch = buildRecurringUnscheduledOverride({
  userId: auth.currentUser?.uid ?? "",
  goalId: item.goalId,
  subtaskId: item.subtaskId,
  dayKey,
  source: "unscheduled",
});

await setDoc(overrideRef, overridePatch, { merge: true });

      setScheduleOverridesByKey((prev) => ({
        ...prev,
        [getScheduleOverrideKey(item.subtaskId, dayKey)]: {
          ...(prev[getScheduleOverrideKey(item.subtaskId, dayKey)] ?? {}),
          dueAtMs: null,
          isSkipped: false,
          isUnscheduled: true,
          source: "unscheduled",
        },
      }));
    }
  } catch (e: any) {
    console.error("mark unscheduled for day failed", e);

    if (Platform.OS === "web") {
      window.alert(`Update failed\n\n${e?.message ?? "Unknown error"}`);
    } else {
      Alert.alert("Update failed", e?.message ?? "Unknown error");
    }
  } finally {
    setPendingUnscheduledKeys((prev) => {
      const next = new Set(prev);
      next.delete(itemKey);
      return next;
    });
  }
};


const handleSkipForDay = async (item: CalendarItem & { date: Date }) => {
  const confirmed = await confirmAction(
    "Skip for this day?",
    `${item.title}\n\nThis will hide it from the selected date without changing future occurrences.`
  );

  if (!confirmed) return;
  await applySkipForDay(item);
};


const handleMarkUnscheduledForDay = async (item: CalendarItem & { date: Date }) => {
  const baseSubtask = getBaseSubtask(item.goalId, item.subtaskId);
  const scheduleType = baseSubtask ? getScheduleType(baseSubtask) : "recurring";

  const message =
    scheduleType === "oneTime"
      ? `${item.title}\n\nThis will remove its scheduled date and time until you reassign it.`
      : `${item.title}\n\nThis will remove it from the selected date without marking it skipped.`;

  const confirmed = await confirmAction(
    "Mark unscheduled?",
    message
  );

  if (!confirmed) return;
  await applyMarkUnscheduledForDay(item);
};

const applyClearOverrideForDay = async (item: CalendarItem & { date: Date }) => {
  const dayKey = dateKey(item.date);
  const itemKey = `${item.goalId}:${item.subtaskId}:${dayKey}`;

  if (pendingClearOverrideKeys.has(itemKey)) return;

  setPendingClearOverrideKeys((prev) => new Set(prev).add(itemKey));

  try {
    const overrideRef = doc(
      db,
      "goals",
      item.goalId,
      "subtasks",
      item.subtaskId,
      "scheduleOverrides",
      dayKey
    );

    

    await deleteDoc(overrideRef);

    setScheduleOverridesByKey((prev) => {
      const next = { ...prev };
      delete next[getScheduleOverrideKey(item.subtaskId, dayKey)];
      return next;
    });

    
  } catch (e: any) {
    console.error("clear override failed", e);

    if (Platform.OS === "web") {
      window.alert(`Update failed\n\n${e?.message ?? "Unknown error"}`);
    } else {
      Alert.alert("Update failed", e?.message ?? "Unknown error");
    }
  } finally {
    setPendingClearOverrideKeys((prev) => {
      const next = new Set(prev);
      next.delete(itemKey);
      return next;
    });
  }
};

const handleClearOverrideForDay = async (item: CalendarItem & { date: Date }) => {
  

  const confirmed = await confirmAction(
    "Clear override for this day?",
    `${item.title}\n\nThis will restore the normal schedule for the selected date.`
  );

  if (!confirmed) return;

  await applyClearOverrideForDay(item);
};

const handleReassignLaterToday = async (item: CalendarItem & { date: Date }) => {
  const effectiveDate = item.date ?? selectedDate;
  const dayKey = dateKey(effectiveDate);
  const itemKey = `${item.goalId}:${item.subtaskId}:${dayKey}`;

  if (pendingReassignKeys.has(itemKey)) return;

 const suggestedSlot = findFirstAvailableSlotOnDate(
  effectiveDate,
  selectedDayGoogleEvents,
  DEFAULT_SUGGESTED_SLOT_MINUTES
);

  if (!suggestedSlot) {
    Alert.alert(
      "No opening available",
      getNoSlotLabel(DEFAULT_SUGGESTED_SLOT_MINUTES)
    );
    return;
  }

  setPendingReassignKeys((prev) => new Set(prev).add(itemKey));

  try {
    const baseSubtask = getBaseSubtask(item.goalId, item.subtaskId);

    if (!baseSubtask) {
      throw new Error("Subtask not found");
    }

    const scheduleType = getScheduleType(baseSubtask);

    if (scheduleType === "oneTime") {
  const ref = doc(db, "goals", item.goalId, "subtasks", item.subtaskId);

const patch = {
  ...buildOneTimeSchedulePatch(dayKey, suggestedSlot.startMs),
  updatedAt: serverTimestamp(),
};

await updateDoc(ref, patch);
applyLocalSubtaskPatch(item.goalId, item.subtaskId, patch);
} else {
  const overrideRef = doc(
    db,
    "goals",
    item.goalId,
    "subtasks",
    item.subtaskId,
    "scheduleOverrides",
    dayKey
  );

  const overridePatch = buildRecurringTimedOverride({
    userId: auth.currentUser?.uid ?? "",
    goalId: item.goalId,
    subtaskId: item.subtaskId,
    dayKey,
    dueAtMs: suggestedSlot.startMs,
    source: "snooze",
  });

  await setDoc(overrideRef, overridePatch, { merge: true });

  setScheduleOverridesByKey((prev) => ({
    ...prev,
    [getScheduleOverrideKey(item.subtaskId, dayKey)]: {
      ...(prev[getScheduleOverrideKey(item.subtaskId, dayKey)] ?? {}),
      dueAtMs: suggestedSlot.startMs,
      isSkipped: false,
      isUnscheduled: false,
      source: "snooze",
    },
  }));
}

    setRecentlyRescheduledKeys((prev) => {
      const next = new Set(prev);
      next.add(itemKey);
      return next;
    });

    setTimeout(() => {
      setRecentlyRescheduledKeys((prev) => {
        const next = new Set(prev);
        next.delete(itemKey);
        return next;
      });
    }, 2500);

    Alert.alert(
      "Reassigned",
      `${item.title}\n\nNow scheduled for ${formatTimeRangeLabel(
        suggestedSlot.startMs,
        suggestedSlot.endMs
      )}`
    );
  } catch (e: any) {
    console.error("reassign later today failed", e);
    Alert.alert("Update failed", e?.message ?? "Unknown error");
  } finally {
    setPendingReassignKeys((prev) => {
      const next = new Set(prev);
      next.delete(itemKey);
      return next;
    });
  }
};

const handleReassignTomorrowMorning = async (
  item: CalendarItem & { date: Date }
) => {
 const effectiveDate = item.date ?? selectedDate;
const sourceDayKey = dateKey(effectiveDate);
const targetMs = getTomorrowMorningMs(effectiveDate);
  const targetDate = new Date(targetMs);
const sourceDayStart = dayStartMs(effectiveDate);
const sourceDayEnd = sourceDayStart + 24 * 60 * 60 * 1000;

const targetDayKey =
  targetMs >= sourceDayStart && targetMs < sourceDayEnd
    ? sourceDayKey
    : dateKey(targetDate);
  const itemKey = `${item.goalId}:${item.subtaskId}:${sourceDayKey}`;

  if (pendingReassignTomorrowKeys.has(itemKey)) return;

  setPendingReassignTomorrowKeys((prev) => new Set(prev).add(itemKey));

  try {
    const baseSubtask = getBaseSubtask(item.goalId, item.subtaskId);

    if (!baseSubtask) {
      throw new Error("Subtask not found");
    }

    const scheduleType = getScheduleType(baseSubtask);

    if (scheduleType === "oneTime") {
  const ref = doc(db, "goals", item.goalId, "subtasks", item.subtaskId);

  const patch = buildOneTimeSchedulePatch(targetDayKey, targetMs);

  await updateDoc(ref, patch);
  applyLocalSubtaskPatch(item.goalId, item.subtaskId, patch);
} else {
  const uid = auth.currentUser?.uid ?? "";

  const sourceOverrideRef = doc(
    db,
    "goals",
    item.goalId,
    "subtasks",
    item.subtaskId,
    "scheduleOverrides",
    sourceDayKey
  );

  const targetOverrideRef = doc(
    db,
    "goals",
    item.goalId,
    "subtasks",
    item.subtaskId,
    "scheduleOverrides",
    targetDayKey
  );

  const sourceOverridePatch = buildRecurringUnscheduledOverride({
    userId: uid,
    goalId: item.goalId,
    subtaskId: item.subtaskId,
    dayKey: sourceDayKey,
    source: "snooze",
  });

  const targetOverridePatch = buildRecurringTimedOverride({
    userId: uid,
    goalId: item.goalId,
    subtaskId: item.subtaskId,
    dayKey: targetDayKey,
    dueAtMs: targetMs,
    source: "snooze",
  });

  await setDoc(sourceOverrideRef, sourceOverridePatch, { merge: true });
  await setDoc(targetOverrideRef, targetOverridePatch, { merge: true });

  setScheduleOverridesByKey((prev) => ({
    ...prev,
    [getScheduleOverrideKey(item.subtaskId, sourceDayKey)]: {
      ...(prev[getScheduleOverrideKey(item.subtaskId, sourceDayKey)] ?? {}),
      dueAtMs: null,
      isSkipped: false,
      isUnscheduled: true,
      source: "snooze",
    },
    [getScheduleOverrideKey(item.subtaskId, targetDayKey)]: {
      ...(prev[getScheduleOverrideKey(item.subtaskId, targetDayKey)] ?? {}),
      dueAtMs: targetMs,
      isSkipped: false,
      isUnscheduled: false,
      source: "snooze",
    },
  }));

    }

    setRecentlyRescheduledKeys((prev) => {
      const next = new Set(prev);
      next.add(itemKey);
      return next;
    });

    setTimeout(() => {
      setRecentlyRescheduledKeys((prev) => {
        const next = new Set(prev);
        next.delete(itemKey);
        return next;
      });
    }, 2500);

    Alert.alert(
      "Reassigned",
      `${item.title}\n\nNow scheduled for ${targetDate.toLocaleDateString([], {
        weekday: "short",
        month: "short",
        day: "numeric",
      })} at ${new Date(targetMs).toLocaleTimeString([], {
        hour: "numeric",
        minute: "2-digit",
      })}`
    );
  } catch (e: any) {
    console.error("reassign tomorrow morning failed", e);
    Alert.alert("Update failed", e?.message ?? "Unknown error");
  } finally {
    setPendingReassignTomorrowKeys((prev) => {
      const next = new Set(prev);
      next.delete(itemKey);
      return next;
    });
  }
};

function clearLocalSubtaskSchedule(goalId: string, subtaskId: string) {
  setSubtasksByGoal((prev) => {
    const goalSubtasks = prev[goalId] ?? [];

    return {
      ...prev,
      [goalId]: goalSubtasks.map((subtask) =>
        subtask.id === subtaskId
          ? {
              ...subtask,
              scheduledDayKey: null,
              dueAtMs: null,
            }
          : subtask
      ),
    };
  });
}

function formatLinkedEventAlignmentHint(
  latestHistory?: {
    previousHandledStartMs?: number | null;
    oldOverrideDueAtMs?: number | null;
    oldOverrideSource?: string | null;
    reason?: string | null;
  } | null
) {
  if (!latestHistory) return null;

  const previousHandledStartMs =
    typeof latestHistory.previousHandledStartMs === "number"
      ? latestHistory.previousHandledStartMs
      : null;

  const oldOverrideDueAtMs =
    typeof latestHistory.oldOverrideDueAtMs === "number"
      ? latestHistory.oldOverrideDueAtMs
      : null;

  if (
    latestHistory.reason === "manual_schedule_change" &&
    previousHandledStartMs !== null &&
    oldOverrideDueAtMs !== null
  ) {
    const prevLabel = new Date(previousHandledStartMs).toLocaleTimeString([], {
      hour: "numeric",
      minute: "2-digit",
    });

    const dueLabel = new Date(oldOverrideDueAtMs).toLocaleTimeString([], {
      hour: "numeric",
      minute: "2-digit",
    });

    const sourceLabel =
      typeof latestHistory.oldOverrideSource === "string" &&
      latestHistory.oldOverrideSource.trim().length > 0
        ? ` via ${latestHistory.oldOverrideSource}`
        : "";

    return `Task was already at ${dueLabel}, not still following old event time ${prevLabel}${sourceLabel}`;
  }

  return null;
}

function bumpHeatCount(
  prev: HeatmapByDayKey,
  dayKey: string,
  deltaCount: number,
  deltaMetricSum: number = 0
): HeatmapByDayKey {
  const cur = prev[dayKey] ?? { count: 0, metricSum: 0 };

  const nextCount = Math.max(0, (cur.count ?? 0) + deltaCount);
  const nextMetricSum = Math.max(0, (cur.metricSum ?? 0) + deltaMetricSum);

  return {
    ...prev,
    [dayKey]: { ...cur, count: nextCount, metricSum: nextMetricSum },
  };
}

