{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {"EXPO_PUBLIC_FEEDBACK_SUBMISSION_ENABLED": "false"}
    },
    "preview": {
      "distribution": "internal",
      "env": {"EXPO_PUBLIC_FEEDBACK_SUBMISSION_ENABLED": "false"}
    },
    "production": {
      "autoIncrement": true,
      "env": {"EXPO_PUBLIC_FEEDBACK_SUBMISSION_ENABLED": "false"}
    }
  },
  "submit": {
    "production": {}
  }
}
