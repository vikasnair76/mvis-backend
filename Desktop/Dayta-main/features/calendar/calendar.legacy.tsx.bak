    linkedCalendarLastHandledUpdatedRaw: detection.currentEventUpdatedRaw,
    linkedCalendarLastSyncedAtMs: now,
  });

  console.log("[Calendar] handled linked event metadata-only change", {
  goalId: changed.goalId,
  subtaskId,
  eventId: changed.eventId,
  reason: metadataOnlyReason,
  titleChanged: detection.titleChanged,
  endChanged: detection.endChanged,
  updatedChanged: detection.updatedChanged,
  usedLegacySnapshotFallback: detection.usedLegacySnapshotFallback,
});

  continue;
}

if (
  !isTimeShiftChange ||
  previousHandledStartMs === null ||
  currentEventStartMs === null
) {
  continue;
}
        const previousEventDayKey = dateKey(new Date(previousHandledStartMs));
        const overrideKey = getScheduleOverrideKey(subtaskId, previousEventDayKey);
        const override = scheduleOverridesByKey[overrideKey] ?? null;

const policy = getLinkedEventPolicyDecision({
  previousHandledStartMs,
  currentEventStartMs,
