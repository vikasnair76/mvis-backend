        )}

        {!!s.linkedCalendarEventId && (
          <Text style={styles.applySubtaskLinkedBadge}>
            Already linked
          </Text>
        )}
      </>
    </Pressable>
  );
})}
      </>
    )}

    {applyGoalSubtasks.length === 0 && (
