      try {
       const detection = changed.detection;
const previousHandledStartMs = detection.previousHandledStartMs;
const currentEventStartMs = detection.currentEventStartMs;

if (!detection.hasAnyChange) {
  continue;
}

const isTimeShiftChange = isLinkedEventTimeShiftChange(detection);
const isMetadataOnlyChange = isLinkedEventMetadataOnlyChange(detection);

if (
  previousHandledStartMs === null ||
  currentEventStartMs === null
) {
  continue;
}
      if (isMetadataOnlyChange) {
  const subtaskRef = doc(db, "goals", changed.goalId, "subtasks", subtaskId);
  const now = Date.now();

