//type DatedItem = CalendarItem & { date: Date };

const allGoogleEvents = useMemo(() => {
  const seen = new Set<string>();
  const out: GoogleCalendarEvent[] = [];

  for (const dayKey of Object.keys(googleEventsByDayKey)) {
    for (const event of googleEventsByDayKey[dayKey] ?? []) {
      if (seen.has(event.id)) continue;
      seen.add(event.id);
      out.push(event);
    }
  }
 

  out.sort((a, b) => a.startMs - b.startMs);
  return out;
}, [googleEventsByDayKey]);



 const allGoogleEventsById = useMemo(() => {
  const map = new Map<string, GoogleCalendarEvent>();

  for (const event of allGoogleEvents) {
    map.set(event.id, event);
  }

  return map;
}, [allGoogleEvents]);

const calendarSubtasks = useMemo(() => {
  const out: Array<
    (typeof subtasksByGoal)[string][number] & { goalId: string }
  > = [];

  for (const g of visibleGoals) {
    if (g.status === "completed") continue;

    const subs = subtasksByGoal[g.id] ?? [];

    for (const s of subs) {
            const isSharedAssigned =
        g.userId !== user?.uid &&
        isGroupSharedGoal(g) &&
        s.assignedToUid === user?.uid;

      if (g.userId !== user?.uid && !isSharedAssigned) continue;
      out.push({
        ...s,
        goalId: g.id,
      });
    }
  }

  return out;
}, [goals, subtasksByGoal]);



const linkedCalendarEventIds = useMemo(() => {
  const ids = new Set<string>();

  for (const subtask of calendarSubtasks) {
    if (
      typeof subtask.linkedCalendarEventId === "string" &&
      subtask.linkedCalendarEventId.trim().length > 0
    ) {
      ids.add(subtask.linkedCalendarEventId);
    }
  }

  return Array.from(ids);
}, [calendarSubtasks]);

const linkedCalendarSubtasks = useMemo(() => {
  return calendarSubtasks.filter(
    (subtask) =>
      typeof subtask.linkedCalendarEventId === "string" &&
      subtask.linkedCalendarEventId.trim().length > 0
  );
}, [calendarSubtasks]);

useEffect(() => {
  if (!authReady || !user) return;
  if (linkedCalendarSubtasks.length === 0) return;

let cancelled = false;

  const run = async () => {
    for (const subtask of linkedCalendarSubtasks) {
      if (cancelled) return;

      const patch = buildLegacyLinkedSnapshotBackfillPatch(subtask);
if (!patch) {
  const normalizedSnapshot = getNormalizedLinkedEventSnapshot(subtask);

  if (normalizedSnapshot.isLegacySnapshot) {
    console.log("[Calendar] legacy linked snapshot detected but no backfill patch was needed", {
      goalId: subtask.goalId,
      subtaskId: subtask.id,
    });
  }

  continue;
}

      const normalizationKey = `${subtask.goalId}:${subtask.id}`;
      if (legacyLinkedSnapshotBackfillRef.current.has(normalizationKey)) {
  continue;
}

legacyLinkedSnapshotBackfillRef.current.add(normalizationKey);

      try {
        const subtaskRef = doc(
          db,
          "goals",
          subtask.goalId,
          "subtasks",
          subtask.id
        );

        await updateDoc(subtaskRef, patch);

await updateDoc(subtaskRef, patch);

applyLocalSubtaskPatch(subtask.goalId, subtask.id, patch);

        console.log("[Calendar] backfilled legacy linked snapshot fields", {
          goalId: subtask.goalId,
          subtaskId: subtask.id,
          patchedFields: Object.keys(patch),
        });
      } catch (error) {
        console.error(
          "[Calendar] failed to backfill legacy linked snapshot fields",
          {
            goalId: subtask.goalId,
            subtaskId: subtask.id,
            error,
          }
        );
      }
    }
  };

  run().catch((error) => {
    console.error(
      "[Calendar] legacy linked snapshot backfill effect failed",
      error
    );
  });

  return () => {
    cancelled = true;
  };
}, [authReady, user, linkedCalendarSubtasks]);



useEffect(() => {
  if (!authReady || !user) return;

  if (!calendarIntegration?.connected) {
    setLinkedGoogleEventsById({});
    return;
  }

  const uid = auth.currentUser?.uid;
  if (!uid) return;

  if (linkedCalendarEventIds.length === 0) {
    setLinkedGoogleEventsById({});
    return;
  }

  const ref = collection(db, "users", uid, "calendarEvents");

  const unsubscribers: Array<() => void> = [];

  for (const eventId of linkedCalendarEventIds) {
    const eventRef = doc(ref, eventId);

    const unsub = onSnapshot(
      
      eventRef,
      
      (snap) => {
        //console.log("[Calendar] SNAPSHOT FIRED", eventId);
        if (!snap.exists()) {
          setLinkedGoogleEventsById((prev) => {
            if (!(eventId in prev)) return prev;
            const copy = { ...prev };
            delete copy[eventId];
            return copy;
          });
          return;
        }

        const data = snap.data() as GoogleCalendarEvent;
/**console.log("[Calendar] linked event doc snapshot", {
  eventId,
  startMs:
    typeof data.startMs === "number" ? data.startMs : null,
  rawUpdated:
    typeof data.rawUpdated === "string" ? data.rawUpdated : null,
  title:
    typeof data.title === "string" ? data.title : null,
}); **/
        setLinkedGoogleEventsById((prev) => ({
          ...prev,
          [eventId]: { ...data, id: snap.id },
        }));
      },
      (err) => {
        console.error("linked google event subscription failed", {
          eventId,
          error: err,
        });
      }
    );

    unsubscribers.push(unsub);
  }

  return () => {
    unsubscribers.forEach((unsub) => unsub());
  };
}, [authReady, user, calendarIntegration, linkedCalendarEventIds]);





useEffect(() => {
  const ids = linkedCalendarEventIds;
  if (ids.length === 0) return;

  //console.log("[Calendar] linked event ids", ids);
}, [linkedCalendarEventIds]);




const datedItems: DatedItem[] = useMemo(() => {
  const dates: Date[] = [];

  if (mode === "day") {
    dates.push(new Date(selectedDate));
  } else if (mode === "week") {
    for (const d of weekDates) {
      dates.push(d);
    }
  } else {
    const start = startOfMonth(selectedDate);
    const n = daysInMonth(selectedDate);
    for (let i = 0; i < n; i++) dates.push(addDays(start, i));
  }

  const out: DatedItem[] = [];

const uid = user?.uid ?? null;

for (const date of dates) {
  const dayKey = dateKey(date);

  for (const g of visibleGoals) {
    if (g.status === "completed") continue;

    const subs = subtasksByGoal[g.id] ?? [];

    for (const s of subs) {
      const isSharedAssigned =
        g.userId !== uid &&
       isGroupSharedGoal(g) &&
        s.assignedToUid === uid;

      if (g.userId !== uid && !isSharedAssigned) continue;
        const effectiveSubtask = getEffectiveSubtaskForDate(
          s,
          date,
          tz,
          scheduleOverridesByKey
        );

        const subtaskForDate = effectiveSubtask ?? s;

        if (!isSubtaskDueOnDate(subtaskForDate, date, tz)) continue;

        const override =
          scheduleOverridesByKey[getScheduleOverrideKey(s.id, dayKey)] ?? null;

        if (override?.isSkipped) continue;
        if (override?.isUnscheduled) continue;

        out.push({
  date,
  goalId: g.id,
  goalTitle: g.title,
  subtaskId: s.id,
  title: s.title,
isSharedAssigned,
sharedSourceGroupName:
  typeof (g as any).sharedGroupName === "string"
    ? (g as any).sharedGroupName
    : null,
frequency: s.frequency,

  dueAtMs:
    typeof subtaskForDate?.dueAtMs === "number"
      ? subtaskForDate.dueAtMs
      : null,

  metricValue:
    typeof s.metricValue === "number" ? s.metricValue : null,

  metricUnit:
    typeof s.metricUnit === "string" ? s.metricUnit : null,

  contributesToMetric: !!s.contributesToMetric,

  hasScheduleOverride: !!override,
  scheduleOverrideSource: override?.source ?? null,

  isUnscheduledForSelectedDay: false,

  // --- Linked Google Calendar event fields ---
  linkedCalendarEventId:
    typeof s.linkedCalendarEventId === "string"
      ? s.linkedCalendarEventId
      : null,

  linkedCalendarEventTitle:
    typeof s.linkedCalendarEventTitle === "string"
      ? s.linkedCalendarEventTitle
      : null,

  linkedCalendarEventStartMs:
    typeof s.linkedCalendarEventStartMs === "number"
      ? s.linkedCalendarEventStartMs
      : null,

  // --- NEW: persisted missing-event state (5F.1B) ---
  linkedCalendarLastKnownMissing:
    typeof s.linkedCalendarLastKnownMissing === "boolean"
      ? s.linkedCalendarLastKnownMissing
      : null,

  linkedCalendarMissingAtMs:
    typeof s.linkedCalendarMissingAtMs === "number"
      ? s.linkedCalendarMissingAtMs
      : null,
});
      }
    }
  }

  out.sort((a, b) => {
    const d = dayStartMs(a.date) - dayStartMs(b.date);
    if (d !== 0) return d;

    const aHasDue = typeof a.dueAtMs === "number";
    const bHasDue = typeof b.dueAtMs === "number";

    if (aHasDue && bHasDue) {
      const due = a.dueAtMs! - b.dueAtMs!;
      if (due !== 0) return due;
    } else if (aHasDue && !bHasDue) {
      return -1;
    } else if (!aHasDue && bHasDue) {
      return 1;
    }

    return a.title.localeCompare(b.title);
  });

  return out;
}, [visibleGoals, subtasksByGoal, scheduleOverridesByKey, selectedDate, mode, weekDates, tz]);

const grouped = useMemo(() => {
  const map = new Map<string, { date: Date; items: DatedItem[] }>();

  for (const it of datedItems) {
    const k = dateKey(it.date);
    const existing = map.get(k);
    if (existing) existing.items.push(it);
    else map.set(k, { date: it.date, items: [it] });
  }

  return Array.from(map.values()).sort((a, b) => dayStartMs(a.date) - dayStartMs(b.date));
}, [datedItems]);

const selectedGroup = useMemo(() => {
  const k = dateKey(selectedDate);
  return grouped.find((g) => dateKey(g.date) === k) ?? null;
}, [grouped, selectedDate]);


const selectedSplit = useMemo(() => {
  const items = selectedGroup?.items ?? [];
  const completedSet = completedByDayKey.get(selectedDayKey) ?? new Set<string>();

  return splitDueCompleted(items, (t) =>
    completedSet.has(completionKey(t.goalId, t.subtaskId))
  );
}, [selectedGroup, completedByDayKey, selectedDayKey]);

