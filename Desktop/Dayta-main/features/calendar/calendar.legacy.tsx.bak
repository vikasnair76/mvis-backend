      ]}
    >
      <Text style={styles.recoveryDangerBtnText}>
        {pendingSkip ? "Skipping..." : "Skip for this day"}
      </Text>
    </Pressable>
  </>
)}

          {entry.type === "unscheduled" && entry.suggestedSlot && (
            <Pressable
              onPress={() => handleReassignLaterToday(entry.item)}
