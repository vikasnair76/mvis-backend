const handleLinkEventToSubtask = async (
  goalId: string,
  subtaskId: string,
  eventTarget: NonNullable<typeof applyEventTarget>
) => {
  if (applyActionPending) return;

  try {
    setApplyActionPending(true);

    const subtaskRef = doc(db, "goals", goalId, "subtasks", subtaskId);
    const now = Date.now();

    await updateDoc(subtaskRef, {
  linkedCalendarEventId: eventTarget.eventId,
  linkedCalendarEventTitle: eventTarget.eventTitle,
  linkedCalendarEventStartMs: eventTarget.startMs,
  linkedCalendarEventEndMs: eventTarget.endMs ?? null,
  linkedCalendarCalendarId: eventTarget.calendarId,
  linkedCalendarEventUpdatedRaw: eventTarget.rawUpdated ?? null,
  linkedCalendarLinkedAtMs: now,

  linkedCalendarLastSyncedAtMs: now,
  linkedCalendarLastHandledStartMs: eventTarget.startMs,
  linkedCalendarLastHandledEndMs: eventTarget.endMs ?? null,
  linkedCalendarLastHandledUpdatedRaw: eventTarget.rawUpdated ?? null,
});

    const selectedApplySubtask =
  applyGoalSubtasks.find((s) => s.id === subtaskId) ?? null;

  

const subtaskTitle =
  typeof selectedApplySubtask?.title === "string" &&
  selectedApplySubtask.title.trim().length > 0
    ? selectedApplySubtask.title.trim()
    : "Subtask";

    addAutomationHistoryEntry(
  `Linked "${subtaskTitle}" to "${eventTarget.eventTitle}"`
);

Alert.alert(
  getEventActionSuccessTitle("link_only"),
getEventActionSuccessMessage({
  action: "link_only",
  eventTitle: eventTarget.eventTitle,
  subtaskTitle,
}),
  [
    {
      text: "OK",
      onPress: () => {
  const nextPromptKey = getAutomationPromptKey({
  eventTitle: eventTarget.eventTitle,
  goalId,
  subtaskId,
  promptType: "suggest_subtask",
});

const alreadySavedSuggestRule = hasMatchingCalendarRule({
  calendarRules,
  eventTitle: eventTarget.eventTitle,
  goalId,
  subtaskId,
  promptType: "suggest_subtask",
});

const alreadySuppressedThisSession =
  suppressedAutomationPromptKeys.has(nextPromptKey);

if (!alreadySavedSuggestRule && !alreadySuppressedThisSession) {
  setPostApplyAutomationPrompt({
    eventTitle: eventTarget.eventTitle,
    goalId,
    subtaskId,
    subtaskTitle,
    promptType: "suggest_subtask",
  });
}
},
    },
  ]
);



    resetApplyFlow();
  } catch (e: any) {
    console.error("link event to subtask failed", e);
    Alert.alert("Update failed", e?.message ?? "Unknown error");
  } finally {
    setApplyActionPending(false);
  }
};

const showLinkedEventFollowToast = (message: string) => {
  setLinkedEventFollowToast(message);

  if (linkedEventFollowToastTimeoutRef.current) {
    clearTimeout(linkedEventFollowToastTimeoutRef.current);
  }

  linkedEventFollowToastTimeoutRef.current = setTimeout(() => {
    setLinkedEventFollowToast(null);
    linkedEventFollowToastTimeoutRef.current = null;
  }, 2200);
};

const applyEventTimeToSubtask = async ({
  goalId,
  subtaskId,
  eventStartMs,
  animate = false,
  successToastMessage = null,
}: {
  goalId: string;
  subtaskId: string;
  eventStartMs: number;
  animate?: boolean;
  successToastMessage?: string | null;
}) => {
  const baseSubtask = getBaseSubtask(goalId, subtaskId);

  if (!baseSubtask) {
    throw new Error("Subtask not found");
  }

  const scheduleType = getScheduleType(baseSubtask);

  if (scheduleType === "oneTime") {
    const subtaskRef = doc(db, "goals", goalId, "subtasks", subtaskId);
    const targetDayKey = dayKeyFromDate(new Date(eventStartMs), tz);
    const patch = buildOneTimeSchedulePatch(targetDayKey, eventStartMs);

    await updateDoc(subtaskRef, patch);

    if (animate) {
      LayoutAnimation.configureNext(LayoutAnimation.Presets.easeInEaseOut);
    }

    applyLocalSubtaskPatch(goalId, subtaskId, patch);
  } else {
    const targetDate = new Date(eventStartMs);
    const targetDayKey = dayKeyFromDate(targetDate, tz);

    const overrideRef = doc(
      db,
      "goals",
      goalId,
      "subtasks",
      subtaskId,
      "scheduleOverrides",
      targetDayKey
    );

    const overridePatch = buildRecurringTimedOverride({
      userId: auth.currentUser?.uid ?? "",
      goalId,
      subtaskId,
      dayKey: targetDayKey,
      dueAtMs: eventStartMs,
      source: "suggestedTime",
    });

    await setDoc(overrideRef, overridePatch, { merge: true });

    if (animate) {
      LayoutAnimation.configureNext(LayoutAnimation.Presets.easeInEaseOut);
    }

    setScheduleOverridesByKey((prev) => ({
      ...prev,
      [getScheduleOverrideKey(subtaskId, targetDayKey)]: {
        ...(prev[getScheduleOverrideKey(subtaskId, targetDayKey)] ?? {}),
        dueAtMs: eventStartMs,
        isSkipped: false,
        isUnscheduled: false,
        source: "suggestedTime",
      },
    }));
  }

  if (successToastMessage) {
    showLinkedEventFollowToast(successToastMessage);
  }
};

const handleLinkEventAndUseTime = async (
  goalId: string,
  subtaskId: string,
  eventTarget: NonNullable<typeof applyEventTarget>
) => {
  if (applyActionPending) return;

  try {
    setApplyActionPending(true);

    const subtaskRef = doc(db, "goals", goalId, "subtasks", subtaskId);
    const baseSubtask = getBaseSubtask(goalId, subtaskId);

    if (!baseSubtask) {
      throw new Error("Subtask not found");
    }

    const now = Date.now();

    await updateDoc(subtaskRef, {
  linkedCalendarEventId: eventTarget.eventId,
  linkedCalendarEventTitle: eventTarget.eventTitle,
  linkedCalendarEventStartMs: eventTarget.startMs,
  linkedCalendarEventEndMs: eventTarget.endMs ?? null,
  linkedCalendarCalendarId: eventTarget.calendarId,
  linkedCalendarEventUpdatedRaw: eventTarget.rawUpdated ?? null,
  linkedCalendarLinkedAtMs: now,

  linkedCalendarLastSyncedAtMs: now,
  linkedCalendarLastHandledStartMs: eventTarget.startMs,
  linkedCalendarLastHandledEndMs: eventTarget.endMs ?? null,
  linkedCalendarLastHandledUpdatedRaw: eventTarget.rawUpdated ?? null,
});

    applyLocalSubtaskPatch(goalId, subtaskId, {
  linkedCalendarEventId: eventTarget.eventId,
  linkedCalendarEventTitle: eventTarget.eventTitle,
  linkedCalendarEventStartMs: eventTarget.startMs,
  linkedCalendarEventEndMs: eventTarget.endMs ?? null,
  linkedCalendarCalendarId: eventTarget.calendarId,
  linkedCalendarEventUpdatedRaw: eventTarget.rawUpdated ?? null,
  linkedCalendarLinkedAtMs: now,

  linkedCalendarLastSyncedAtMs: now,
  linkedCalendarLastHandledStartMs: eventTarget.startMs,
  linkedCalendarLastHandledEndMs: eventTarget.endMs ?? null,
  linkedCalendarLastHandledUpdatedRaw: eventTarget.rawUpdated ?? null,
});

    await applyEventTimeToSubtask({
      goalId,
      subtaskId,
      eventStartMs: eventTarget.startMs,
    });

    const selectedApplySubtask =
  applyGoalSubtasks.find((s) => s.id === subtaskId) ?? null;

const subtaskTitle =
  typeof selectedApplySubtask?.title === "string" &&
  selectedApplySubtask.title.trim().length > 0
    ? selectedApplySubtask.title.trim()
    : "Subtask";

    addAutomationHistoryEntry(
  `Linked "${subtaskTitle}" and updated its time`
);

Alert.alert(
  getEventActionSuccessTitle("link_and_use_time"),
getEventActionSuccessMessage({
  action: "link_and_use_time",
  eventTitle: eventTarget.eventTitle,
  subtaskTitle,
}),
  [
    {
      text: "OK",
      onPress: () => {
  const nextPromptKey = getAutomationPromptKey({
  eventTitle: eventTarget.eventTitle,
  goalId,
  subtaskId,
  promptType: "suggest_subtask",
});

const alreadySavedSuggestRule = hasMatchingCalendarRule({
  calendarRules,
  eventTitle: eventTarget.eventTitle,
  goalId,
  subtaskId,
  promptType: "suggest_subtask",
});

const alreadySuppressedThisSession =
  suppressedAutomationPromptKeys.has(nextPromptKey);

if (!alreadySavedSuggestRule && !alreadySuppressedThisSession) {
  setPostApplyAutomationPrompt({
    eventTitle: eventTarget.eventTitle,
    goalId,
    subtaskId,
    subtaskTitle,
    promptType: "suggest_subtask",
  });
}

  
},
    },
  ]
);

resetApplyFlow();
  } catch (e: any) {
    console.error("link event and use time failed", e);
    Alert.alert("Update failed", e?.message ?? "Unknown error");
  } finally {
    setApplyActionPending(false);
  }
};

const handleApplyEventToSubtaskCompletion = async (
  goalId: string,
  subtaskId: string,
  eventTarget: NonNullable<typeof applyEventTarget>
) => {
  if (applyActionPending) return;

  try {
    setApplyActionPending(true);

    const eventDate = new Date(eventTarget.startMs);
    const eventDayKey = getEventDayKeyFromApplyTarget(eventTarget);

    const selectedApplySubtask =
      applyGoalSubtasks.find((s) => s.id === subtaskId) ?? null;

    const subtaskTitle =
      typeof selectedApplySubtask?.title === "string" &&
      selectedApplySubtask.title.trim().length > 0
        ? selectedApplySubtask.title.trim()
        : "Subtask";

    await toggle(goalId, subtaskId, eventDate);

    Alert.alert(
      "Subtask completed",
      `"${subtaskTitle}" was marked complete from "${eventTarget.eventTitle}" on ${eventDayKey}.`
    );

    resetApplyFlow();
  } catch (e: any) {
    console.error("apply event to subtask completion failed", e);
    Alert.alert("Update failed", e?.message ?? "Unknown error");
  } finally {
    setApplyActionPending(false);
  }
};

const changedLinkedEventsBySubtaskId = useMemo(() => {
  const map = new Map<
    string,
    {
      goalId: string;
      eventId: string;
      event: GoogleCalendarEvent;
      detection: LinkedEventChangeDetection;
    }
  >();

  for (const subtask of calendarSubtasks) {
    const eventId =
      typeof subtask.linkedCalendarEventId === "string" &&
      subtask.linkedCalendarEventId.trim().length > 0
        ? subtask.linkedCalendarEventId.trim()
        : null;

    if (!eventId) continue;

    const currentEvent =
      linkedGoogleEventsById[eventId] ?? allGoogleEventsById.get(eventId);

    if (!currentEvent) continue;

    const detection = detectLinkedEventChange({
      subtask,
      currentEvent,
    });

    console.log("[Calendar] linked event detection inspect", {
  goalId: subtask.goalId,
  subtaskId: subtask.id,
  eventId,
  hasAnyChange: detection.hasAnyChange,
  startChanged: detection.startChanged,
  endChanged: detection.endChanged,
  titleChanged: detection.titleChanged,
  updatedChanged: detection.updatedChanged,
  previousHandledStartMs: detection.previousHandledStartMs,
  currentEventStartMs: detection.currentEventStartMs,
});

    if (!detection.hasAnyChange) continue;

    map.set(subtask.id, {
      goalId: subtask.goalId,
      eventId,
      event: currentEvent,
      detection,
    });
  }

  return map;
}, [
  calendarSubtasks,
  allGoogleEventsById,
  JSON.stringify(linkedGoogleEventsById),
]);
useEffect(() => {
  if (changedLinkedEventsBySubtaskId.size === 0) return;

  let cancelled = false;

  const run = async () => {
    for (const [subtaskId, changed] of changedLinkedEventsBySubtaskId.entries()) {
      if (cancelled) break;

      const subtask = calendarSubtasks.find((s) => s.id === subtaskId);
      if (!subtask) continue;

      const syncKey = `${changed.goalId}:${subtaskId}:${
  changed.detection.currentEventUpdatedRaw ??
  changed.detection.currentEventStartMs ??
  "none"
}`;

