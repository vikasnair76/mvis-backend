         title: s.title,
isSharedAssigned,
sharedSourceGroupName:
  typeof (g as any).sharedGroupName === "string"
    ? (g as any).sharedGroupName
    : null,
frequency: s.frequency,
          dueAtMs: null,
          metricValue:
