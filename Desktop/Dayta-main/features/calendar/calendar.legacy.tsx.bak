  subtaskId: string,
  date: Date,
  metricValue?: number | null
) => {
  console.log("[Calendar][TOGGLE] invoked", {
    goalId,
    subtaskId,
    date: date.toISOString?.() ?? String(date),
    metricValue: metricValue ?? null,
  });
  const dayKey = dateKey(date);
  const key = `${goalId}:${subtaskId}:${dayKey}`;
  const cKey = completionKey(goalId, subtaskId);

  if (pendingKeys.has(key)) return;

  // ✅ compute BEFORE we flip any local state
  const wasCompletedBefore =
  completedByDayKey.get(dayKey)?.has(cKey) ?? false;

  const metric = typeof metricValue === "number" ? metricValue : 0;

  setPendingKeys((prev) => new Set(prev).add(key));

  try {
    const uid = auth.currentUser?.uid;
    if (!uid) throw new Error("Not signed in");

    await toggleSubtaskCompletedTx(goalId, subtaskId, dayKey, uid,  metricValue ?? null);

    // ✅ bump heat instantly (count + metricSum) AFTER success
    setHeatByDayKey((prev) =>
      bumpHeatCount(
        prev,
        dayKey,
        wasCompletedBefore ? -1 : +1,
        wasCompletedBefore ? -metric : +metric
      )
    );
   

    // ✅ Update week-mode cache so checkmarks change instantly
    setCompletedByDayKey((prev) => {
      const next = new Map(prev);
      const setForDay = new Set(next.get(dayKey) ?? []);
      if (setForDay.has(cKey)) setForDay.delete(cKey);
      else setForDay.add(cKey);
      next.set(dayKey, setForDay);
      return next;
    });
  } catch (e: any) {
    console.error(e);
    Alert.alert("Update failed", e?.message ?? "Unknown error");
  } finally {
    setPendingKeys((prev) => {
      const next = new Set(prev);
      next.delete(key);
      return next;
    });
  }
};

const handleUseSuggestedTime = (
  item: CalendarItem & { date: Date },
  suggestedSlot: { startMs: number; endMs: number }
) => {
  const itemKey = `${item.goalId}:${item.subtaskId}:${dateKey(item.date)}`;

  if (pendingSuggestedTimeKeys.has(itemKey)) return;

  const currentTimeLabel =
    typeof item.dueAtMs === "number"
      ? new Date(item.dueAtMs).toLocaleTimeString([], {
          hour: "numeric",
          minute: "2-digit",
        })
      : "No current time";

  const nextTimeLabel = formatTimeRangeLabel(
    suggestedSlot.startMs,
    suggestedSlot.endMs
  );

  Alert.alert(
    "Use suggested time?",
    `${item.title}\n\nCurrent: ${currentTimeLabel}\nSuggested: ${nextTimeLabel}`,
    [
      { text: "Cancel", style: "cancel" },
      {
        text: "Use time",
        onPress: async () => {
          setPendingSuggestedTimeKeys((prev) => new Set(prev).add(itemKey));

          try {
            const baseSubtask = getBaseSubtask(item.goalId, item.subtaskId);

            if (!baseSubtask) {
              throw new Error("Subtask not found");
            }

            const scheduleType = getScheduleType(baseSubtask);
            
            const ref = doc(db, "goals", item.goalId, "subtasks", item.subtaskId);

            if (scheduleType === "oneTime") {
              const targetDayKey = dateKey(new Date(suggestedSlot.startMs));

const patch = {
  ...buildOneTimeSchedulePatch(targetDayKey, suggestedSlot.startMs),
  updatedAt: serverTimestamp(),
};

await updateDoc(ref, patch);
applyLocalSubtaskPatch(item.goalId, item.subtaskId, patch);
            } else {
              const dayKey = dateKey(item.date);
              const overrideRef = doc(
                db,
                "goals",
                item.goalId,
                "subtasks",
                item.subtaskId,
                "scheduleOverrides",
                dayKey
              );

              const overridePatch = buildRecurringTimedOverride({
  userId: auth.currentUser?.uid ?? "",
  goalId: item.goalId,
  subtaskId: item.subtaskId,
  dayKey,
  dueAtMs: suggestedSlot.startMs,
  source: "suggestedTime",
});

await setDoc(overrideRef, overridePatch, { merge: true });

setScheduleOverridesByKey((prev) => ({
                ...prev,
                [getScheduleOverrideKey(item.subtaskId, dayKey)]: {
                  ...(prev[getScheduleOverrideKey(item.subtaskId, dayKey)] ?? {}),
                  dueAtMs: suggestedSlot.startMs,
                  isSkipped: false,
                  isUnscheduled: false,
                  source: "suggestedTime",
                },
              }));
            }

            setRecentlyRescheduledKeys((prev) => {
              const next = new Set(prev);
              next.add(itemKey);
              return next;
            });

            setTimeout(() => {
              setRecentlyRescheduledKeys((prev) => {
                const next = new Set(prev);
                next.delete(itemKey);
                return next;
              });
            }, 2500);

            Alert.alert(
              "Time updated",
              `${item.title}\n\n${currentTimeLabel} → ${nextTimeLabel}`
            );
          } catch (e: any) {
            console.error("use suggested time failed", e);
            Alert.alert("Update failed", e?.message ?? "Unknown error");
          } finally {
            setPendingSuggestedTimeKeys((prev) => {
              const next = new Set(prev);
              next.delete(itemKey);
              return next;
            });
          }
        },
      },
    ]
  );
};

const handleOpenLinkedEvent = async (item: CalendarItem & { date: Date }) => {
  try {
    const linkedEventId =
      typeof item.linkedCalendarEventId === "string"
        ? item.linkedCalendarEventId
        : null;

    if (!linkedEventId) return;

    const event = allGoogleEventsById.get(linkedEventId);

    if (!event?.htmlLink) return;

    await Linking.openURL(event.htmlLink);
  } catch (e) {
    console.error("open linked google calendar event failed", e);
  }
};

const handleRefreshGoogleCalendar = async () => {
  if (manualSyncing) return;

  try {
    setManualSyncing(true);

    const result = await runGoogleCalendarAutoSync(calendarIntegration, {
      force: true,
    });

    if (result?.skipped && result.reason === "not_signed_in") {
      Alert.alert("Sync unavailable", "Please sign in first.");
      return;
    }

    if (result?.skipped && result.reason === "not_connected") {
      Alert.alert(
        "Sync unavailable",
        "Connect Google Calendar on Settings before refreshing."
      );
      return;
    }

    Alert.alert("Google Calendar refreshed", "Sync completed successfully.");
  } catch (e: any) {
    console.error("manual google calendar refresh failed", e);
    Alert.alert("Refresh failed", e?.message ?? "Unknown error");
  } finally {
    setManualSyncing(false);
  }
};

const applyGoalSubtasks = selectedGoalForApply
  ? subtasksByGoal[selectedGoalForApply] ?? []
  : [];

const applyGoalSubtasksSplit = {
  unlinked: applyGoalSubtasks.filter((s) => {
    const hasLinkedEvent =
      typeof s.linkedCalendarEventId === "string" &&
      s.linkedCalendarEventId.trim().length > 0;

    const isOneTime =
      s?.scheduleType === "oneTime" || s?.frequency === "once";

    if (!hasLinkedEvent) return true;

    return !isOneTime;
  }),
  linked: applyGoalSubtasks.filter((s) => {
    const hasLinkedEvent =
      typeof s.linkedCalendarEventId === "string" &&
      s.linkedCalendarEventId.trim().length > 0;

    const isOneTime =
      s?.scheduleType === "oneTime" || s?.frequency === "once";

    return hasLinkedEvent && isOneTime;
  }),
};



const applySnoozeToMs = async (
  item: CalendarItem & { date: Date },
  targetMs: number
) => {
  const sourceDayKey = dateKey(item.date);
  const targetDate = new Date(targetMs);
const sourceDayStart = dayStartMs(item.date);
const sourceDayEnd = sourceDayStart + 24 * 60 * 60 * 1000;

const targetDayKey =
  targetMs >= sourceDayStart && targetMs < sourceDayEnd
    ? sourceDayKey
    : dateKey(targetDate);
  const itemKey = `${item.goalId}:${item.subtaskId}:${sourceDayKey}`;

  if (pendingSnoozeKeys.has(itemKey)) return;

  setPendingSnoozeKeys((prev) => new Set(prev).add(itemKey));

  try {
    const baseSubtask = getBaseSubtask(item.goalId, item.subtaskId);

    if (!baseSubtask) {
      throw new Error("Subtask not found");
    }

    const scheduleType = getScheduleType(baseSubtask);

    if (scheduleType === "oneTime") {
      const ref = doc(db, "goals", item.goalId, "subtasks", item.subtaskId);

const patch = {
  ...buildOneTimeSchedulePatch(targetDayKey, targetMs),
  updatedAt: serverTimestamp(),
};

await updateDoc(ref, patch);
applyLocalSubtaskPatch(item.goalId, item.subtaskId, patch);
    } else {
      const uid = auth.currentUser?.uid ?? "";
      const sourceOverrideRef = doc(
        db,
        "goals",
        item.goalId,
        "subtasks",
        item.subtaskId,
        "scheduleOverrides",
        sourceDayKey
      );

      const targetOverrideRef = doc(
        db,
        "goals",
        item.goalId,
        "subtasks",
        item.subtaskId,
        "scheduleOverrides",
        targetDayKey
      );

      if (sourceDayKey === targetDayKey) {
        
  const overridePatch = buildRecurringTimedOverride({
    userId: uid,
    goalId: item.goalId,
    subtaskId: item.subtaskId,
    dayKey: sourceDayKey,
    dueAtMs: targetMs,
    source: "snooze",
  });

  await setDoc(sourceOverrideRef, overridePatch, { merge: true });

  setScheduleOverridesByKey((prev) => ({
    ...prev,
    [getScheduleOverrideKey(item.subtaskId, sourceDayKey)]: {
      ...(prev[getScheduleOverrideKey(item.subtaskId, sourceDayKey)] ?? {}),
      dueAtMs: targetMs,
      isSkipped: false,
      isUnscheduled: false,
      source: "snooze",
    },
  }));
} else {
  
  const sourceOverridePatch = buildRecurringUnscheduledOverride({
    userId: uid,
    goalId: item.goalId,
    subtaskId: item.subtaskId,
    dayKey: sourceDayKey,
    source: "snooze",
  });

  const targetOverridePatch = buildRecurringTimedOverride({
    userId: uid,
    goalId: item.goalId,
    subtaskId: item.subtaskId,
    dayKey: targetDayKey,
    dueAtMs: targetMs,
    source: "snooze",
  });

  await setDoc(sourceOverrideRef, sourceOverridePatch, { merge: true });
  await setDoc(targetOverrideRef, targetOverridePatch, { merge: true });

  setScheduleOverridesByKey((prev) => ({
    ...prev,
    [getScheduleOverrideKey(item.subtaskId, sourceDayKey)]: {
      ...(prev[getScheduleOverrideKey(item.subtaskId, sourceDayKey)] ?? {}),
      dueAtMs: null,
      isSkipped: false,
      isUnscheduled: true,
      source: "snooze",
    },
    [getScheduleOverrideKey(item.subtaskId, targetDayKey)]: {
      ...(prev[getScheduleOverrideKey(item.subtaskId, targetDayKey)] ?? {}),
      dueAtMs: targetMs,
      isSkipped: false,
      isUnscheduled: false,
      source: "snooze",
    },
  }));
}
    }

    setRecentlyRescheduledKeys((prev) => {
      const next = new Set(prev);
      next.add(itemKey);
      return next;
    });

    setTimeout(() => {
      setRecentlyRescheduledKeys((prev) => {
        const next = new Set(prev);
        next.delete(itemKey);
        return next;
      });
    }, 2500);

    Alert.alert(
      "Snoozed",
      `${item.title}\n\nNow set for ${formatTimeRangeLabel(
        targetMs,
        targetMs + DEFAULT_SUGGESTED_SLOT_MINUTES * 60 * 1000
      )}`
    );
  } catch (e: any) {
    console.error("snooze failed", e);
    Alert.alert("Update failed", e?.message ?? "Unknown error");
  } finally {
    setPendingSnoozeKeys((prev) => {
      const next = new Set(prev);
      next.delete(itemKey);
      return next;
    });
  }
};



const replaceExistingRulesForEventTitle = async (args: {
  userId: string;
  type: "suggest_subtask" | "auto_link" | "auto_apply_duration";
  eventTitle: string;
  nextGoalId: string;
  nextSubtaskId: string;
}) => {
  const normalizedTitle = normalizeCalendarRuleMatchText(args.eventTitle);
  if (!normalizedTitle) return 0;

  const existingRules = calendarRules.filter(
    (rule) =>
      rule.type === args.type &&
      rule.matchText === normalizedTitle &&
      !(
        rule.goalId === args.nextGoalId &&
        rule.subtaskId === args.nextSubtaskId
      )
  );

  let deletedCount = 0;

  for (const rule of existingRules) {
    deletedCount += await deleteCalendarRules({
      userId: args.userId,
      type: args.type,
      eventTitle: args.eventTitle,
      goalId: rule.goalId,
      subtaskId: rule.subtaskId,
    });
  }

  if (deletedCount > 0) {
    console.log("[CalendarRules] replaced existing rules", {
      type: args.type,
      eventTitle: args.eventTitle,
      normalizedTitle,
      nextGoalId: args.nextGoalId,
      nextSubtaskId: args.nextSubtaskId,
      deletedCount,
    });
  }

  return deletedCount;
};

const forgetAllRulesForEventTitle = async (args: {
  userId: string;
  eventTitle: string;
}) => {
  const normalizedTitle = normalizeCalendarRuleMatchText(args.eventTitle);
  if (!normalizedTitle) return { autoLinkDeleted: 0, suggestDeleted: 0, autoApplyDeleted: 0 };

  const matchingRules = calendarRules.filter(
    (rule) => rule.matchText === normalizedTitle
  );

  let autoLinkDeleted = 0;
  let suggestDeleted = 0;
  let autoApplyDeleted = 0;

  for (const rule of matchingRules) {
    const deletedCount = await deleteCalendarRules({
      userId: args.userId,
      type: rule.type as "auto_link" | "auto_apply_duration" | "suggest_subtask",
      eventTitle: args.eventTitle,
      goalId: rule.goalId,
      subtaskId: rule.subtaskId,
    });

    if (rule.type === "auto_link") autoLinkDeleted += deletedCount;
    if (rule.type === "suggest_subtask") suggestDeleted += deletedCount;
    if (rule.type === "auto_apply_duration") autoApplyDeleted += deletedCount;
  }

  console.log("[CalendarRules] forgot all rules for event title", {
    eventTitle: args.eventTitle,
    normalizedTitle,
    autoLinkDeleted,
    suggestDeleted,
    autoApplyDeleted,
  });

  return { autoLinkDeleted, suggestDeleted, autoApplyDeleted };
};

const maybeOfferSuggestSubtaskRule = (args: {
  eventTitle: string;
  goalId: string;
  subtaskId: string;
  subtaskTitle: string;
}) => {
  const uid = auth.currentUser?.uid;
  if (!uid) return;

  const normalizedTitle = normalizeCalendarRuleMatchText(args.eventTitle);
  if (!normalizedTitle) return;

  const alreadySaved = calendarRules.some(
    (rule) =>
      rule.type === "suggest_subtask" &&
      rule.goalId === args.goalId &&
      rule.subtaskId === args.subtaskId &&
      rule.matchText === normalizedTitle
  );

  if (alreadySaved) return;

  const promptKey = `${args.goalId}:${args.subtaskId}:${normalizedTitle}`;
  if (promptedRuleKeysRef.current[promptKey]) return;

  promptedRuleKeysRef.current[promptKey] = true;

  Alert.alert(
    "Remember this match?",
    `Use "${args.subtaskTitle}" for similar "${args.eventTitle}" events in the future?`,
    [
      {
  text: "Not now",
  style: "cancel",
  onPress: () => {
    setSuppressedAutomationPromptKeys((prev) => {
      const next = new Set(prev);
      next.add(promptKey);
      return next;
    });
  },
},
      {
  text: "Remember",
  onPress: async () => {
    try {
      await replaceExistingRulesForEventTitle({
        userId: uid,
        type: "suggest_subtask",
        eventTitle: args.eventTitle,
        nextGoalId: args.goalId,
        nextSubtaskId: args.subtaskId,
      });

      await createSuggestSubtaskRule({
        userId: uid,
        eventTitle: args.eventTitle,
        goalId: args.goalId,
        subtaskId: args.subtaskId,
      });

      Alert.alert(
        "Preference saved",
        "We’ll use this to improve future suggestions for similar events."
      );
    } catch (error) {
      console.error(
        "[CalendarRules] failed to create suggest_subtask rule",
        error
      );
      Alert.alert(
        "Couldn’t save preference",
        "The event apply worked, but the preference could not be saved."
      );
    }
  },
},
    ]
  );
  
};

