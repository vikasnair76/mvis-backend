# Database Configuration
# Configure your PostgreSQL database connection
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=5432

# Django Configuration
# Generate a new secret key for production: https://djecrety.ir/
SECRET_KEY=your-secret-key-here
DEBUG=True

# Web Server Configuration
WEB_PORT=8000

# JWT Configuration
# Use the same value as SECRET_KEY or generate a separate one
SIMPLE_JWT_SIGNING_KEY=your-jwt-signing-key-here
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=1440
JWT_REFRESH_TOKEN_LIFETIME_DAYS=2
JWT_SLIDING_TOKEN_LIFETIME_MINUTES=5
JWT_SLIDING_TOKEN_REFRESH_LIFETIME_DAYS=1

# Static and Media Files
STATIC_URL=/static/
MEDIA_URL=/media/
MEDIA_ROOT=/media/images/

# CORS and Security Configuration
# Add your domain names separated by commas
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
# Add your frontend URLs separated by commas
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOW_CREDENTIALS=True
# Headers that your frontend might send
CORS_ALLOW_HEADERS=accept,accept-encoding,authorization,content-type,dnt,origin,user-agent,x-csrftoken,x-requested-with,token
# HTTP methods your API supports
CORS_ALLOWED_METHODS=DELETE,GET,OPTIONS,PATCH,POST,PUT
