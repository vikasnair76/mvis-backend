});

const suggestedSlot =
  overlappingEvents.length > 0
    ? findFirstAvailableSlotOnDateNotBefore(
        item.date,
        events,
        DEFAULT_SUGGESTED_SLOT_MINUTES,
        recoveryNotBeforeMs
      )
    : null;

    return {
      item,
      overlappingEvents,
      hasOverlap: overlappingEvents.length > 0,
      suggestedSlot,
    };
  });
}, [selectedSplit.due, selectedDayGoogleEvents]);

const selectedDayOverlapCount = useMemo(() => {
  return selectedDayOverlaps.filter((x) => x.hasOverlap).length;
}, [selectedDayOverlaps]);

const selectedDayOverlapSummary = useMemo(() => {
  let timedConflictCount = 0;
  let untimedBlockedCount = 0;

  for (const row of selectedDayOverlaps) {
    if (!row.hasOverlap) continue;

    if (typeof row.item.dueAtMs === "number") {
      timedConflictCount += 1;
    } else {
      untimedBlockedCount += 1;
    }
  }

  const parts: string[] = [];

  if (timedConflictCount > 0) {
    parts.push(
      `${timedConflictCount} timed conflict${timedConflictCount === 1 ? "" : "s"}`
    );
  }

  if (untimedBlockedCount > 0) {
    parts.push(
      `${untimedBlockedCount} untimed item${untimedBlockedCount === 1 ? "" : "s"} blocked`
    );
  }

  return {
    timedConflictCount,
    untimedBlockedCount,
    totalCount: timedConflictCount + untimedBlockedCount,
    label: parts.join(" • "),
  };
}, [selectedDayOverlaps]);

