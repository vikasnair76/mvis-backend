    {selectedDayRecoveryItems.map((entry) => {
      const pendingSuggestedTime = pendingSuggestedTimeKeys.has(entry.key);
      const pendingUnscheduled = pendingUnscheduledKeys.has(entry.key);
      const pendingSkip = pendingSkipKeys.has(entry.key);
      const pendingClearOverride = pendingClearOverrideKeys.has(entry.key);
      const pendingReassign = pendingReassignKeys.has(entry.key);
      const pendingReassignTomorrow = pendingReassignTomorrowKeys.has(entry.key);

      const pendingAnyOverrideAction =
  pendingSuggestedTime ||
  pendingUnscheduled ||
  pendingSkip ||
  pendingClearOverride ||
  pendingReassign ||
  pendingReassignTomorrow;

      return (
        <View key={entry.key} style={styles.recoveryCard}>
