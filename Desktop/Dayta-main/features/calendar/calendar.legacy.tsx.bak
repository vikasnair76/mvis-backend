    typeof subtask.dueAtMs === "number" ? subtask.dueAtMs : null,
});

const isOneTime =
  subtask?.scheduleType === "oneTime" || subtask?.frequency === "once";

const shouldFollowEventChange = shouldAllowControlledAutoFollow({
  isOneTime,
  decision: policy.decision,
  reason: policy.reason,
});

const shouldPreserveManualSchedule = !shouldFollowEventChange;

console.log("[Calendar] linked event policy decision", {
