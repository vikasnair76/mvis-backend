  }),
  shouldFollowEventChange,
  shouldPreserveManualSchedule,
});

  if (shouldFollowEventChange  && isOneTime) {
  console.log("[Calendar] one-time auto-propagate candidate detected", {
    goalId: changed.goalId,
    subtaskId,
    previousHandledStartMs,
    currentEventStartMs,
  });
}

        await writeLinkedEventHistory({
          userId: auth.currentUser?.uid ?? "",
          goalId: changed.goalId,
          subtaskId,

          eventId: changed.eventId ?? null,
          eventTitle:
            typeof changed.event.title === "string" &&
            changed.event.title.trim().length > 0
              ? changed.event.title.trim()
              : null,

          previousHandledStartMs,
          previousLinkedEventStartMs:
            typeof subtask.linkedCalendarEventStartMs === "number"
              ? subtask.linkedCalendarEventStartMs
              : null,
          nextEventStartMs: currentEventStartMs,
          nextEventEndMs:
            typeof changed.event.endMs === "number"
              ? changed.event.endMs
              : null,

          previousDayKey:
            typeof previousHandledStartMs === "number"
              ? dayKeyFromDate(new Date(previousHandledStartMs), tz)
              : null,
          nextDayKey:
            typeof currentEventStartMs === "number"
              ? dayKeyFromDate(new Date(currentEventStartMs), tz)
              : null,

          decision: shouldFollowEventChange ? "auto_propagate" : "metadata_only",
          reason: policy.reason,

          hadOldDayOverride: !!override,
          oldOverrideDueAtMs:
            typeof override?.dueAtMs === "number"
              ? override.dueAtMs
              : null,
          oldOverrideIsSkipped: !!override?.isSkipped,
          oldOverrideIsUnscheduled: !!override?.isUnscheduled,
          oldOverrideSource: override?.source ?? null,
        });

        if (shouldFollowEventChange) {
  await applyEventTimeToSubtask({
    goalId: changed.goalId,
    subtaskId,
    eventStartMs: currentEventStartMs,
