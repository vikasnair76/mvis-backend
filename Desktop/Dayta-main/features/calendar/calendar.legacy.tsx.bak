const upcomingPlanningEvents = [...planningEvents].sort(
  (a, b) => a.startAtMs - b.startAtMs
);
const planningEventCount = upcomingPlanningEvents.length;

const handleCreatePlanningEvent = async () => {
  const uid = user?.uid ?? auth.currentUser?.uid ?? null;
  const title = planningEventTitleInput.trim();
  const dateText = planningEventDateInput.trim();
  const startTimeText = planningEventStartTimeInput.trim();
  const endTimeText = planningEventEndTimeInput.trim();

  if (!uid) {
    Alert.alert("Sign in required", "Please sign in to create planning events.");
    return;
  }
  if (!title) {
    Alert.alert("Title required", "Please enter an event title.");
    return;
  }
  if (!dateText) {
    Alert.alert("Date required", "Please enter an event date.");
    return;
  }
  if (!startTimeText) {
    Alert.alert("Start time required", "Please enter a start time.");
    return;
  }
  if (!endTimeText) {
    Alert.alert("End time required", "Please enter an end time.");
    return;
  }

  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateText)) {
    Alert.alert(
      "Invalid date",
      "Use date format YYYY-MM-DD, for example 2026-07-15."
    );
    return;
  }
  if (
    !/^\d{1,2}:\d{2}$/.test(startTimeText) ||
    !/^\d{1,2}:\d{2}$/.test(endTimeText)
  ) {
    Alert.alert("Invalid time", "Use 24-hour time like 09:00 or 14:30.");
    return;
  }

  const startAtMs = parsePlanningDateTime(dateText, startTimeText);
  const endAtMs = parsePlanningDateTime(dateText, endTimeText);
  if (startAtMs == null || endAtMs == null) {
    const dateOnlyMs = parsePlanningDateTime(dateText, "00:00");
    if (dateOnlyMs == null) {
      Alert.alert(
        "Invalid date",
        "Use date format YYYY-MM-DD, for example 2026-07-15."
      );
      return;
    }

    Alert.alert(
      "Invalid time",
      "Use 24-hour time like 09:00 or 14:30."
    );
    return;
  }
  if (endAtMs <= startAtMs) {
    Alert.alert("Invalid time range", "End time must be after start time.");
    return;
  }

  setSavingPlanningEvent(true);
  try {
    const eventId = await createPlanningCalendarEvent({
      title,
      description: planningEventDescriptionInput,
      scope: "personal",
      type: "personal",
      visibility: "private",
      ownerUid: uid,
      startAtMs,
      endAtMs,
      createdByUid: uid,
    });
    console.log("[Calendar] planning event created", eventId);
    await loadPersonalPlanningEventsOnce();

    setPlanningEventTitleInput("");
    setPlanningEventDescriptionInput("");
    setPlanningEventDateInput("");
    setPlanningEventStartTimeInput("");
    setPlanningEventEndTimeInput("");
    setShowCreatePlanningEvent(false);
  } catch (e: any) {
    Alert.alert("Could not create event", e?.message ?? "Please try again.");
  } finally {
    setSavingPlanningEvent(false);
  }
};

const handleArchivePlanningEvent = (event: PlanningCalendarEventDoc) => {
  Alert.alert(
    "Archive event?",
    `Archive "${event.title}"? It will no longer appear on your calendar.`,
    [
      { text: "Cancel", style: "cancel" },
      {
        text: "Archive",
        style: "destructive",
        onPress: async () => {
          console.log("[Calendar] archive planning event requested", event.id);
          try {
            await archivePlanningCalendarEvent({ eventId: event.id });
            console.log("[Calendar] archive planning event succeeded", event.id);
            const archivedSnap = await getDoc(doc(db, "planningCalendarEvents", event.id));
            const archivedData = archivedSnap.data() as Record<string, any> | undefined;
            console.log("[Calendar] archive planning event document", {
              eventId: event.id,
              archived: archivedData?.archived,
              updatedAtMs: archivedData?.updatedAtMs,
            });
            setPlanningEvents((prev) => prev.filter((item) => item.id !== event.id));
            await loadPersonalPlanningEventsOnce();
          } catch (e: any) {
            console.log("[Calendar] archive planning event failed", e);
            Alert.alert("Could not archive event", e?.message ?? "Please try again.");
          }
        },
      },
    ]
  );
};

const openApplyFlowForEvent = (event: GoogleCalendarEvent) => {
  const suggestedTaskMatch =
    selectedDaySuggestedTaskByEventId.get(event.id) ?? null;

  const applyCandidateItems = [
    ...selectedSplit.due,
    ...selectedDayUnscheduledItems,
  ];

  const savedRulePreselection = getSavedRulePreselectionForEvent({
    eventTitle: event.title ?? "Untitled event",
    items: applyCandidateItems,
    calendarRules,
  });

  const singleMatchGoalId =
    suggestedTaskMatch?.mode === "single"
      ? suggestedTaskMatch.topMatch.item.goalId
      : null;

  const nextGoalId = savedRulePreselection?.goalId ?? singleMatchGoalId ?? null;
  const nextStep = nextGoalId ? "subtask" : "goal";

  console.log("[Calendar] openApplyFlowForEvent called", {
    eventId: event.id,
    eventTitle: event.title ?? null,
    startMs: event.startMs ?? null,
    savedRuleGoalId: savedRulePreselection?.goalId ?? null,
    savedRuleSubtaskId: savedRulePreselection?.subtaskId ?? null,
    suggestedTaskMode: suggestedTaskMatch?.mode ?? null,
    suggestedGoalId: singleMatchGoalId,
    nextGoalId,
    nextStep,
  });

  setSelectedGoalForApply(nextGoalId);
  setApplyStep(nextStep);
  setApplyActionMenuTarget(null);

  setApplyEventTarget({
    eventId: event.id,
    eventTitle: event.title ?? "Untitled event",
    startMs: event.startMs,
    endMs: event.endMs ?? null,
    calendarId: event.calendarId ?? null,
    rawUpdated: event.rawUpdated ?? null,
  });
};

const openQuickApplyForSuggestedTask = (
  event: GoogleCalendarEvent,
  suggestedTaskMatch: NonNullable<
    ReturnType<typeof selectedDaySuggestedTaskByEventId.get>
  >
) => {
  openApplyFlowForEvent(event);

  if (suggestedTaskMatch.mode !== "single") return;

  addAutomationHistoryEntry(
  `Quick apply opened for "${suggestedTaskMatch.topMatch.item.title}"`
);
  setApplyOpenedViaQuickSuggestion(true);
  
  setApplyStep("subtask");
  setSelectedGoalForApply(suggestedTaskMatch.topMatch.item.goalId);
};

const handleQuickSuggestedLink = async (
  event: GoogleCalendarEvent,
  suggestedTaskMatch: NonNullable<
    ReturnType<typeof selectedDaySuggestedTaskByEventId.get>
  >
) => {
  if (suggestedTaskMatch.mode !== "single") return;
  if (pendingQuickLinkEventIds.has(event.id)) return;

  const targetGoalId = suggestedTaskMatch.topMatch.item.goalId;
  const targetSubtaskId = suggestedTaskMatch.topMatch.item.subtaskId;

  if (!targetGoalId || !targetSubtaskId) return;

  setPendingQuickLinkEventIds((prev) => {
    const next = new Set(prev);
    next.add(event.id);
    return next;
  });

  try {
    await handleLinkEventToSubtask(targetGoalId, targetSubtaskId, {
      eventId: event.id,
      eventTitle: event.title,
      startMs: event.startMs,
      endMs: event.endMs,
      calendarId: event.calendarId ?? null,
      rawUpdated: event.rawUpdated ?? null,
    });

    addAutomationHistoryEntry(
      `Quick linked "${suggestedTaskMatch.topMatch.item.title}"`
    );

    markQuickLinkSuccess(event.id);
  } catch (error) {
    console.error("[Calendar] quick suggested link failed", error);

    Alert.alert(
      "Couldn’t quick link",
      "Something went wrong while linking this suggested task."
    );
  } finally {
    setPendingQuickLinkEventIds((prev) => {
      const next = new Set(prev);
      next.delete(event.id);
      return next;
    });
  }
};

const applySavedRuleSuggestion =
  applyEventTarget && selectedGoalForApply
    ? getApplyPanelSavedRuleSuggestion({
        eventTitle: applyEventTarget.eventTitle,
        subtasks: applyGoalSubtasks,
        goalId: selectedGoalForApply,
        calendarRules,
      })
    : null;

const applySuggestedSubtaskId =
  applySavedRuleSuggestion?.subtaskId ??
  (applyEventTarget &&
  applyStep === "subtask" &&
  selectedGoalForApply
    ? (() => {
        const suggestion =
          selectedDaySuggestedTaskByEventId.get(applyEventTarget.eventId) ?? null;

        if (suggestion?.mode !== "single") return null;
        if (suggestion.topMatch.item.goalId !== selectedGoalForApply) return null;

        return suggestion.topMatch.item.subtaskId;
      })()
    : null);

const applySuggestedSubtaskTitle =
  applySavedRuleSuggestion?.subtaskTitle ??
  (applyEventTarget &&
  applyStep === "subtask" &&
  selectedGoalForApply
    ? (() => {
        const suggestion =
          selectedDaySuggestedTaskByEventId.get(applyEventTarget.eventId) ?? null;

        if (suggestion?.mode !== "single") return null;
        if (suggestion.topMatch.item.goalId !== selectedGoalForApply) return null;

        return suggestion.topMatch.item.title;
      })()
    : null);

    const applySuggestedReasonLabel =
  !applySavedRuleSuggestion &&
  applyEventTarget &&
  applyStep === "subtask" &&
  selectedGoalForApply
    ? (() => {
        const suggestion =
          selectedDaySuggestedTaskByEventId.get(applyEventTarget.eventId) ?? null;

        if (suggestion?.mode !== "single") return null;
        if (suggestion.topMatch.item.goalId !== selectedGoalForApply) return null;

        return formatCalendarSuggestionReasonLabel(
          suggestion.topMatch.reasons
        );
      })()
    : null;

const applyHasAmbiguousSuggestedSubtasks =
  !applySavedRuleSuggestion &&
  applyEventTarget &&
  applyStep === "subtask" &&
  selectedGoalForApply
    ? (() => {
        const suggestion =
          selectedDaySuggestedTaskByEventId.get(applyEventTarget.eventId) ?? null;

        if (suggestion?.mode !== "ambiguous") return false;

        const topMatchesGoal =
          suggestion.topMatch.item.goalId === selectedGoalForApply;

        const secondMatchesGoal =
          !!suggestion.secondMatch &&
          suggestion.secondMatch.item.goalId === selectedGoalForApply;

        return topMatchesGoal || secondMatchesGoal;
      })()
    : false;

    const applyAmbiguousTopTitle =
  !applySavedRuleSuggestion &&
  applyEventTarget &&
  applyStep === "subtask" &&
  selectedGoalForApply
    ? (() => {
        const suggestion =
          selectedDaySuggestedTaskByEventId.get(applyEventTarget.eventId) ?? null;

        if (suggestion?.mode !== "ambiguous") return null;
        if (suggestion.topMatch.item.goalId !== selectedGoalForApply) return null;

        return suggestion.topMatch.item.title;
      })()
    : null;

const applyAmbiguousSecondTitle =
  !applySavedRuleSuggestion &&
  applyEventTarget &&
  applyStep === "subtask" &&
  selectedGoalForApply
    ? (() => {
        const suggestion =
          selectedDaySuggestedTaskByEventId.get(applyEventTarget.eventId) ?? null;

        if (suggestion?.mode !== "ambiguous") return null;
        if (!suggestion.secondMatch) return null;
        if (suggestion.secondMatch.item.goalId !== selectedGoalForApply) return null;

        return suggestion.secondMatch.item.title;
      })()
    : null;

    const applyGoalSubtasksUnlinkedSorted = [...applyGoalSubtasksSplit.unlinked].sort(
  (a, b) => {
    const aSuggested = a.id === applySuggestedSubtaskId ? 1 : 0;
    const bSuggested = b.id === applySuggestedSubtaskId ? 1 : 0;
    return bSuggested - aSuggested;
  }
);

const applyGoalSubtasksLinkedSorted = [...applyGoalSubtasksSplit.linked].sort(
  (a, b) => {
    const aSuggested = a.id === applySuggestedSubtaskId ? 1 : 0;
    const bSuggested = b.id === applySuggestedSubtaskId ? 1 : 0;
    return bSuggested - aSuggested;
  }
);

