        <Pressable style={styles.smallBtn} onPress={goNext}>
          <Text style={styles.smallBtnText}>›</Text>
        </Pressable>
      </View>
<View style={styles.modeRow}>
  {(["day", "week", "month"] as const).map((m) => (
    <Pressable
      key={m}
      onPress={() => setMode(m)}
      style={[styles.pill, mode === m && styles.pillActive]}
    >
      <Text style={styles.pillText}>{m}</Text>
    </Pressable>
  ))}
</View>
{integratedGroupCalendar.activeGroupCount > 0 ? (
  <Pressable
    accessibilityRole="switch"
    accessibilityState={{ checked: showGroupEvents }}
