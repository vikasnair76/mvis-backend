    <Pressable
      onPress={() => {
        setApplyActionMenuTarget(null);
 
  setApplyStep("goal");
  setSelectedGoalForApply(null);
  
      }}
      style={styles.applyCancelBtn}
    >
      <Text style={styles.applyCancelBtnText}>Back</Text>
    </Pressable>
  </>
)}

    <Pressable
      onPress={() => {
        setApplyEventTarget(null);
        setApplyStep("goal");
        setSelectedGoalForApply(null);
        setApplyActionMenuTarget(null);
        setApplyOpenedViaQuickSuggestion(false);
      }}
      style={styles.applyCancelBtn}
    >
      <Text style={styles.applyCancelBtnText}>Cancel</Text>
    </Pressable>
  </View>
)}
    </>
  )
) : null}

{postApplyAutomationPrompt && (
  
  <View
  style={styles.automationPromptCard}
  onLayout={(e) => {
    automationPromptYRef.current = e.nativeEvent.layout.y;
  }}
>
    <Text style={styles.automationPromptTitle}>
  {getAutomationPromptTitle(postApplyAutomationPrompt.promptType)}
</Text>

<Text style={styles.automationPromptStepHint}>
  {postApplyAutomationPrompt.promptType === "suggest_subtask"
    ? "Step 1 of 2 • Improve future suggestions"
    : "Step 2 of 2 • Optional automation"}
</Text>

    <Text style={styles.automationPromptText}>
  {getAutomationPromptBody({
    promptType: postApplyAutomationPrompt.promptType,
    subtaskTitle: postApplyAutomationPrompt.subtaskTitle,
    eventTitle: postApplyAutomationPrompt.eventTitle,
  })}
</Text>

    <Pressable
      onPress={async () => {
        const uid = auth.currentUser?.uid;
        if (!uid) return;

        try {
                    if (postApplyAutomationPrompt.promptType === "suggest_subtask") {
            await replaceExistingRulesForEventTitle({
              userId: uid,
              type: "suggest_subtask",
              eventTitle: postApplyAutomationPrompt.eventTitle,
              nextGoalId: postApplyAutomationPrompt.goalId,
              nextSubtaskId: postApplyAutomationPrompt.subtaskId,
            });

            addAutomationHistoryEntry(
  `Saved suggestion preference for "${postApplyAutomationPrompt.subtaskTitle}"`
);

            if (postApplyAutomationPromptKey) {
  setSuppressedAutomationPromptKeys((prev) => {
    const next = new Set(prev);
    next.add(postApplyAutomationPromptKey);
    return next;
  });
}

            await createSuggestSubtaskRule({
              userId: uid,
              eventTitle: postApplyAutomationPrompt.eventTitle,
              goalId: postApplyAutomationPrompt.goalId,
              subtaskId: postApplyAutomationPrompt.subtaskId,
            });

            setPostApplyAutomationPrompt({
              ...postApplyAutomationPrompt,
              promptType: "auto_link",
            });
          } else {
            await replaceExistingRulesForEventTitle({
              userId: uid,
              type: "auto_link",
              eventTitle: postApplyAutomationPrompt.eventTitle,
              nextGoalId: postApplyAutomationPrompt.goalId,
              nextSubtaskId: postApplyAutomationPrompt.subtaskId,
            });

            await createCalendarRule({
              userId: uid,
              type: "auto_link",
              eventTitle: postApplyAutomationPrompt.eventTitle,
              goalId: postApplyAutomationPrompt.goalId,
              subtaskId: postApplyAutomationPrompt.subtaskId,
            });

            if (postApplyAutomationPromptKey) {
  setSuppressedAutomationPromptKeys((prev) => {
    const next = new Set(prev);
    next.add(postApplyAutomationPromptKey);
    return next;
  });
}

            setPostApplyAutomationPrompt(null);

            addAutomationHistoryEntry(
  `Enabled auto-link for "${postApplyAutomationPrompt.subtaskTitle}"`
);

            Alert.alert(
  "Auto-link enabled",
  getAutomationRuleSuccessMessage({
    type: "auto_link",
    subtaskTitle: postApplyAutomationPrompt.subtaskTitle,
  })
);
          }
        } catch (error: any) {
          console.error("[Calendar] automation prompt save failed", error);

          Alert.alert(
            "Couldn’t save preference",
            error?.message ?? "Unknown error"
          );
        }
      }}
      style={styles.automationPromptPrimaryBtn}
    >
      <Text style={styles.automationPromptPrimaryBtnText}>
  {getAutomationPromptPrimaryLabel(postApplyAutomationPrompt.promptType)}
</Text>
    </Pressable>

    <Pressable
      onPress={() => {
  if (postApplyAutomationPromptKey) {
    setSuppressedAutomationPromptKeys((prev) => {
      const next = new Set(prev);
      next.add(postApplyAutomationPromptKey);
      return next;
    });
  }

  setPostApplyAutomationPrompt(null);
}}
      style={styles.automationPromptSecondaryBtn}
    >
      <Text style={styles.automationPromptSecondaryBtnText}>
        Not now
      </Text>
    </Pressable>

    <Text style={styles.automationPromptFootnote}>
  You can still manage saved automation preferences later in Settings.
</Text>
  </View>
)}

{automationHistory.length > 0 && (
  <View style={styles.automationHistorySection}>
    <View style={styles.automationHistoryHeaderRow}>
      <Text style={styles.automationHistoryTitle}>
        Recent automation actions
      </Text>

      {automationHistory.length > collapsedAutomationHistoryCount && (
        <Pressable
          onPress={() => setShowAllAutomationHistory((prev) => !prev)}
          style={styles.automationHistoryToggleBtn}
        >
          <Text style={styles.automationHistoryToggleBtnText}>
            {showAllAutomationHistory
              ? "Hide"
              : `Show ${hiddenAutomationHistoryCount} more`}
          </Text>
        </Pressable>
      )}
    </View>

    {visibleAutomationHistory.map((entry) => (
      <View key={entry.id} style={styles.automationHistoryCard}>
        <Text style={styles.automationHistoryLabel}>{entry.label}</Text>
        <Text style={styles.automationHistoryTime}>
          {formatAutomationHistoryTime(entry.createdAtMs)}
        </Text>
      </View>
    ))}
  </View>
)}

{applyActionMenuTarget && applyEventTarget && (() => {
  const eventDayKey = getEventDayKeyFromApplyTarget(applyEventTarget);

  const eventCompletionKey = completionKey(
  applyActionMenuTarget.goalId,
  applyActionMenuTarget.subtaskId
);

 const isAlreadyCompletedForEventDay =
  completedByDayKey.get(eventDayKey)?.has(eventCompletionKey) ?? false;

    const selectedApplySubtask =
  applyGoalSubtasks.find(
    (s) => s.id === applyActionMenuTarget.subtaskId
  ) ?? null;

const normalizedApplyEventTitle = normalizeCalendarRuleMatchText(
  applyEventTarget.eventTitle
);

const hasAutoLinkRuleForSelection = calendarRules.some(
  (rule) =>
    rule.type === "auto_link" &&
    rule.goalId === applyActionMenuTarget.goalId &&
    rule.subtaskId === applyActionMenuTarget.subtaskId &&
    rule.matchText === normalizedApplyEventTitle
);

const hasAutoApplyDurationRuleForSelection = calendarRules.some(
  (rule) =>
    rule.type === "auto_apply_duration" &&
    rule.goalId === applyActionMenuTarget.goalId &&
    rule.subtaskId === applyActionMenuTarget.subtaskId &&
    rule.matchText === normalizedApplyEventTitle
);

const canEnableAutoApplyDurationForSelection =
  !!selectedApplySubtask &&
  !!selectedApplySubtask.contributesToMetric &&
  typeof selectedApplySubtask.metricUnit === "string" &&
  selectedApplySubtask.metricUnit.trim().length > 0;

  const durationMetricValue =
  selectedApplySubtask && applyEventTarget
    ? convertEventDurationToMetricValue(selectedApplySubtask, applyEventTarget)
    : null;

    const eventDurationLabel = formatEventDurationLabel(applyEventTarget);

const isOneTimeApplySubtask =
  selectedApplySubtask?.scheduleType === "oneTime" ||
  selectedApplySubtask?.frequency === "once";

const isLinkedToDifferentEvent =
  isOneTimeApplySubtask &&
  !!selectedApplySubtask?.linkedCalendarEventId &&
  selectedApplySubtask.linkedCalendarEventId !== applyEventTarget.eventId;

const isOnceSubtaskAlreadyCompleted =
  selectedApplySubtask?.frequency === "once" &&
  selectedApplySubtask?.firstCompletedAtMs != null;

  const isRecurringPreviouslyLinked =
  !isOneTimeApplySubtask &&
  !!selectedApplySubtask?.linkedCalendarEventId &&
  selectedApplySubtask.linkedCalendarEventId !== applyEventTarget.eventId;

  const isCompletionBlocked =
  isAlreadyCompletedForEventDay ||
  isOnceSubtaskAlreadyCompleted ||
  isLinkedToDifferentEvent;
const hasSupportedDurationMetric =
  !!selectedApplySubtask &&
  isTimeBasedMetricSubtask(selectedApplySubtask) &&
  durationMetricValue != null;

const canApplyEventDuration = hasSupportedDurationMetric;

const isDurationApplyBlocked =
  isAlreadyCompletedForEventDay ||
  isOnceSubtaskAlreadyCompleted ||
  isLinkedToDifferentEvent;

const durationBlockedReason = getApplyDurationBlockedReason({
  isAlreadyCompletedForEventDay,
  isOnceSubtaskAlreadyCompleted,
  isLinkedToDifferentEvent,
});

  const completionBlockedReason = getApplyCompletionBlockedReason({
  isAlreadyCompletedForEventDay,
  isOnceSubtaskAlreadyCompleted,
  isLinkedToDifferentEvent,
});

  return (
    <View style={styles.applyActionSheetBackdrop}>
      <Pressable
        style={styles.applyActionSheetScrim}
        onPress={closeApplyActionMenu}
      />

      <View style={styles.applyActionSheet}>
        <Text style={styles.applyActionSheetTitle}>
          {applyActionMenuTarget.mode === "linked"
            ? "Apply event to linked subtask"
            : "Apply event to subtask"}
        </Text>

        <Text style={styles.applyActionSheetSubtitle}>
          {applyActionMenuTarget.subtaskTitle}
        </Text>

        <Text style={styles.applyActionSheetMeta}>
          Event: {applyActionMenuTarget.nextEventTitle ?? "Selected event"}
        </Text>

        {eventDurationLabel && (
  <Text style={styles.applyActionSheetMeta}>
    Duration: {eventDurationLabel}
  </Text>
)}

        {canApplyEventDuration && (
  <Text style={styles.applyActionSheetMeta}>
    This subtask can use the event’s duration to update goal progress.
  </Text>
)}

        {applyActionMenuTarget.mode === "linked" &&
          !!applyActionMenuTarget.existingLinkedTitle && (
            <Text style={styles.applyActionSheetMeta}>
              Current link: {applyActionMenuTarget.existingLinkedTitle}
            </Text>
          )}

        <Pressable
          disabled={applyActionPending}
          onPress={async () => {
            if (!applyEventTarget || applyActionPending) return;
            //closeApplyActionMenu();

            await handleLinkEventToSubtask(
              applyActionMenuTarget.goalId,
              applyActionMenuTarget.subtaskId,
              applyEventTarget
            );
          }}
          style={[
            styles.applyActionSheetOption,
            applyActionPending && styles.applyActionSheetOptionDisabled,
          ]}
        >
          <Text style={styles.applyActionSheetOptionText}>
          
            {applyActionMenuTarget.mode === "linked"
              ? "Replace link only"
              : "Link only"}
          </Text>
        </Pressable>

        <Pressable
  disabled={applyActionPending}
  onPress={async () => {
    if (!applyEventTarget || applyActionPending) return;
    //closeApplyActionMenu();

    await handleLinkEventAndUseTime(
      applyActionMenuTarget.goalId,
      applyActionMenuTarget.subtaskId,
      applyEventTarget
    );
  }}
  style={[
    styles.applyActionSheetOption,
    applyActionPending && styles.applyActionSheetOptionDisabled,
  ]}
>
  <Text style={styles.applyActionSheetOptionText}>
    {applyActionMenuTarget.mode === "linked"
      ? "Replace link + use new event time"
      : "Link + use event time"}
  </Text>
</Pressable>

{!hasAutoLinkRuleForSelection && (
  <Pressable
    disabled={applyActionPending}
    onPress={() => {
      if (!applyEventTarget || applyActionPending) return;

      maybeOfferAutoLinkRule({
        eventTitle: applyEventTarget.eventTitle,
        goalId: applyActionMenuTarget.goalId,
        subtaskId: applyActionMenuTarget.subtaskId,
        subtaskTitle: applyActionMenuTarget.subtaskTitle,
      });
    }}
    style={[
      styles.applyActionSheetSecondaryBtn,
      applyActionPending && styles.applyActionSheetOptionDisabled,
    ]}
  >
    <Text style={styles.applyActionSheetSecondaryBtnText}>
      Enable auto-link
    </Text>
  </Pressable>
)}

{canEnableAutoApplyDurationForSelection &&
  !hasAutoApplyDurationRuleForSelection && (
  <Pressable
    disabled={applyActionPending}
    onPress={() => {
      if (!applyEventTarget || applyActionPending) return;

      maybeOfferAutoApplyDurationRule({
        eventTitle: applyEventTarget.eventTitle,
        goalId: applyActionMenuTarget.goalId,
        subtaskId: applyActionMenuTarget.subtaskId,
        subtaskTitle: applyActionMenuTarget.subtaskTitle,
      });
    }}
    style={[
      styles.applyActionSheetSecondaryBtn,
      applyActionPending && styles.applyActionSheetOptionDisabled,
    ]}
  >
    <Text style={styles.applyActionSheetSecondaryBtnText}>
      Enable auto-apply duration
    </Text>
  </Pressable>
)}

{!!selectedApplySubtask?.contributesToMetric &&
  !canEnableAutoApplyDurationForSelection && (
    <Text style={styles.applyActionSheetInfoText}>
      Auto-apply duration is only available for time-based metric subtasks.
    </Text>
  )}



        {canApplyEventDuration && (
  <Pressable
    disabled={applyActionPending || isDurationApplyBlocked}
    onPress={async () => {
      if (
        !applyEventTarget ||
        applyActionPending ||
        isDurationApplyBlocked
      ) {
        return;
      }

      await handleApplyEventDurationToProgress(
        applyActionMenuTarget.goalId,
        applyActionMenuTarget.subtaskId,
        applyEventTarget
      );
    }}
    style={[
      styles.applyActionSheetOption,
      styles.applyActionSheetOptionPrimary, // 👈 highlight
      (applyActionPending || isDurationApplyBlocked) &&
        styles.applyActionSheetOptionDisabled,
    ]}
  >
    <View>
      <Text
  style={[
    styles.applyActionSheetOptionText,
    styles.applyActionSheetOptionPrimaryText,
  ]}
>
  {applyActionPending
    ? "Applying..."
    : `⏱  ${getDurationApplyLabel(durationMetricValue!, selectedApplySubtask)}`}
</Text>

      {!isDurationApplyBlocked && (
        <Text style={styles.applyActionSheetSubtext}>
          Uses event length to update progress
        </Text>
      )}
    </View>
  </Pressable>
)}



{canApplyEventDuration && isDurationApplyBlocked && !!durationBlockedReason && (
  <Text style={styles.applyActionSheetBlockedHint}>
    {durationBlockedReason}
  </Text>
)}

        <Pressable
          disabled={applyActionPending || isCompletionBlocked}
          onPress={async () => {
            if (
  !applyEventTarget ||
  applyActionPending ||
  isCompletionBlocked
) {
  return;
}

            //closeApplyActionMenu();

            await handleApplyEventToSubtaskCompletion(
              applyActionMenuTarget.goalId,
              applyActionMenuTarget.subtaskId,
              applyEventTarget
            );
          }}
          style={[
            styles.applyActionSheetOption,
            (applyActionPending || isCompletionBlocked) &&
  styles.applyActionSheetOptionDisabled
          ]}
        >
          <Text style={styles.applyActionSheetOptionText}>
            {isOnceSubtaskAlreadyCompleted
  ? "Already completed (one-time task)"
  : isAlreadyCompletedForEventDay
  ? "Already completed for this event day"
  : "Mark subtask complete"}
          </Text>
        </Pressable>

        {isCompletionBlocked && !!completionBlockedReason && (
  <Text style={styles.applyActionSheetBlockedHint}>
    {completionBlockedReason}
  </Text>
)}

{isRecurringPreviouslyLinked && (
  <Text style={styles.applyActionSheetInfoText}>
    This recurring subtask was previously linked to a different event, but it can still be used for this occurrence.
  </Text>
)}

        <Pressable
          onPress={closeApplyActionMenu}
          style={styles.applyActionSheetCancel}
        >
          <Text style={styles.applyActionSheetCancelText}>Cancel</Text>
        </Pressable>
      </View>
    </View>
  );
})()}
{snoozeMenuTarget && (
  <View style={styles.snoozeSheetBackdrop}>
    <Pressable style={styles.snoozeSheetScrim} onPress={closeSnoozeMenu} />

    <View style={styles.snoozeSheet}>
      <Text style={styles.snoozeSheetTitle}>Snooze task</Text>

      <Text style={styles.snoozeSheetSubtitle}>
        {snoozeMenuTarget.title}
      </Text>

      <Pressable
        onPress={() => runSnoozeChoice("30")}
        style={styles.snoozeSheetOption}
      >
        <Text style={styles.snoozeSheetOptionText}>+30 min</Text>
      </Pressable>

      <Pressable
        onPress={() => runSnoozeChoice("60")}
        style={styles.snoozeSheetOption}
      >
        <Text style={styles.snoozeSheetOptionText}>+1 hour</Text>
      </Pressable>

      <Pressable
        onPress={() => runSnoozeChoice("tomorrow")}
        style={styles.snoozeSheetOption}
      >
        <Text style={styles.snoozeSheetOptionText}>Tomorrow morning</Text>
      </Pressable>

      <Pressable
        onPress={closeSnoozeMenu}
        style={styles.snoozeSheetCancel}
      >
        <Text style={styles.snoozeSheetCancelText}>Cancel</Text>
      </Pressable>
    </View>
  </View>
)}
    </ScrollView>
  );
}

