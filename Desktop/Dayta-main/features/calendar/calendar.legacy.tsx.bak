        {!!s.linkedCalendarEventId &&
  (s?.scheduleType === "oneTime" || s?.frequency === "once") && (
    <Text style={styles.applySubtaskLinkedBadge}>
      Already linked
    </Text>
  )}
      </>
    </Pressable>
  );
})}
      </>
    )}

    {applyGoalSubtasksSplit.linked.length > 0 && (
