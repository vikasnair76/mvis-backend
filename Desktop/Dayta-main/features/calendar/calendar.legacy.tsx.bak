          });

          const suggestedTaskMatch =
  selectedDaySuggestedTaskByEventId.get(event.id) ?? null;

const savedPreferenceForSuggestedTask =
  suggestedTaskMatch?.mode === "single"
    ? hasSavedSuggestPreference({
        eventTitle: event.title ?? "Untitled event",
        goalId: suggestedTaskMatch.topMatch.item.goalId,
        subtaskId: suggestedTaskMatch.topMatch.item.subtaskId,
        calendarRules,
      })
    : false;

const hasSavedPreferenceForThisEvent = hasSavedPreferenceForEvent({
  eventTitle: event.title,
  calendarRules,
});

const suggestedTaskReasonLabel =
  suggestedTaskMatch?.mode === "single"
    ? formatCalendarSuggestionReasonLabel(
        suggestedTaskMatch.topMatch.reasons
      )
    : null;

    const ambiguousTopReasonLabel =
  suggestedTaskMatch?.mode === "ambiguous"
    ? formatCalendarSuggestionReasonLabel(
        suggestedTaskMatch.topMatch.reasons
      )
    : null;

const ambiguousSecondReasonLabel =
  suggestedTaskMatch?.mode === "ambiguous" &&
  suggestedTaskMatch.secondMatch
    ? formatCalendarSuggestionReasonLabel(
