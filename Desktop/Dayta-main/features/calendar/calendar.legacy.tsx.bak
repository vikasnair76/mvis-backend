        <Text style={styles.applySectionTitle}>Linked one-time subtasks</Text>

       {applyGoalSubtasksLinkedSorted.map((s) => {
  const isSuggestedApplySubtask = s.id === applySuggestedSubtaskId;

    const suggestedApplyReasonLabel =
    isSuggestedApplySubtask && !applySavedRuleSuggestion
      ? applySuggestedReasonLabel
      : null;

  const hasAutoLinkEnabled =
    applyEventTarget != null
      ? hasAutoLinkRuleForEvent({
          eventTitle: applyEventTarget.eventTitle,
          goalId: selectedGoalForApply,
          subtaskId: s.id,
          calendarRules,
        })
      : false;

  const hasAutoApplyEnabled =
