  type AutomationHistoryEntry = {
  id: string;
  label: string;
  createdAtMs: number;
};

const [automationHistory, setAutomationHistory] = useState<
  AutomationHistoryEntry[]
>([]);



function formatAutomationHistoryTime(createdAtMs: number) {
  const diffMs = Date.now() - createdAtMs;

  if (diffMs < 60_000) return "Just now";

  const minutes = Math.floor(diffMs / 60_000);
  if (minutes < 60) {
    return `${minutes} min ago`;
  }

  const hours = Math.floor(minutes / 60);
  if (hours < 24) {
    return `${hours} hr ago`;
  }

  const days = Math.floor(hours / 24);
  return `${days} day${days === 1 ? "" : "s"} ago`;
}

const addAutomationHistoryEntry = (label: string) => {
  setAutomationHistory((prev) => {
    const next: AutomationHistoryEntry[] = [
      {
        id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
        label,
        createdAtMs: Date.now(),
      },
      ...prev,
    ];

    return next.slice(0, 8);
  });
};

const [showAllAutomationHistory, setShowAllAutomationHistory] = useState(false);

const collapsedAutomationHistoryCount = 2;

const visibleAutomationHistory = showAllAutomationHistory
  ? automationHistory
  : automationHistory.slice(0, collapsedAutomationHistoryCount);

const hiddenAutomationHistoryCount = Math.max(
  automationHistory.length - collapsedAutomationHistoryCount,
  0
);

const [pendingQuickLinkEventIds, setPendingQuickLinkEventIds] = useState<Set<string>>(
  new Set()
);

const [recentlyQuickLinkedEventIds, setRecentlyQuickLinkedEventIds] = useState<Set<string>>(
  new Set()
);

  function closeApplyActionMenu() {
  setApplyActionMenuTarget(null);
}

function dateKey(d: Date) {
    const dayOnly = new Date(d.getFullYear(), d.getMonth(), d.getDate());
    return dayKeyFromDate(dayOnly, tz); // "YYYY-MM-DD" in local tz
}

function getEventDayKeyFromApplyTarget(
  eventTarget: NonNullable<typeof applyEventTarget>
) {
  return dayKeyFromDate(new Date(eventTarget.startMs), getUserTz());
}

const completionKey = (goalId: string, subtaskId: string) => `${goalId}:${subtaskId}`;

const markQuickLinkSuccess = (eventId: string) => {
  setRecentlyQuickLinkedEventIds((prev) => {
    const next = new Set(prev);
    next.add(eventId);
    return next;
  });

  setTimeout(() => {
    setRecentlyQuickLinkedEventIds((prev) => {
      const next = new Set(prev);
      next.delete(eventId);
      return next;
    });
  }, 10000);
};


function getBaseSubtask(goalId: string, subtaskId: string) {
  return (subtasksByGoal[goalId] ?? []).find((subtask: any) => subtask.id === subtaskId) ?? null;
}

function applyLocalSubtaskPatch(
  goalId: string,
  subtaskId: string,
  patch: Record<string, any>
) {
  setSubtasksByGoal((prev) => {
    const goalSubtasks = prev[goalId] ?? [];

    return {
      ...prev,
      [goalId]: goalSubtasks.map((subtask) =>
        subtask.id === subtaskId
          ? { ...subtask, ...patch }
          : subtask
      ),
    };
  });
}

function getApplyCompletionBlockedReason(args: {
  isAlreadyCompletedForEventDay: boolean;
  isOnceSubtaskAlreadyCompleted: boolean;
  isLinkedToDifferentEvent: boolean;
}) {
  if (args.isLinkedToDifferentEvent) {
    return "This subtask is already linked to a different calendar event. Replace the link first if you want this event to drive it.";
  }

  if (args.isOnceSubtaskAlreadyCompleted) {
    return "This one-time subtask was already completed and cannot be completed again.";
  }

  if (args.isAlreadyCompletedForEventDay) {
    return "This subtask is already completed for the event day.";
  }

  return null;
}

function getApplyDurationBlockedReason(args: {
  isAlreadyCompletedForEventDay: boolean;
  isOnceSubtaskAlreadyCompleted: boolean;
  isLinkedToDifferentEvent: boolean;
}) {
  if (args.isAlreadyCompletedForEventDay) {
    return "This subtask is already completed for the event day.";
  }

  if (args.isOnceSubtaskAlreadyCompleted) {
    return "This one-time subtask is already completed.";
  }

  if (args.isLinkedToDifferentEvent) {
    return "This subtask is already linked to a different calendar event.";
  }

  return null;
}

function resetApplyFlow() {
  setApplyActionMenuTarget(null);
  setApplyEventTarget(null);
  setApplyStep("goal");
  setSelectedGoalForApply(null);
  setApplyOpenedViaQuickSuggestion(false);
}

const weekDates = useMemo(() => {
  const start = startOfWeekSunday(selectedDate);
  return Array.from({ length: 7 }).map((_, i) => addDays(start, i));
}, [selectedDate]);

const weekSummary = useMemo(() => {
  if (mode !== "week") return { count: 0, metricSum: 0 };

  let count = 0;
  let metricSum = 0;

  for (const d of weekDates) {
    const dk = dateKey(d);
    const agg = heatByDayKey[dk];
    const goalCount = goalCompletionCountsByDay[dk] ?? 0;

    count += (agg?.count ?? 0) + goalCount;
    metricSum += agg?.metricSum ?? 0;
  }

  return { count, metricSum };
}, [mode, weekDates, heatByDayKey, goalCompletionCountsByDay]);

const monthSummary = useMemo(() => {
  if (mode !== "month") return { count: 0, metricSum: 0 };

  let count = 0;
  let metricSum = 0;

  const start = startOfMonth(selectedDate);
  const totalDays = daysInMonth(selectedDate);

  for (let i = 0; i < totalDays; i++) {
    const d = addDays(start, i);
    const dk = dateKey(d);
    const agg = heatByDayKey[dk];
    const goalCount = goalCompletionCountsByDay[dk] ?? 0;

    count += (agg?.count ?? 0) + goalCount;
    metricSum += agg?.metricSum ?? 0;
  }

  return { count, metricSum };
}, [mode, selectedDate, heatByDayKey, goalCompletionCountsByDay]);



const selectedDaySummary = useMemo(() => {
  const subtaskAgg = heatByDayKey[selectedDayKey];
  const subtaskCount = subtaskAgg?.count ?? 0;
  const metricSum = subtaskAgg?.metricSum ?? 0;
  const goalCount = goalCompletionCountsByDay[selectedDayKey] ?? 0;
  const totalCount = subtaskCount + goalCount;

  const parts: string[] = [];

  if (goalCount > 0) {
    parts.push(`${goalCount} goal${goalCount === 1 ? "" : "s"} completed`);
  }

  if (subtaskCount > 0) {
    parts.push(`${subtaskCount} subtask${subtaskCount === 1 ? "" : "s"} completed`);
  }

  if (parts.length === 0) {
    parts.push("No completions yet");
  }

  if (metricSum > 0) {
    parts.push(`${metricSum} metric`);
  }

  return {
    totalCount,
    subtaskCount,
    goalCount,
    metricSum,
    label: parts.join(" • "),
  };
}, [heatByDayKey, goalCompletionCountsByDay, selectedDayKey]);

const allCompletionDayKeys = useMemo(() => {
  const keys = new Set<string>();

  for (const dayKey of Object.keys(heatByDayKey)) {
    if ((heatByDayKey[dayKey]?.count ?? 0) > 0) {
      keys.add(dayKey);
    }
  }

  for (const dayKey of Object.keys(goalCompletionCountsByDay)) {
    if ((goalCompletionCountsByDay[dayKey] ?? 0) > 0) {
      keys.add(dayKey);
    }
  }

  return Array.from(keys).sort();
}, [heatByDayKey, goalCompletionCountsByDay]);

const currentStreak = useMemo(() => {
  return calculateCompletionStreak(allCompletionDayKeys, selectedDayKey);
}, [allCompletionDayKeys, selectedDayKey]);

useEffect(() => {
  if (!authReady || !user) return;

  const uid = auth.currentUser?.uid;
  if (!uid) return;

  let startDayKey: string;
  let endDayKey: string;

  if (mode === "month") {
    const r = monthRangeDayKeys(selectedDate, tz);
    startDayKey = r.startDayKey;
    endDayKey = r.endDayKey;
  } else if (mode === "week") {
    const r = weekRangeDayKeys(weekDates, tz);
    startDayKey = r.startDayKey;
    endDayKey = r.endDayKey;
  } else {
    startDayKey = selectedDayKey;
    endDayKey = selectedDayKey;
  }

  setHeatLoading(true);

  const qy = query(
    collectionGroup(db, "completions"),
    where("userId", "==", uid),
    where("dayKey", ">=", startDayKey),
    where("dayKey", "<=", endDayKey),
    orderBy("dayKey")
  );

  const unsub = onSnapshot(
    qy,
    (snap) => {
      const heat = buildHeatmapFromCompletionSnapshot(snap, activeGoalIds);
      setHeatByDayKey(heat);
      setHeatLoading(false);
    },
    (err) => {
      console.error("live heat subscription failed", err);
      setHeatLoading(false);
    }
  );

  return () => unsub();
}, [authReady, user, mode, selectedDayKey, selectedDate, weekDates, tz, activeGoalIds]);

useEffect(() => {
  if (!authReady || !user) return;

  const uid = auth.currentUser?.uid;
  if (!uid) return;

  let startDayKey: string;
  let endDayKey: string;

  if (mode === "month") {
    const r = monthRangeDayKeys(selectedDate, tz);
    startDayKey = r.startDayKey;
    endDayKey = r.endDayKey;
  } else if (mode === "week") {
    const r = weekRangeDayKeys(weekDates, tz);
    startDayKey = r.startDayKey;
    endDayKey = r.endDayKey;
  } else {
    startDayKey = selectedDayKey;
    endDayKey = selectedDayKey;
  }

  const unsub = subscribeGoalCompletionsForRange(
    uid,
    startDayKey,
    endDayKey,
    (rows) => {
      const next: Record<string, number> = {};

      for (const row of rows) {
        const dk = row.dayKey;
        next[dk] = (next[dk] ?? 0) + 1;
      }

      setGoalCompletionCountsByDay(next);
    },
    (err) => {
      console.error("goal completion range subscription failed", err);
    }
  );

  return () => unsub();
}, [authReady, user, mode, selectedDate, selectedDayKey, weekDates, tz]);



useEffect(() => {
  if (!authReady || !user) return;
  if (mode !== "week") return;
  if (weekDates.length !== 7) return;

  let cancelled = false;

  async function loadWeek() {
    const uid = auth.currentUser?.uid;
    if (!uid) return;

    const map = new Map<string, Set<string>>();

    const startKey = dateKey(weekDates[0]);
    const endKey = dateKey(weekDates[6]);

    const qy = query(
      collectionGroup(db, "completions"),
      where("userId", "==", uid),
      where("dayKey", ">=", startKey),
      where("dayKey", "<=", endKey),
      orderBy("dayKey")
    );

    const snap = await getDocs(qy);

    snap.forEach((docSnap) => {
      const data: any = docSnap.data();
      if (!data?.dayKey || !data?.subtaskId || !data?.goalId) return;
      if (!activeGoalIds.has(data.goalId)) return;

      if (!map.has(data.dayKey)) map.set(data.dayKey, new Set());
      map.get(data.dayKey)!.add(completionKey(data.goalId, data.subtaskId));
    });

    if (!cancelled) {
  setCompletedByDayKey((prev) => {
    const next = new Map(prev);

    for (const [dayKey, setForDay] of map.entries()) {
      next.set(dayKey, setForDay);
    }

    return next;
  });
}
  }

  loadWeek().catch((e) => console.error("load week completions failed", e));

  return () => {
    cancelled = true;
  };
}, [authReady, user, mode, weekDates, activeGoalIds]);

  useEffect(() => {
    const unsub = onAuthStateChanged(auth, (u) => {
      setUser(u);
      setAuthReady(true);
    });
    return () => unsub();
  }, []);

