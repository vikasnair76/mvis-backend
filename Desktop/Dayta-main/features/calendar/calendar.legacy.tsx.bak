});

const isQuickLinkPending = pendingQuickLinkEventIds.has(event.id);

const isRecentlyQuickLinked = recentlyQuickLinkedEventIds.has(event.id);

      const openEvent = async () => {
        if (!event.htmlLink) return;

        try {
          await Linking.openURL(event.htmlLink);
        } catch (e) {
          console.error("open google calendar event failed", e);
        }
      };

      return (
        <Pressable
          key={event.id}
          onPress={event.htmlLink ? openEvent : undefined}
          style={[styles.card, styles.googleEventCard]}
        >
          <Text style={styles.goalTitle}>{event.title}</Text>

          <Text style={styles.rowMeta}>
            {timeLabel}
            {event.location ? ` • ${event.location}` : ""}
