function rangesOverlap(
  startA: number,
  endA: number,
  startB: number,
  endB: number
) {
  return startA < endB && startB < endA;
}

function getEventRangeForDay(event: GoogleCalendarEvent, date: Date) {
  const { start, end } = dayRangeMs(date);

  if (event.allDay) {
    return { startMs: start, endMs: end };
  }

  const startMs = event.startMs;
  const endMs = event.endMs ?? event.startMs + 60 * 60 * 1000;

  return { startMs, endMs };
}

function doesItemOverlapEventOnDate(
  item: CalendarItem & { date: Date },
  event: GoogleCalendarEvent
) {
  // All-day Google events block the whole date.
  if (event.allDay) return true;

  // If the task has a concrete due time, compare it to the event range.
  if (typeof item.dueAtMs === "number") {
    const { startMs, endMs } = getEventRangeForDay(event, item.date);

    // Treat the due item as a 30-minute task block centered on the due time.
    const itemStart = item.dueAtMs - 15 * 60 * 1000;
    const itemEnd = item.dueAtMs + 15 * 60 * 1000;

    return rangesOverlap(itemStart, itemEnd, startMs, endMs);
  }

  // Untimed due items do not overlap timed events yet.
  return false;
}

function formatGoogleEventTime(event: GoogleCalendarEvent) {
  if (event.allDay) return "All day";

  return new Date(event.startMs).toLocaleTimeString([], {
    hour: "numeric",
    minute: "2-digit",
  });
}

function formatLinkedEventLabel(
  title?: string | null,
  startMs?: number | null,
  options?: {
    missing?: boolean;
  }
) {
  if (!title) {
    return options?.missing ? "Linked event is missing from Google Calendar" : null;
  }

  if (options?.missing) {
    if (typeof startMs !== "number") {
      return `Missing linked event: ${title}`;
    }

    const timeLabel = new Date(startMs).toLocaleTimeString([], {
      hour: "numeric",
      minute: "2-digit",
    });

    return `Missing linked event: ${title} • ${timeLabel}`;
  }

  if (typeof startMs !== "number") {
    return `Linked event: ${title}`;
  }

  const timeLabel = new Date(startMs).toLocaleTimeString([], {
    hour: "numeric",
    minute: "2-digit",
  });

  return `Linked event: ${title} • ${timeLabel}`;
}

function getLinkedEventUnlinkLabel(args: {
  linkedEventActionPending: boolean;
  linkedEventMissing: boolean;
}) {
  if (args.linkedEventActionPending) return "Updating...";
  return args.linkedEventMissing ? "Unlink missing event" : "Unlink event";
}

function shouldShowUseLinkedEventTimeAction(args: {
  shouldShowLinkedEvent: boolean;
  linkedEventMissing: boolean;
  linkedEventTimeMismatched: boolean;
  latestLinkedEventHistory?: {
    decision?: string | null;
    reason?: string | null;
  } | null;
}) {
  const alreadyFollowingFromLatestHistory =
    args.latestLinkedEventHistory?.decision === "auto_propagate" &&
    args.latestLinkedEventHistory?.reason === "still_following_old_event_time";

  return (
    args.shouldShowLinkedEvent &&
    !args.linkedEventMissing &&
    args.linkedEventTimeMismatched &&
    !alreadyFollowingFromLatestHistory
  );
}

function getLinkedEventStartMsFromSubtask(subtask: any) {
  return typeof subtask?.linkedCalendarEventStartMs === "number"
    ? subtask.linkedCalendarEventStartMs
    : null;
}

function getNormalizedLinkedEventSnapshot(subtask: any) {
  const eventTitle =
    typeof subtask?.linkedCalendarEventTitle === "string" &&
    subtask.linkedCalendarEventTitle.trim().length > 0
      ? subtask.linkedCalendarEventTitle.trim()
      : null;

  const eventStartMs =
    typeof subtask?.linkedCalendarEventStartMs === "number"
      ? subtask.linkedCalendarEventStartMs
      : null;

  const eventEndMs =
    typeof subtask?.linkedCalendarEventEndMs === "number"
      ? subtask.linkedCalendarEventEndMs
      : null;

  const eventUpdatedRaw =
    typeof subtask?.linkedCalendarEventUpdatedRaw === "string" &&
    subtask.linkedCalendarEventUpdatedRaw.trim().length > 0
      ? subtask.linkedCalendarEventUpdatedRaw.trim()
      : null;

  const lastHandledStartMs =
    typeof subtask?.linkedCalendarLastHandledStartMs === "number"
      ? subtask.linkedCalendarLastHandledStartMs
      : eventStartMs;

  const lastHandledEndMs =
    typeof subtask?.linkedCalendarLastHandledEndMs === "number"
      ? subtask.linkedCalendarLastHandledEndMs
      : eventEndMs;

  const lastHandledUpdatedRaw =
    typeof subtask?.linkedCalendarLastHandledUpdatedRaw === "string" &&
    subtask.linkedCalendarLastHandledUpdatedRaw.trim().length > 0
      ? subtask.linkedCalendarLastHandledUpdatedRaw.trim()
      : eventUpdatedRaw;

  const isLegacySnapshot =
    eventStartMs !== null &&
    (
      typeof subtask?.linkedCalendarLastHandledStartMs !== "number" ||
      (eventEndMs !== null &&
        typeof subtask?.linkedCalendarLastHandledEndMs !== "number") ||
      (eventUpdatedRaw !== null &&
        !(
          typeof subtask?.linkedCalendarLastHandledUpdatedRaw === "string" &&
          subtask.linkedCalendarLastHandledUpdatedRaw.trim().length > 0
        ))
    );

  return {
    eventTitle,
    eventStartMs,
    eventEndMs,
    eventUpdatedRaw,
    lastHandledStartMs,
    lastHandledEndMs,
    lastHandledUpdatedRaw,
    isLegacySnapshot,
  };
}

function buildLegacyLinkedSnapshotBackfillPatch(subtask: any) {
  const normalizedSnapshot = getNormalizedLinkedEventSnapshot(subtask);

  if (!normalizedSnapshot.isLegacySnapshot) {
    return null;
  }

  const patch: Record<string, any> = {};
  let hasAnyField = false;

  if (
    typeof subtask?.linkedCalendarLastHandledStartMs !== "number" &&
    normalizedSnapshot.lastHandledStartMs !== null
  ) {
    patch.linkedCalendarLastHandledStartMs =
      normalizedSnapshot.lastHandledStartMs;
    hasAnyField = true;
  }

  if (
    typeof subtask?.linkedCalendarLastHandledEndMs !== "number" &&
    normalizedSnapshot.lastHandledEndMs !== null
  ) {
    patch.linkedCalendarLastHandledEndMs =
      normalizedSnapshot.lastHandledEndMs;
    hasAnyField = true;
  }

  if (
    !(
      typeof subtask?.linkedCalendarLastHandledUpdatedRaw === "string" &&
      subtask.linkedCalendarLastHandledUpdatedRaw.trim().length > 0
    ) &&
    normalizedSnapshot.lastHandledUpdatedRaw !== null
  ) {
    patch.linkedCalendarLastHandledUpdatedRaw =
      normalizedSnapshot.lastHandledUpdatedRaw;
    hasAnyField = true;
  }

  if (!hasAnyField) {
    return null;
  }

  patch.linkedCalendarLastSyncedAtMs = Date.now();

  return patch;
}

type LinkedEventChangeDetection = {
  hasAnyChange: boolean;
  titleChanged: boolean;
  startChanged: boolean;
  endChanged: boolean;
  updatedChanged: boolean;
  usedLegacySnapshotFallback: boolean;

  previousHandledTitle: string | null;
  previousHandledStartMs: number | null;
  previousHandledEndMs: number | null;
  previousHandledUpdatedRaw: string | null;

  currentEventTitle: string | null;
  currentEventStartMs: number | null;
  currentEventEndMs: number | null;
  currentEventUpdatedRaw: string | null;
};

function detectLinkedEventChange(args: {
  subtask: any;
  currentEvent: GoogleCalendarEvent | null | undefined;
}): LinkedEventChangeDetection {
  const { subtask, currentEvent } = args;

    const normalizedSnapshot = getNormalizedLinkedEventSnapshot(subtask);

  const previousHandledTitle = normalizedSnapshot.eventTitle;
  const previousHandledStartMs = normalizedSnapshot.lastHandledStartMs;
  const previousHandledEndMs = normalizedSnapshot.lastHandledEndMs;
  const previousHandledUpdatedRaw = normalizedSnapshot.lastHandledUpdatedRaw;

  const currentEventTitle =
    typeof currentEvent?.title === "string" && currentEvent.title.trim().length > 0
      ? currentEvent.title.trim()
      : null;

  const currentEventStartMs =
    typeof currentEvent?.startMs === "number" ? currentEvent.startMs : null;

  const currentEventEndMs =
    typeof currentEvent?.endMs === "number" ? currentEvent.endMs : null;

  const currentEventUpdatedRaw =
    typeof currentEvent?.rawUpdated === "string" &&
    currentEvent.rawUpdated.trim().length > 0
      ? currentEvent.rawUpdated.trim()
      : null;

  const titleChanged = previousHandledTitle !== currentEventTitle;
  const startChanged = previousHandledStartMs !== currentEventStartMs;
  const endChanged = previousHandledEndMs !== currentEventEndMs;
  const updatedChanged = previousHandledUpdatedRaw !== currentEventUpdatedRaw;

if (normalizedSnapshot.isLegacySnapshot) {
  console.log("[Calendar] using legacy linked snapshot fallback", {
    goalId: subtask?.goalId ?? null,
    subtaskId: subtask?.id ?? null,
    linkedCalendarEventId:
      typeof subtask?.linkedCalendarEventId === "string"
        ? subtask.linkedCalendarEventId
        : null,
  });
}

  return {
    hasAnyChange:
      titleChanged || startChanged || endChanged || updatedChanged,

    titleChanged,
    startChanged,
    endChanged,
    updatedChanged,
    usedLegacySnapshotFallback: normalizedSnapshot.isLegacySnapshot,

    previousHandledTitle,
    previousHandledStartMs,
    previousHandledEndMs,
    previousHandledUpdatedRaw,

    currentEventTitle,
    currentEventStartMs,
    currentEventEndMs,
    currentEventUpdatedRaw,
  };
}

function isLinkedEventTimeShiftChange(detection: LinkedEventChangeDetection) {
  return detection.startChanged;
}

function formatLinkedEventPolicyDecisionLabel(
  decision?: string | null,
  reason?: string | null
) {
  // Explicit follow case
  if (decision === "auto_propagate") {
    return "Following event change";
  }

  // Preserve cases (metadata_only branch)
  if (decision === "metadata_only") {
    if (reason === "manual_schedule_change") {
      return "Keeping manual schedule";
    }

    if (reason === "still_following_old_event_time") {
      return "Still following previous event time";
    }

    if (reason === "skipped") {
      return "Skipped day preserved";
    }

    if (reason === "unscheduled") {
      return "Unscheduled day preserved";
    }

    if (reason === "missing_times") {
      return "Event timing unavailable";
    }

    return "Preserving task schedule";
  }

  // Fallback
  return "No change applied";
}

function formatControlledLinkedEventDecisionLabel(args: {
  shouldFollowEventChange: boolean;
  shouldPreserveManualSchedule: boolean;
  policyDecision?: string | null;
  policyReason?: string | null;
}) {
  const {
    shouldFollowEventChange,
    shouldPreserveManualSchedule,
    policyDecision,
    policyReason,
  } = args;

  if (shouldFollowEventChange) {
    return "Following event change";
  }

  if (shouldPreserveManualSchedule) {
    return formatLinkedEventPolicyDecisionLabel(
      policyDecision,
      policyReason
    );
  }

  return "No change applied";
}

function getLinkedEventCardDecisionLabel(latestHistory?: {
  decision?: string | null;
  reason?: string | null;
} | null) {
  if (!latestHistory) return null;

  return formatLinkedEventPolicyDecisionLabel(
    latestHistory.decision ?? null,
    latestHistory.reason ?? null
  );
}

function isLinkedEventMetadataOnlyChange(
  detection: LinkedEventChangeDetection
) {
  return (
    !detection.startChanged &&
    (detection.titleChanged ||
      detection.endChanged ||
      detection.updatedChanged)
  );
}

function getLinkedEventMetadataOnlyHistoryReason(
  detection: LinkedEventChangeDetection
) {
  if (detection.titleChanged && detection.endChanged) {
    return "metadata_only_title_and_end_change";
  }

  if (detection.titleChanged) {
    return "metadata_only_title_change";
  }

  if (detection.endChanged) {
    return "metadata_only_end_change";
  }

  return "metadata_only_refresh";
}

function formatLinkedEventHistoryReason(reason?: string | null) {
  switch (reason) {
    case "manual_schedule_change":
      return "Task kept its manually set time instead of following the event";
    case "still_following_old_event_time":
      return "Task is still aligned to the previous event time";
    case "skipped":
      return "Skipped day";
    case "unscheduled":
      return "Unscheduled day";
    case "missing_times":
      return "Missing event time";
    case "no_change":
      return "No change";

    case "metadata_only_title_change":
      return "Event title updated";
    case "metadata_only_end_change":
      return "Event end time updated";
    case "metadata_only_title_and_end_change":
      return "Event details updated";
    case "metadata_only_refresh":
      return "Event metadata refreshed";

      case "linked_event_missing":
  return "Linked event missing";
case "linked_event_returned":
  return "Linked event returned";

    default:
      return "Linked event change handled";
  }
}

function shouldAllowControlledAutoFollow(args: {
  isOneTime: boolean;
  decision?: string | null;
  reason?: string | null;
}) {
  const { isOneTime, decision, reason } = args;

  if (decision !== "auto_propagate") {
    return false;
  }

  if (!isOneTime) {
    return true;
  }

  return reason === "still_following_old_event_time";
}

function formatLinkedEventHistoryTimeShift(
  previousHandledStartMs?: number | null,
  nextEventStartMs?: number | null
) {
  if (
    typeof previousHandledStartMs !== "number" ||
    typeof nextEventStartMs !== "number"
  ) {
    return null;
  }

  if (previousHandledStartMs === nextEventStartMs) {
    return null;
  }

  const prevLabel = new Date(previousHandledStartMs).toLocaleTimeString([], {
    hour: "numeric",
    minute: "2-digit",
  });

  const nextLabel = new Date(nextEventStartMs).toLocaleTimeString([], {
    hour: "numeric",
    minute: "2-digit",
  });

  return `${prevLabel} → ${nextLabel}`;
}



function formatLinkedEventHistoryDetail(latestHistory?: {
  reason?: string | null;
  eventTitle?: string | null;
  oldOverrideSource?: string | null;
  oldOverrideDueAtMs?: number | null;
  previousHandledStartMs?: number | null;
  nextEventEndMs?: number | null;
} | null) {
  if (!latestHistory) return null;

  switch (latestHistory.reason) {
    case "metadata_only_title_change": {
      if (
        typeof latestHistory.eventTitle === "string" &&
        latestHistory.eventTitle.trim().length > 0
      ) {
        return `Now titled "${latestHistory.eventTitle.trim()}"`;
      }

      return "Event title changed in Google Calendar";
    }

    case "metadata_only_end_change": {
      if (typeof latestHistory.nextEventEndMs === "number") {
        return `New end time: ${new Date(
          latestHistory.nextEventEndMs
        ).toLocaleTimeString([], {
          hour: "numeric",
          minute: "2-digit",
        })}`;
      }

      return "Event end time changed in Google Calendar";
    }

    case "metadata_only_title_and_end_change": {
      const titlePart =
        typeof latestHistory.eventTitle === "string" &&
        latestHistory.eventTitle.trim().length > 0
          ? `Now titled "${latestHistory.eventTitle.trim()}"`
          : null;

      const endPart =
        typeof latestHistory.nextEventEndMs === "number"
          ? `Ends at ${new Date(latestHistory.nextEventEndMs).toLocaleTimeString(
              [],
              {
                hour: "numeric",
                minute: "2-digit",
              }
            )}`
          : null;

      if (titlePart && endPart) {
        return `${titlePart} • ${endPart}`;
      }

      return titlePart ?? endPart ?? "Event details changed in Google Calendar";
    }

        case "metadata_only_refresh":
      return "Google event metadata refreshed";

    case "linked_event_missing":
      return "This linked Google Calendar event is no longer available in synced data";

    case "linked_event_returned":
      return "This linked Google Calendar event is available again in synced data";

    case "manual_schedule_change": {
      if (
        typeof latestHistory.oldOverrideDueAtMs === "number" &&
        typeof latestHistory.previousHandledStartMs === "number"
      ) {
        const dueLabel = new Date(
          latestHistory.oldOverrideDueAtMs
        ).toLocaleTimeString([], {
          hour: "numeric",
          minute: "2-digit",
        });

        const eventLabel = new Date(
          latestHistory.previousHandledStartMs
        ).toLocaleTimeString([], {
          hour: "numeric",
          minute: "2-digit",
        });

        const sourceSuffix =
          typeof latestHistory.oldOverrideSource === "string" &&
          latestHistory.oldOverrideSource.trim().length > 0
            ? ` via ${latestHistory.oldOverrideSource}`
            : "";

        return `Task stayed at ${dueLabel} instead of following ${eventLabel}${sourceSuffix}`;
      }

      return "Your task schedule was kept instead of auto-following the event";
    }

    case "still_following_old_event_time":
      return "Task was still aligned to the previous event time";

    case "skipped":
      return "This day was skipped, so no time update was applied";

    case "unscheduled":
      return "This task was unscheduled for the day, so no time update was applied";

    case "missing_times":
      return "Google event did not have usable timing data";

    default:
      return null;
  }
}

function shouldShowLinkedEventForItem(
  item: CalendarItem & { date: Date }
) {
  if (!item.linkedCalendarEventId) return false;

  const linkedStartMs =
    typeof item.linkedCalendarEventStartMs === "number"
      ? item.linkedCalendarEventStartMs
      : null;

  if (linkedStartMs == null) return true;

  const isOneTime =
    item.frequency === "once";

  if (isOneTime) return true;

  return sameDay(item.date, new Date(linkedStartMs));
}

function isLinkedEventTimeMismatched(
  item: {
    linkedCalendarEventId?: string | null;
    dueAtMs?: number | null;
  },
  googleEventById: Map<string, GoogleCalendarEvent>
) {
  const linkedEventId =
    typeof item.linkedCalendarEventId === "string"
      ? item.linkedCalendarEventId.trim()
      : "";

  if (!linkedEventId) return false;

  const linkedEvent = googleEventById.get(linkedEventId);
  if (!linkedEvent) return false;

  const dueAtMs =
    typeof item.dueAtMs === "number" ? item.dueAtMs : null;

  const linkedStartMs =
    typeof linkedEvent.startMs === "number" ? linkedEvent.startMs : null;

  if (dueAtMs == null || linkedStartMs == null) return false;

  return dueAtMs !== linkedStartMs;
}

function getApplySubtaskMetaLabel(subtask: any) {
  const scheduleLabel =
    subtask?.scheduleType === "oneTime" || subtask?.frequency === "once"
      ? "One-time"
      : subtask?.frequency === "daily"
      ? "Daily"
      : subtask?.frequency === "weekly"
      ? "Weekly"
      : "Custom";

  const hasLinkedEvent =
    typeof subtask?.linkedCalendarEventId === "string" &&
    subtask.linkedCalendarEventId.trim().length > 0;

  if (hasLinkedEvent) {
  const linkedTitle =
    typeof subtask?.linkedCalendarEventTitle === "string" &&
    subtask.linkedCalendarEventTitle.trim().length > 0
      ? subtask.linkedCalendarEventTitle.trim()
      : "Linked event";

  const isOneTime =
    subtask?.scheduleType === "oneTime" || subtask?.frequency === "once";

  return isOneTime
    ? `${scheduleLabel} • Already linked to ${linkedTitle}`
    : `${scheduleLabel} • Previously linked to ${linkedTitle}`;
}

  return scheduleLabel;
}

function hasLinkedCalendarEvent(subtask: any) {
  return (
    typeof subtask?.linkedCalendarEventId === "string" &&
    subtask.linkedCalendarEventId.trim().length > 0
  );
}

function isLinkedEventMissing(
  item: Pick<
    CalendarItem,
    "linkedCalendarEventId"
  > & {
    linkedCalendarLastKnownMissing?: boolean | null;
  },
  googleEventById: Map<string, GoogleCalendarEvent>
) {
  if (!item.linkedCalendarEventId) return false;

  if (item.linkedCalendarLastKnownMissing === true) {
    return true;
  }

  return !googleEventById.has(item.linkedCalendarEventId);
}

function shouldIgnoreConflictForLinkedEvent(
  item: {
    linkedCalendarEventId?: string | null;
  },
  event: {
    id: string;
  },
  googleEventById: Map<string, GoogleCalendarEvent>
) {
  const linkedEventId =
    typeof item.linkedCalendarEventId === "string"
      ? item.linkedCalendarEventId.trim()
      : "";

  if (!linkedEventId) return false;

  const linkedEventStillExists = googleEventById.has(linkedEventId);
  if (!linkedEventStillExists) return false;

  return linkedEventId === event.id;
}

function getOverlapSummaryLabel(
  item: CalendarItem & { date: Date },
  overlappingEvents: GoogleCalendarEvent[]
) {
  const count = overlappingEvents.length;
  const noun = `Google event${count === 1 ? "" : "s"}`;

  if (typeof item.dueAtMs === "number") {
    return `Conflicts with ${count} ${noun}`;
  }

  return `Blocked by ${count} ${noun}`;
}

function getOverlapEventLabel(
  item: CalendarItem & { date: Date },
  event: GoogleCalendarEvent
) {
  if (typeof item.dueAtMs !== "number" && event.allDay) {
    return `All day block • ${event.title}`;
  }

  return `${formatGoogleEventTime(event)} • ${event.title}`;
}

function formatTimeRangeLabel(startMs: number, endMs: number) {
  const startLabel = new Date(startMs).toLocaleTimeString([], {
    hour: "numeric",
    minute: "2-digit",
  });

 

  const endLabel = new Date(endMs).toLocaleTimeString([], {
    hour: "numeric",
    minute: "2-digit",
  });

  return `${startLabel} - ${endLabel}`;
}
 function formatTaskDueLabel(dueAtMs?: number | null) {
  if (typeof dueAtMs !== "number") return null;

  const d = new Date(dueAtMs);
  return d.toLocaleTimeString([], {
    hour: "numeric",
    minute: "2-digit",
  });
}

function findFirstAvailableSlotOnDate(
  date: Date,
  events: GoogleCalendarEvent[],
  minMinutes: number = 30
) {
  const dayStart = new Date(
    date.getFullYear(),
    date.getMonth(),
    date.getDate(),
    8,
    0,
    0,
    0
  ).getTime();

  const dayEnd = new Date(
    date.getFullYear(),
    date.getMonth(),
    date.getDate(),
    20,
    0,
    0,
    0
  ).getTime();

  const minMs = minMinutes * 60 * 1000;

  const timedRanges = events
    .filter((event) => !event.allDay)
    .map((event) => {
      const startMs = Math.max(event.startMs, dayStart);
      const endMs = Math.min(
        event.endMs ?? event.startMs + 60 * 60 * 1000,
        dayEnd
      );

      return { startMs, endMs };
    })
    .filter((r) => r.endMs > r.startMs)
    .sort((a, b) => a.startMs - b.startMs);

  if (timedRanges.length === 0) {
    return { startMs: dayStart, endMs: dayStart + minMs };
  }

  const merged: { startMs: number; endMs: number }[] = [];

  for (const range of timedRanges) {
    const last = merged[merged.length - 1];

    if (!last || range.startMs > last.endMs) {
      merged.push({ ...range });
    } else {
      last.endMs = Math.max(last.endMs, range.endMs);
    }
  }

  let cursor = dayStart;

  for (const range of merged) {
    if (range.startMs - cursor >= minMs) {
      return { startMs: cursor, endMs: cursor + minMs };
    }

    cursor = Math.max(cursor, range.endMs);
  }

  if (dayEnd - cursor >= minMs) {
    return { startMs: cursor, endMs: cursor + minMs };
  }

  return null;
}

function findFirstAvailableSlotOnDateNotBefore(
  date: Date,
  googleEvents: GoogleCalendarEvent[],
  slotMinutes: number,
  notBeforeMs: number | null
) {
  const slot = findFirstAvailableSlotOnDate(date, googleEvents, slotMinutes);

  if (!slot) return null;
  if (typeof notBeforeMs !== "number") return slot;

  const dayStart = dayStartMs(date);
  const dayEnd = dayStart + 24 * 60 * 60 * 1000;
  const slotDurationMs = slotMinutes * 60 * 1000;

  let cursor = Math.max(notBeforeMs, dayStart);

  const timedEvents = googleEvents
    .filter(
      (event) =>
        !event.allDay &&
        typeof event.startMs === "number" &&
        typeof event.endMs === "number"
    )
    .slice()
    .sort((a, b) => a.startMs - b.startMs);

  while (cursor + slotDurationMs <= dayEnd) {
    const candidateStart = cursor;
    const candidateEnd = candidateStart + slotDurationMs;

    const overlaps = timedEvents.some((event) => {
      const eventStart = event.startMs;
      const eventEnd =
        typeof event.endMs === "number" ? event.endMs : event.startMs;

      return eventStart < candidateEnd && eventEnd > candidateStart;
    });

    if (!overlaps) {
      return {
        startMs: candidateStart,
        endMs: candidateEnd,
      };
    }

    let nextCursor = candidateEnd;

    for (const event of timedEvents) {
      const eventStart = event.startMs;
      const eventEnd =
        typeof event.endMs === "number" ? event.endMs : event.startMs;

      if (eventStart < candidateEnd && eventEnd > candidateStart) {
        nextCursor = Math.max(nextCursor, eventEnd);
      }
    }

    cursor = nextCursor;
  }

  return null;
}

function getRecoverySuggestionNotBeforeMs(args: {
  itemDate: Date;
  dueAtMs?: number | null;
}) {
  const now = Date.now();
  const isToday = sameDay(args.itemDate, new Date());

  if (!isToday) {
    return null;
  }

  if (typeof args.dueAtMs === "number") {
    return Math.max(now, args.dueAtMs);
  }

  return now;
}

function shouldShowNoMoreOpeningsToday(args: {
  date: Date;
  suggestedSlot: { startMs: number; endMs: number } | null;
}) {
  const isToday = sameDay(args.date, new Date());

  return isToday && !args.suggestedSlot;
}

function findFirstAvailableSlotAfterTimeOnDate(
  date: Date,
  events: GoogleCalendarEvent[],
  targetStartMs: number,
  minMinutes: number = 30
) {
  const dayStart = new Date(
    date.getFullYear(),
    date.getMonth(),
    date.getDate(),
    8,
    0,
    0,
    0
  ).getTime();

  const dayEnd = new Date(
    date.getFullYear(),
    date.getMonth(),
    date.getDate(),
    20,
    0,
    0,
    0
  ).getTime();

  const minMs = minMinutes * 60 * 1000;

  const timedRanges = events
    .filter((event) => !event.allDay)
    .map((event) => {
      const startMs = Math.max(event.startMs, dayStart);
      const endMs = Math.min(
        event.endMs ?? event.startMs + 60 * 60 * 1000,
        dayEnd
      );

      return { startMs, endMs };
    })
    .filter((r) => r.endMs > r.startMs)
    .sort((a, b) => a.startMs - b.startMs);

  const merged: { startMs: number; endMs: number }[] = [];

  for (const range of timedRanges) {
    const last = merged[merged.length - 1];

    if (!last || range.startMs > last.endMs) {
      merged.push({ ...range });
    } else {
      last.endMs = Math.max(last.endMs, range.endMs);
    }
  }

  let cursor = Math.max(dayStart, targetStartMs);

  for (const range of merged) {
    if (range.endMs <= cursor) continue;

    if (range.startMs - cursor >= minMs) {
      return { startMs: cursor, endMs: cursor + minMs };
    }

    if (range.startMs <= cursor && range.endMs > cursor) {
      cursor = range.endMs;
    }
  }

  if (dayEnd - cursor >= minMs) {
    return { startMs: cursor, endMs: cursor + minMs };
  }

  return null;
}

function isTimedCalendarItem(item: CalendarItem & { date: Date }) {
  return typeof item.dueAtMs === "number";
}

function isSuggestedTimeDifferent(
  item: CalendarItem & { date: Date },
  suggestedSlot: { startMs: number; endMs: number } | null
) {
  if (typeof item.dueAtMs !== "number" || !suggestedSlot) return false;
  return item.dueAtMs !== suggestedSlot.startMs;
}

function getNoSlotLabel(
  slotMinutes: number,
  options?: { noMoreToday?: boolean }
) {
  if (options?.noMoreToday) {
    return "No more openings today";
  }

  return `No ${slotMinutes}-minute opening available`;
}

function getSuggestedSlotLabel(startMs: number, endMs: number) {
  return `Earliest opening today: ${formatTimeRangeLabel(startMs, endMs)}`;
}

function getRecoverySlotLabel(startMs: number, endMs: number) {
  return `Next opening today: ${formatTimeRangeLabel(startMs, endMs)}`;
}

function getScheduleOverrideBadgeLabel(
  source?: "suggestedTime" | "snooze" | "skip" | "unscheduled" | null
) {
  if (source === "snooze") return "Snoozed";
  if (source === "suggestedTime") return "Rescheduled";
  if (source === "skip") return "Skipped";
  if (source === "unscheduled") return "Unscheduled";
  return "Adjusted";
}

function getRecoveryTypeLabel(type: "conflict" | "unscheduled") {
  return type === "conflict" ? "Conflict" : "Unscheduled";
}

function getTomorrowMorningMs(fromDate: Date) {
  return new Date(
    fromDate.getFullYear(),
    fromDate.getMonth(),
    fromDate.getDate() + 1,
    DEFAULT_TOMORROW_MORNING_HOUR,
    0,
    0,
    0
  ).getTime();
}

