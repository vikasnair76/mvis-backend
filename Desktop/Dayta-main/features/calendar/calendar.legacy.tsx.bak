    }
  }

  out.sort((a, b) => a.title.localeCompare(b.title));
  return out;
}, [visibleGoals, subtasksByGoal, scheduleOverridesByKey, selectedDayKey, selectedDate]);

const selectedDayTrueUnscheduledOneTimeItems = useMemo(() => {
  const out: DatedItem[] = [];

  for (const g of visibleGoals) {
