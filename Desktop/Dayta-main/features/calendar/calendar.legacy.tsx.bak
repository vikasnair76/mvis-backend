          subtaskTitle: s.title,
          mode: "linked",
          existingLinkedTitle,
          nextEventTitle,
        });
      }}
      style={[
  styles.applyGoalOption,
  isSuggestedApplySubtask && styles.applyActionSheetOptionSuggested,
  //isPossibleApplyMatchSubtask && styles.applyActionSheetOptionPossible,
  applyActionPending && styles.applyGoalOptionDisabled,
]}
    >
      <>
        <Text style={styles.applyGoalOptionText}>{s.title}</Text>

<View style={styles.ruleBadgeRow}>
  {isSuggestedApplySubtask && (
    <Text style={styles.applyActionSheetSuggestedBadge}>
      {applySavedRuleSuggestion ? "Saved preference" : "Suggested"}
    </Text>
  )}

  {hasAutoLinkEnabled && (
    <View style={styles.autoLinkBadge}>
      <Text style={styles.autoLinkBadgeText}>⚡ Auto-link enabled</Text>
    </View>
  )}

  {hasAutoApplyEnabled && (
    <View style={styles.autoApplyBadge}>
      <Text style={styles.autoApplyBadgeText}>⏱ Auto-apply enabled</Text>
    </View>
  )}
</View>

        

        <Text style={styles.applySubtaskMetaText}>
