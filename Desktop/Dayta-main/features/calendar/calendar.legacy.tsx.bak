function getAutoApplyDurationRuleMatchForEvent(args: {
  eventTitle: string;
  items: Array<CalendarItem & { date: Date }>;
  calendarRules: CalendarRuleRecord[];
}) {
  if (!args.eventTitle) return null;
  if (args.items.length === 0) return null;

  let best: {
    goalId: string;
    subtaskId: string;
    subtaskTitle: string;
    boost: number;
  } | null = null;

for (const item of args.items) {
  const matchingRules = args.calendarRules.filter(
    (rule) =>
      rule.type === "auto_apply_duration" &&
      rule.goalId === item.goalId &&
      rule.subtaskId === item.subtaskId
  );20

  const itemMetricUnit =
    typeof item.metricUnit === "string" ? item.metricUnit.trim() : "";

  const isDurationCapable =
    !!item.contributesToMetric && itemMetricUnit.length > 0;

  console.log("[Calendar] auto-apply duration matcher inspect", {
    eventTitle: args.eventTitle,
    goalId: item.goalId,
    subtaskId: item.subtaskId,
    title: item.title,
    contributesToMetric: item.contributesToMetric ?? null,
    metricUnit: item.metricUnit ?? null,
    matchingRuleCount: matchingRules.length,
    isDurationCapable,
  });

  if (!isDurationCapable) continue;
  if (matchingRules.length === 0) continue;

  const boost = matchingRules.reduce((bestBoost, rule) => {
    const next = getSuggestSubtaskRuleBoost({
      eventTitle: args.eventTitle,
      ruleMatchText: rule.matchText,
    });
    return next > bestBoost ? next : bestBoost;
  }, 0);

  if (boost <= 0) continue;

  if (!best || boost > best.boost) {
    best = {
      goalId: item.goalId,
      subtaskId: item.subtaskId,
      subtaskTitle: item.title ?? "Subtask",
      boost,
    };
  }
}

  return best;
}

function hasSavedPreferenceForEvent(args: {
  eventTitle: string;
  calendarRules: CalendarRuleRecord[];
}) {
  return args.calendarRules.some((rule) => {
    if (rule.type !== "suggest_subtask") return false;

    return (
      getSuggestSubtaskRuleBoost({
        eventTitle: args.eventTitle,
        ruleMatchText: rule.matchText,
      }) > 0
    );
  });
}

function splitDueCompleted<T>(
  items: T[],
  isCompleted: (item: T) => boolean
) {
  const due: T[] = [];
  const completed: T[] = [];

  for (const it of items) {
    if (isCompleted(it)) completed.push(it);
    else due.push(it);
  }

  return { due, completed };
}



function formatRelativeSyncTime(lastSyncAtMs?: number | null) {
  if (!lastSyncAtMs) return "Never synced yet";

  const diffMs = Date.now() - lastSyncAtMs;

  if (diffMs < 60 * 1000) return "Last synced just now";

  const diffMin = Math.floor(diffMs / (60 * 1000));
  if (diffMin < 60) {
    return `Last synced ${diffMin} min ago`;
  }

  const diffHr = Math.floor(diffMin / 60);
  if (diffHr < 24) {
    return `Last synced ${diffHr} hr ago`;
  }

  const diffDay = Math.floor(diffHr / 24);
  return `Last synced ${diffDay} day${diffDay === 1 ? "" : "s"} ago`;
}

function confirmAction(title: string, message: string): Promise<boolean> {
  if (Platform.OS === "web") {
    return Promise.resolve(window.confirm(`${title}\n\n${message}`));
  }

  return new Promise((resolve) => {
    Alert.alert(title, message, [
      { text: "Cancel", style: "cancel", onPress: () => resolve(false) },
      { text: "OK", onPress: () => resolve(true) },
    ]);
  });
}

function withDayAndTime(baseDate: Date, timeMs: number) {
  const t = new Date(timeMs);

  return new Date(
    baseDate.getFullYear(),
    baseDate.getMonth(),
    baseDate.getDate(),
    t.getHours(),
    t.getMinutes(),
    t.getSeconds(),
    t.getMilliseconds()
  ).getTime();
}

function getLinkedEventActionKey(item: {
  goalId: string;
  subtaskId: string;
  date: Date;
}) {
  return `${item.goalId}:${item.subtaskId}:${dayKeyFromDate(item.date, getUserTz())}`;
}

function isMetricCapableSubtask(subtask: any) {
  return subtask?.contributesToMetric === true;
}

function getEventDurationMinutes(event: {
  startMs: number;
  endMs: number | null;
}) {
  if (
    typeof event?.startMs !== "number" ||
    !Number.isFinite(event.startMs) ||
    typeof event?.endMs !== "number" ||
    !Number.isFinite(event.endMs)
  ) {
    return null;
  }

  if (event.endMs <= event.startMs) return null;

  const minutes = Math.round((event.endMs - event.startMs) / 60000);

  if (!Number.isFinite(minutes) || minutes <= 0) return null;

  return minutes;
}

function convertEventDurationToMetricValue(
  subtask: any,
  event: { startMs: number; endMs: number | null }
) {
  if (!isTimeBasedMetricSubtask(subtask)) return null;

  const durationMinutes = getEventDurationMinutes(event);
  if (durationMinutes == null) return null;

  const unitKind = getTimeMetricUnitKind(subtask?.metricUnit);

  if (unitKind === "hours") {
    return Math.round((durationMinutes / 60) * 100) / 100;
  }

  if (unitKind === "minutes") {
    return durationMinutes;
  }

  return null;
}

function normalizeMetricUnit(unit: unknown) {
  if (typeof unit !== "string") return "";
  return unit.trim().toLowerCase();
}

function getTimeMetricUnitKind(unit: unknown): "hours" | "minutes" | null {
  const normalized = normalizeMetricUnit(unit);

  if (
    normalized === "hour" ||
    normalized === "hours" ||
    normalized === "hr" ||
    normalized === "hrs"
  ) {
    return "hours";
  }

  if (
    normalized === "minute" ||
    normalized === "minutes" ||
    normalized === "min" ||
    normalized === "mins"
  ) {
    return "minutes";
  }

  return null;
}

function isTimeBasedMetricSubtask(subtask: any) {
  if (subtask?.contributesToMetric !== true) return false;
  return getTimeMetricUnitKind(subtask?.metricUnit) != null;
}

function formatMetricValueLabel(value: number) {
  return Number.isInteger(value) ? String(value) : value.toFixed(2).replace(/\.?0+$/, "");
}

function getDurationApplyLabel(metricValue: number, subtask: any) {
  const unitKind = getTimeMetricUnitKind(subtask?.metricUnit);

  if (unitKind === "hours") {
    return `Apply event duration (${formatMetricValueLabel(metricValue)} hr)`;
  }

  if (unitKind === "minutes") {
    return `Apply event duration (${formatMetricValueLabel(metricValue)} min)`;
  }

  return "Apply event duration";
}

function getUseLinkedEventTimeLabel(linkedEventActionPending: boolean) {
  return linkedEventActionPending ? "Updating..." : "Use linked event time";
}

function getLinkedEventMissingNoticeText(args: {
  variant: "due" | "unscheduled" | "completed";
  missingAtMs?: number | null;
}) {
  const missingSinceLabel =
    typeof args.missingAtMs === "number"
      ? ` Missing since ${new Date(args.missingAtMs).toLocaleString([], {
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit",
        })}.`
      : "";

  if (args.variant === "completed") {
    return `This linked event is no longer in your synced Google Calendar data.${missingSinceLabel} You can keep the completed task as-is or unlink the missing event.`;
  }

  return `This linked event is no longer in your synced Google Calendar data.${missingSinceLabel} You can keep the task as-is or unlink the missing event.`;
}

function getLinkedEventMismatchText() {
  return "Linked event time differs from task time";
}

function getApplyPanelTitle(applyStep: "goal" | "subtask") {
  return applyStep === "goal" ? "Apply event to goal" : "Choose a subtask";
}

function getApplyPanelHint(applyStep: "goal" | "subtask") {
  return applyStep === "goal"
    ? "Select a goal to continue."
    : "Choose a subtask, then select how to apply this event.";
}



function addPendingLinkedEventActionKey(
  key: string,
  setState: React.Dispatch<React.SetStateAction<Set<string>>>
) {
  setState((prev) => {
    const next = new Set(prev);
    next.add(key);
    return next;
  });
}

function removePendingLinkedEventActionKey(
  key: string,
  setState: React.Dispatch<React.SetStateAction<Set<string>>>
) {
  setState((prev) => {
    const next = new Set(prev);
    next.delete(key);
    return next;
  });
}

function hasSavedSuggestPreference(args: {
  eventTitle: string;
  goalId: string;
  subtaskId: string;
  calendarRules: Array<{
    type: string;
    matchText?: string | null;
    goalId?: string | null;
    subtaskId?: string | null;
  }>;
}) {
  const normalizedTitle = normalizeCalendarRuleMatchText(args.eventTitle);
  if (!normalizedTitle) return false;

  return args.calendarRules.some(
    (rule) =>
      rule.type === "suggest_subtask" &&
      rule.matchText === normalizedTitle &&
      rule.goalId === args.goalId &&
      rule.subtaskId === args.subtaskId
  );
}



function hasAutoLinkRuleForEvent(args: {
  eventTitle: string;
  goalId: string;
  subtaskId: string;
  calendarRules: Array<{
    type: string;
    matchText?: string | null;
    goalId?: string | null;
    subtaskId?: string | null;
  }>;
}) {
  const normalizedTitle = normalizeCalendarRuleMatchText(args.eventTitle);
  if (!normalizedTitle) return false;

  return args.calendarRules.some(
    (rule) =>
      rule.type === "auto_link" &&
      rule.matchText === normalizedTitle &&
      rule.goalId === args.goalId &&
      rule.subtaskId === args.subtaskId
  );
}

function hasAutoApplyDurationRuleForEvent(args: {
  eventTitle: string;
  goalId: string;
  subtaskId: string;
  calendarRules: Array<{
    type: string;
    matchText?: string | null;
    goalId?: string | null;
    subtaskId?: string | null;
  }>;
}) {
  const normalizedTitle = normalizeCalendarRuleMatchText(args.eventTitle);
  if (!normalizedTitle) return false;

  return args.calendarRules.some(
    (rule) =>
      rule.type === "auto_apply_duration" &&
      rule.matchText === normalizedTitle &&
      rule.goalId === args.goalId &&
      rule.subtaskId === args.subtaskId
  );
}

function getAutomationPromptKey(args: {
  eventTitle: string;
  goalId: string;
  subtaskId: string;
  promptType: "suggest_subtask" | "auto_link" | "auto_apply_duration";
}) {
  const normalizedTitle = normalizeCalendarRuleMatchText(args.eventTitle);

  return [
    args.promptType,
    normalizedTitle,
    args.goalId,
    args.subtaskId,
  ].join(":");
}

function hasMatchingCalendarRule(args: {
  calendarRules: Array<{
    type: string;
    matchText?: string | null;
    goalId?: string | null;
    subtaskId?: string | null;
  }>;
  eventTitle: string;
  goalId: string;
  subtaskId: string;
  promptType: "suggest_subtask" | "auto_link" | "auto_apply_duration";
}) {
  const normalizedTitle = normalizeCalendarRuleMatchText(args.eventTitle);
  if (!normalizedTitle) return false;

  return args.calendarRules.some(
    (rule) =>
      rule.type === args.promptType &&
      rule.goalId === args.goalId &&
      rule.subtaskId === args.subtaskId &&
      rule.matchText === normalizedTitle
  );
}

function getAutomationPromptTitle(promptType: "suggest_subtask" | "auto_link" | "auto_apply_duration") {
  switch (promptType) {
    case "suggest_subtask":
      return "Remember this match?";
    case "auto_link":
      return "Enable automatic linking too?";
    case "auto_apply_duration":
      return "Enable automatic duration updates?";
    default:
      return "Save automation preference?";
  }
}

function getAutomationPromptBody(args: {
  promptType: "suggest_subtask" | "auto_link" | "auto_apply_duration";
  subtaskTitle: string;
  eventTitle: string;
}) {
  switch (args.promptType) {
    case "suggest_subtask":
      return `"${args.subtaskTitle}" can be suggested for similar "${args.eventTitle}" events in the future.`;
    case "auto_link":
      return `"${args.subtaskTitle}" can also be linked automatically for similar "${args.eventTitle}" events.`;
    case "auto_apply_duration":
      return `"${args.subtaskTitle}" can automatically receive duration updates for similar "${args.eventTitle}" events.`;
    default:
      return `"${args.subtaskTitle}" can be reused for similar "${args.eventTitle}" events.`;
  }
}

function getAutomationPromptPrimaryLabel(
  promptType: "suggest_subtask" | "auto_link" | "auto_apply_duration"
) {
  switch (promptType) {
    case "suggest_subtask":
      return "Remember suggestion";
    case "auto_link":
      return "Enable auto-link";
    case "auto_apply_duration":
      return "Enable auto-apply";
    default:
      return "Save";
  }
}

function canShowQuickSuggestedApply(args: {
  suggestedTaskMatch:
    | {
        mode: "single" | "ambiguous";
        topMatch: {
          item: CalendarItem & { date: Date };
          score: number;
          reasons: string[];
        };
        secondMatch?: {
          item: CalendarItem & { date: Date };
          score: number;
          reasons: string[];
        };
      }
    | null;
  subtasksByGoal: Record<string, any[]>;
}) {
  if (!args.suggestedTaskMatch) return false;
  if (args.suggestedTaskMatch.mode !== "single") return false;

  const suggestedItem = args.suggestedTaskMatch.topMatch.item;
  if (!suggestedItem?.goalId || !suggestedItem?.subtaskId) return false;

  const goalSubtasks = args.subtasksByGoal[suggestedItem.goalId] ?? [];
  const baseSubtask =
    goalSubtasks.find((s) => s.id === suggestedItem.subtaskId) ?? null;

  if (!baseSubtask) return false;

  const isOneTime =
    baseSubtask?.scheduleType === "oneTime" ||
    baseSubtask?.frequency === "once";

  const isOnceAlreadyCompleted =
    baseSubtask?.frequency === "once" &&
    baseSubtask?.firstCompletedAtMs != null;

  if (isOnceAlreadyCompleted) return false;

  const linkedEventId =
    typeof baseSubtask?.linkedCalendarEventId === "string" &&
    baseSubtask.linkedCalendarEventId.trim().length > 0
      ? baseSubtask.linkedCalendarEventId.trim()
      : null;

  if (
    isOneTime &&
    linkedEventId &&
    linkedEventId !== suggestedItem.linkedCalendarEventId
  ) {
    return false;
  }

  return true;
}

function getEventActionSuccessTitle(action: "link_only" | "link_and_use_time") {
  switch (action) {
    case "link_only":
      return "Event linked";
    case "link_and_use_time":
      return "Event linked and time updated";
    default:
      return "Update complete";
  }
}

function getEventActionSuccessMessage(args: {
  action: "link_only" | "link_and_use_time";
  eventTitle: string;
  subtaskTitle: string;
}) {
  switch (args.action) {
    case "link_only":
      return `"${args.subtaskTitle}" is now linked to "${args.eventTitle}" for this event.\n\nYou can optionally save this as a future automation preference.`;
    case "link_and_use_time":
      return `"${args.subtaskTitle}" is now linked to "${args.eventTitle}" and its scheduled time was updated for this event.\n\nYou can optionally save this as a future automation preference.`;
    default:
      return `"${args.subtaskTitle}" was updated from "${args.eventTitle}".`;
  }
}

function getAutomationRuleSuccessMessage(args: {
  type: "auto_link" | "auto_apply_duration" | "suggest_subtask";
  subtaskTitle: string;
}) {
  switch (args.type) {
    case "auto_link":
      return `"${args.subtaskTitle}" will now auto-link for similar future events.`;
    case "auto_apply_duration":
      return `"${args.subtaskTitle}" will now receive duration automatically for similar future events.`;
    case "suggest_subtask":
      return `"${args.subtaskTitle}" will now be suggested for similar future events.`;
    default:
      return `"${args.subtaskTitle}" will now be reused for similar future events.`;
  }
}

