useEffect(() => {
  if (!authReady || !user) return;

  let cancelled = false;

  async function loadSelectedDay() {
    const uid = auth.currentUser?.uid;
    if (!uid) return;

    const setForDay = new Set<string>();

    const qy = query(
      collectionGroup(db, "completions"),
      where("userId", "==", uid),
      where("dayKey", "==", selectedDayKey)
    );

    const snap = await getDocs(qy);

    snap.forEach((d) => {
      const data: any = d.data();
      if (!data?.goalId || !activeGoalIds.has(data.goalId)) return;
      if (data?.goalId && data?.subtaskId) {
        setForDay.add(completionKey(data.goalId, data.subtaskId));
      }
    });

    if (!cancelled) {
      setCompletedByDayKey((prev) => {
        const next = new Map(prev);
        next.set(selectedDayKey, setForDay);
        return next;
      });
    }
  }

  loadSelectedDay().catch((e) =>
    console.error("load selected day completions failed", e)
  );

  return () => {
    cancelled = true;
  };
}, [authReady, user, selectedDayKey, activeGoalIds]);



useEffect(() => {
  if (!authReady || !user) return;

  let cancelled = false;

  async function loadSelectedDayGoalCompletions() {
    const uid = auth.currentUser?.uid;
    if (!uid) return;

    const rows = await getGoalCompletionsForDay(uid, selectedDayKey);

    if (!cancelled) {
      setGoalCompletionsForSelectedDay(rows);
    }
  }

  loadSelectedDayGoalCompletions().catch((e) =>
    console.error("load selected day goal completions failed", e)
  );

  return () => {
    cancelled = true;
  };
}, [authReady, user, selectedDayKey]);

  // Subtasks subscriptions per goal
  useEffect(() => {
    const existing = subtasksUnsubsRef.current;
   const goalIds = new Set(visibleGoals.map((g) => g.id));

    Object.keys(existing).forEach((gid) => {
      if (!goalIds.has(gid)) {
        existing[gid]?.();
        delete existing[gid];
        setSubtasksByGoal((prev) => {
          const next = { ...prev };
          delete next[gid];
          return next;
        });
      }
    });

    visibleGoals.forEach((g) => {
      if (existing[g.id]) return;

      const ref = collection(db, "goals", g.id, "subtasks");
      const q = query(ref, orderBy("createdAtMs", "desc"));

      existing[g.id] = onSnapshot(
        q,
        (snap) => {
          const list = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
          setSubtasksByGoal((prev) => ({ ...prev, [g.id]: list }));
        },
        (err) => console.error(err)
      );
    });

    return () => {
      Object.values(existing).forEach((fn) => fn?.());
      subtasksUnsubsRef.current = {};
    };
}, [visibleGoals]);

useEffect(() => {
  if (!authReady || !user) return;
  if (!calendarIntegration?.connected) {
    setGoogleEventsByDayKey({});
    return;
  }

  const uid = auth.currentUser?.uid;
  if (!uid) return;

  let startDayKey: string;
  let endDayKey: string;

  if (mode === "month") {
    const r = monthRangeDayKeys(selectedDate, tz);
    startDayKey = r.startDayKey;
    endDayKey = r.endDayKey;
  } else if (mode === "week") {
    const r = weekRangeDayKeys(weekDates, tz);
    startDayKey = r.startDayKey;
    endDayKey = r.endDayKey;
  } else {
    startDayKey = selectedDayKey;
    endDayKey = selectedDayKey;
  }

 const ref = collection(db, "users", uid, "calendarEvents");
const qy = query(
  ref,
  where("startDayKey", "<=", endDayKey),
  where("endDayKey", ">=", startDayKey),
  orderBy("startDayKey"),
  orderBy("startMs")
);

  const unsub = onSnapshot(
    qy,
    (snap) => {
      const next: Record<string, GoogleCalendarEvent[]> = {};

      snap.forEach((docSnap) => {
  const data = docSnap.data() as GoogleCalendarEvent;

  const startKey = data.startDayKey;
  const finalKey = data.endDayKey || data.startDayKey;

  if (!startKey || !finalKey) return;

  let cursor = startKey;

  while (cursor <= finalKey) {
    if (!next[cursor]) next[cursor] = [];
    next[cursor].push({ ...data, id: docSnap.id });

    const cursorDate = new Date(`${cursor}T12:00:00`);
    const nextDate = addDays(cursorDate, 1);
    cursor = dayKeyFromDate(nextDate, tz);
  }
});
  Object.values(next).forEach((events) => {
    events.sort((a, b) => a.startMs - b.startMs);
  });
      setGoogleEventsByDayKey(next);
    },
    (err) => {
      console.error("google events subscription failed", err);
    }
  );

  return () => unsub();
}, [authReady, user, mode, selectedDate, selectedDayKey, weekDates, tz, calendarIntegration]);



useEffect(() => {
  if (!authReady || !user) return;

  const uid = auth.currentUser?.uid;
  if (!uid) return;

  let startDayKey: string;
