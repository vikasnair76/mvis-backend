};
type ViewMode = "day" | "week" | "month";

type CalendarItem = {
  goalId: string;
  goalTitle: string;
  subtaskId: string;
  title: string;
    isSharedAssigned?: boolean;
  sharedSourceGroupName?: string | null;
  frequency?: string;
