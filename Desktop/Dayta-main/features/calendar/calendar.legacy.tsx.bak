const DEFAULT_SUGGESTED_SLOT_MINUTES = 30;
const DEFAULT_TOMORROW_MORNING_HOUR = 9;

function dayStartMs(d: Date) {
  return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
}

function isOneTimeSubtask(subtask: any) {
  return subtask?.scheduleType === "oneTime" || subtask?.frequency === "once";
}

function isGroupSharedGoal(goal: Goal): boolean {
  return (goal as any).visibility === "group_shared";
}

function addDays(d: Date, n: number) {
  return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
}
function addMonths(d: Date, n: number) {
  return new Date(d.getFullYear(), d.getMonth() + n, 1);
}

function formatMonthYear(d: Date) {
  return d.toLocaleDateString(undefined, { month: "long", year: "numeric" });
}
function startOfMonth(d: Date) {
  return new Date(d.getFullYear(), d.getMonth(), 1);
}

function daysInMonth(d: Date) {
  return new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate();
}

function startOfWeekSunday(d: Date) {
  const dow = d.getDay(); // 0=Sun
  return new Date(d.getFullYear(), d.getMonth(), d.getDate() - dow);
}

function buildMonthGridDates(d: Date) {
  const first = startOfMonth(d);
  const gridStart = startOfWeekSunday(first);

  // 6 rows * 7 days = 42 cells
  const days: Date[] = [];
  for (let i = 0; i < 42; i++) days.push(addDays(gridStart, i));
  return days;
}

function sameDay(a: Date, b: Date) {
  return (
    a.getFullYear() === b.getFullYear() &&
    a.getMonth() === b.getMonth() &&
    a.getDate() === b.getDate()
  );
}

function parsePlanningDateTime(dateInput: string, timeInput: string): number | null {
  const dateParts = dateInput.trim().split("-");
  const timeParts = timeInput.trim().split(":");

  if (dateParts.length !== 3 || timeParts.length !== 2) return null;

  const [yearText, monthText, dayText] = dateParts;
  const [hourText, minuteText] = timeParts;

  if (
    !/^\d{4}$/.test(yearText) ||
    !/^\d{2}$/.test(monthText) ||
    !/^\d{2}$/.test(dayText) ||
    !/^\d{2}$/.test(hourText) ||
    !/^\d{2}$/.test(minuteText)
  ) {
    return null;
  }

  const year = Number(yearText);
  const month = Number(monthText);
  const day = Number(dayText);
  const hour = Number(hourText);
  const minute = Number(minuteText);

  if (![year, month, day, hour, minute].every(Number.isInteger)) return null;
  if (month < 1 || month > 12) return null;
  if (day < 1 || day > 31) return null;
  if (hour < 0 || hour > 23) return null;
  if (minute < 0 || minute > 59) return null;

  const date = new Date(year, month - 1, day, hour, minute, 0, 0);
  if (
    date.getFullYear() !== year ||
    date.getMonth() !== month - 1 ||
    date.getDate() !== day ||
    date.getHours() !== hour ||
    date.getMinutes() !== minute
  ) {
    return null;
  }

  return date.getTime();
}

function formatPlanningEventRange(event: PlanningCalendarEventDoc): string {
  const start = new Date(event.startAtMs);
  const end = new Date(event.endAtMs);
  const dateLabel = start.toLocaleDateString(undefined, {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
  const startLabel = start.toLocaleTimeString([], {
    hour: "2-digit",
    minute: "2-digit",
  });
  const endLabel = end.toLocaleTimeString([], {
    hour: "2-digit",
    minute: "2-digit",
  });

  return `${dateLabel} · ${startLabel} - ${endLabel}`;
}

function doesEventOverlapDate(
  event: {
    startMs: number | null;
    endMs?: number | null;
    allDay?: boolean;
  },
  date: Date
) {
  if (typeof event.startMs !== "number") return false;

  const { start, end } = dayRangeMs(date);

  const eventStart = event.startMs;
  const eventEnd =
    typeof event.endMs === "number" ? event.endMs : eventStart;

  // overlap condition: event intersects the day window
  return eventStart < end && eventEnd > start;
}

function formatPlanningEventDateLabel(event: PlanningCalendarEventDoc): string {
  const start = new Date(event.startAtMs);

  if (sameDay(start, new Date())) {
    return "Today";
  }
  if (sameDay(start, addDays(new Date(), 1))) {
    return "Tomorrow";
  }

  return start.toLocaleDateString(undefined, {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

function formatPlanningEventTimeRange(event: PlanningCalendarEventDoc): string {
  const start = new Date(event.startAtMs);
  const end = new Date(event.endAtMs);
  const startLabel = start.toLocaleTimeString([], {
    hour: "2-digit",
    minute: "2-digit",
  });
  const endLabel = end.toLocaleTimeString([], {
    hour: "2-digit",
    minute: "2-digit",
  });

  return `${startLabel} - ${endLabel}`;
}

function formatEventDurationLabel(event: {
  startMs: number;
  endMs: number | null;
}) {
  const minutes = getEventDurationMinutes(event);
  if (minutes == null) return null;

  if (minutes % 60 === 0) {
    const hours = minutes / 60;
    return `${hours} hr`;
  }

  if (minutes > 60) {
    const hours = Math.floor(minutes / 60);
    const remaining = minutes % 60;
    return `${hours} hr ${remaining} min`;
  }

  return `${minutes} min`;
}

function normalizeMatchText(value: unknown) {
  if (typeof value !== "string") return "";

  return value
    .toLowerCase()
    .replace(/[^a-z0-9\s]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function getMatchTokens(value: unknown) {
  const STOP_WORDS = new Set([
    "the",
    "and",
    "for",
    "with",
    "from",
    "this",
    "that",
    "daily",
    "weekly",
    "goal",
    "task",
    "event",
    "events",
    "work",
    "plan",
    "todo",
    "today",
    "read",
    "make",
    "do",
  ]);

  return normalizeMatchText(value)
    .split(" ")
    .map((token) => token.trim())
    .filter((token) => token.length >= 4)
    .filter((token) => !STOP_WORDS.has(token));
}

function countSharedTokens(a: string[], b: string[]) {
  if (a.length === 0 || b.length === 0) return 0;

  const bSet = new Set(b);
  let count = 0;

  for (const token of a) {
    if (bSet.has(token)) count += 1;
  }

  return count;
}

function isStrongExactTitleMatch(a: unknown, b: unknown) {
  const left = normalizeMatchText(a);
  const right = normalizeMatchText(b);

  if (!left || !right) return false;
  if (left !== right) return false;

  return left.length >= 4;
}

function hasReason(reasons: string[], reason: string) {
  return reasons.includes(reason);
}

function doesItemOverlapEventOnDate(
  item: CalendarItem & { date: Date },
  event: GoogleCalendarEvent
) {
  if (typeof item.dueAtMs !== "number") return false;
  if (typeof event.startMs !== "number") return false;

  const eventStart = event.startMs;
  const eventEnd =
    typeof event.endMs === "number" ? event.endMs : eventStart;

  const itemStart = item.dueAtMs;
  const itemEnd = itemStart + 60 * 60 * 1000; // assume 1 hour block

  return eventStart < itemEnd && eventEnd > itemStart;
}

function getCalendarMatchSuggestion(
  item: CalendarItem & { date: Date },
  events: GoogleCalendarEvent[],
  minimumScore: number = 35
): {
  event: GoogleCalendarEvent;
  score: number;
  reasons: string[];
} | null {
  if (events.length === 0) return null;

  const itemTitleNormalized = normalizeMatchText(item.title);
  const goalTitleNormalized = normalizeMatchText(item.goalTitle);

  const itemTokens = getMatchTokens(item.title);
  const goalTokens = getMatchTokens(item.goalTitle);

  let bestMatch: {
    event: GoogleCalendarEvent;
    score: number;
    reasons: string[];
  } | null = null;

  for (const calendarEvent of events) {
    const eventTitleNormalized = normalizeMatchText(calendarEvent.title);
    const eventTitleTokens = getMatchTokens(calendarEvent.title);

    let score = 0;
    const reasons: string[] = [];

    if (itemTitleNormalized && eventTitleNormalized) {
      if (isStrongExactTitleMatch(item.title, calendarEvent.title)) {
        score += 90;
        reasons.push("exact title");
      } else if (
        itemTitleNormalized.length >= 5 &&
        eventTitleNormalized.length >= 5 &&
        (eventTitleNormalized.includes(itemTitleNormalized) ||
          itemTitleNormalized.includes(eventTitleNormalized))
      ) {
        score += 12;
        reasons.push("title match");
      }
    }

    const sharedTitleTokens = countSharedTokens(itemTokens, eventTitleTokens);
    if (sharedTitleTokens >= 2) {
      score += 32;
      reasons.push("shared title terms");
    } else if (sharedTitleTokens === 1) {
      score += 12;
      reasons.push("shared title term");
    }

    const sharedItemTokens = countSharedTokens(itemTokens, eventTitleTokens);
if (sharedItemTokens >= 2) {
  score += 8;
  reasons.push("shared task terms");
} else if (sharedItemTokens === 1) {
  score += 3;
  reasons.push("shared task term");
}

    

    const sharedGoalTokens = countSharedTokens(goalTokens, eventTitleTokens);
    if (sharedGoalTokens > 0) {
      score += sharedGoalTokens * 8;
      reasons.push(
        sharedGoalTokens === 1 ? "shared goal term" : "shared goal terms"
      );
    }

    if (
      typeof item.dueAtMs === "number" &&
      doesItemOverlapEventOnDate(item, calendarEvent)
    ) {
      score += 20;
      reasons.push(
        calendarEvent.allDay ? "all-day overlap" : "time overlap"
      );
    }

    if (
      typeof item.linkedCalendarEventId === "string" &&
      item.linkedCalendarEventId.trim().length > 0 &&
      item.linkedCalendarEventId === calendarEvent.id
    ) {
      score += 100;
      reasons.push("already linked");
    }

    if (!bestMatch || score > bestMatch.score) {
      bestMatch = {
        event: calendarEvent,
        score,
        reasons,
      };
    }
  }

  if (!bestMatch) return null;
  if (bestMatch.score < minimumScore) return null;

  return bestMatch;
}

function formatCalendarSuggestionReasonLabel(reasons: string[]) {
  if (reasons.length === 0) return "Possible match";
  return reasons.slice(0, 2).join(" • ");
}

function getVisibleSuggestionReasonLabels(
  reasons: string[] | undefined,
  limit = 3
) {
  if (!Array.isArray(reasons) || reasons.length === 0) return [];

  const formatted = formatCalendarSuggestionReasonLabel(reasons);

  const labels = formatted
    .split("•")
    .map((label) => label.trim())
    .filter((label) => Boolean(label));

  const seen = new Set<string>();
  const deduped: string[] = [];

  for (const label of labels) {
    const key = label.toLowerCase();

    if (seen.has(key)) continue;

    seen.add(key);
    deduped.push(label);

    if (deduped.length >= limit) {
      break;
    }
  }

  return deduped;
}

function getTaskSuggestionForEvent(
  event: GoogleCalendarEvent,
  items: Array<CalendarItem & { date: Date }>,
  calendarRules: CalendarRuleRecord[]
): {
  mode: "single" | "ambiguous";
  topMatch: {
    item: CalendarItem & { date: Date };
    score: number;
    reasons: string[];
  };
  secondMatch?: {
    item: CalendarItem & { date: Date };
    score: number;
    reasons: string[];
  };
} | null {
  if (items.length === 0) return null;

  const matches: Array<{
    item: CalendarItem & { date: Date };
    score: number;
    reasons: string[];
  }> = [];

 for (const item of items) {
  const match = getCalendarMatchSuggestion(item, [event], 24);

  const matchingRules = calendarRules.filter(
    (rule) =>
      rule.type === "suggest_subtask" &&
      rule.goalId === item.goalId &&
      rule.subtaskId === item.subtaskId
  );

  const ruleBoost = matchingRules.reduce((best, rule) => {
    const next = getSuggestSubtaskRuleBoost({
      eventTitle: event.title,
      ruleMatchText: rule.matchText,
    });
    return next > best ? next : best;
  }, 0);

  console.log("[Calendar] event-side candidate check", {
    eventTitle: event.title,
    taskTitle: item.title,
    goalTitle: item.goalTitle,
    matched: !!match,
    score: match?.score ?? null,
    ruleBoost,
    reasons: match?.reasons ?? [],
  });

  if (!match) continue;

  if (ruleBoost > 0) {
    console.log("[CalendarRules] suggest_subtask boost", {
      eventTitle: event.title,
      goalId: item.goalId,
      subtaskId: item.subtaskId,
      ruleBoost,
    });
  }

  matches.push({
    item,
    score: match.score + ruleBoost,
    reasons:
      ruleBoost > 0
        ? [...match.reasons, "saved preference"]
        : match.reasons,
  });
}

  if (matches.length === 0) return null;

  matches.sort((a, b) => b.score - a.score);

  console.log("[Calendar] event-side sorted matches", {
  eventTitle: event.title,
  matches: matches.map((m) => ({
    taskTitle: m.item.title,
    goalTitle: m.item.goalTitle,
    score: m.score,
    reasons: m.reasons,
  })),
});

 const topMatch = matches[0];
const secondMatch = matches[1];

if (topMatch.score < 40) return null;

if (!secondMatch || secondMatch.score < 20) {
  return {
    mode: "single",
    topMatch,
  };
}

const bothHaveStrongTitleOverlap =
  hasReason(topMatch.reasons, "shared title terms") &&
  hasReason(secondMatch.reasons, "shared title terms");

const topIsExactTitle = hasReason(topMatch.reasons, "exact title");
const secondIsExactTitle = hasReason(secondMatch.reasons, "exact title");

if (
  bothHaveStrongTitleOverlap &&
  !topIsExactTitle &&
  !secondIsExactTitle
) {
  return {
    mode: "ambiguous",
    topMatch,
    secondMatch,
  };
}

if (topMatch.score - secondMatch.score >= 8) {
  return {
    mode: "single",
    topMatch,
  };
}

return {
  mode: "ambiguous",
  topMatch,
  secondMatch,
};
}

function getApplyPanelSavedRuleSuggestion(args: {
  eventTitle: string;
  subtasks: any[];
  goalId: string | null;
  calendarRules: CalendarRuleRecord[];
}) {
  if (!args.goalId) return null;
  if (!args.eventTitle) return null;
  if (args.subtasks.length === 0) return null;

  let best: {
    subtaskId: string;
    subtaskTitle: string;
    boost: number;
  } | null = null;

  for (const subtask of args.subtasks) {
    const matchingRules = args.calendarRules.filter(
      (rule) =>
        rule.type === "suggest_subtask" &&
        rule.goalId === args.goalId &&
        rule.subtaskId === subtask.id
    );

    const boost = matchingRules.reduce((bestBoost, rule) => {
      const next = getSuggestSubtaskRuleBoost({
        eventTitle: args.eventTitle,
        ruleMatchText: rule.matchText,
      });
      return next > bestBoost ? next : bestBoost;
    }, 0);

    if (boost <= 0) continue;

    if (!best || boost > best.boost) {
      best = {
        subtaskId: subtask.id,
        subtaskTitle:
          typeof subtask?.title === "string" && subtask.title.trim().length > 0
            ? subtask.title.trim()
            : "Subtask",
        boost,
      };
    }
  }

  return best;
}

