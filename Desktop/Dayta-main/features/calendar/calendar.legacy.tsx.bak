      typeof subtask.title === "string" && subtask.title.trim().length > 0
        ? `Updated "${subtask.title.trim()}" to match event`
        : "Updated to match event",
  });
}

        const subtaskRef = doc(db, "goals", changed.goalId, "subtasks", subtaskId);
