});


const goPrev = () => {
  if (mode === "month") {
    setSelectedDate((d) => addMonths(d, -1));
  } else if (mode === "week") {
    setSelectedDate((d) => addDays(d, -7));
  } else {
    setSelectedDate((d) => addDays(d, -1));
  }
};

const goNext = () => {
  if (mode === "month") {
    setSelectedDate((d) => addMonths(d, +1));
  } else if (mode === "week") {
    setSelectedDate((d) => addDays(d, +7));
  } else {
    setSelectedDate((d) => addDays(d, +1));
  }
};

