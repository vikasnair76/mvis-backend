          )}

          {entry.type === "conflict" && (
  <>
    {!entry.suggestedSlot && sameDay(entry.item.date, new Date()) && (
      <Pressable
        onPress={() => handleReassignTomorrowMorning(entry.item)}
        disabled={pendingAnyOverrideAction}
        style={[
          styles.recoverySecondaryBtn,
