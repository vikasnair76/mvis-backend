useEffect(() => {
  return () => {
    if (linkedEventFollowToastTimeoutRef.current) {
      clearTimeout(linkedEventFollowToastTimeoutRef.current);
    }
  };
}, []);

useEffect(() => {
  if (!authReady || !user) {
    setLatestLinkedEventHistoryBySubtaskId({});
    return;
  }

  const linkedSubtasks = calendarSubtasks.filter(
    (subtask) =>
      typeof subtask.linkedCalendarEventId === "string" &&
      subtask.linkedCalendarEventId.trim().length > 0
  );

  if (linkedSubtasks.length === 0) {
    setLatestLinkedEventHistoryBySubtaskId({});
    return;
  }

  const unsubscribers: Array<() => void> = [];

  for (const subtask of linkedSubtasks) {
    const historyRef = collection(
      db,
      "goals",
      subtask.goalId,
      "subtasks",
      subtask.id,
      "linkedEventHistory"
    );

    const qy = query(
      historyRef,
      orderBy("handledAtMs", "desc"),
      limit(1)
    );

    const unsub = onSnapshot(
      qy,
      (snap) => {
        if (snap.empty) {
          setLatestLinkedEventHistoryBySubtaskId((prev) => {
            if (!(subtask.id in prev)) return prev;
            const next = { ...prev };
            delete next[subtask.id];
            return next;
          });
          return;
        }

        const docSnap = snap.docs[0];
        const data = docSnap.data() as any;

        setLatestLinkedEventHistoryBySubtaskId((prev) => ({
          ...prev,
         [subtask.id]: {
  decision:
    typeof data?.decision === "string" ? data.decision : null,
  reason:
    typeof data?.reason === "string" ? data.reason : null,
  previousHandledStartMs:
    typeof data?.previousHandledStartMs === "number"
      ? data.previousHandledStartMs
      : null,
  nextEventStartMs:
    typeof data?.nextEventStartMs === "number"
      ? data.nextEventStartMs
      : null,
  handledAtMs:
    typeof data?.handledAtMs === "number"
      ? data.handledAtMs
      : null,
  oldOverrideDueAtMs:
    typeof data?.oldOverrideDueAtMs === "number"
      ? data.oldOverrideDueAtMs
      : null,
  oldOverrideSource:
    typeof data?.oldOverrideSource === "string"
      ? data.oldOverrideSource
      : null,
},
        }));
      },
      (err) => {
        console.error("latest linked event history subscription failed", {
          goalId: subtask.goalId,
          subtaskId: subtask.id,
          error: err,
        });
      }
    );

    unsubscribers.push(unsub);
  }

  return () => {
    unsubscribers.forEach((unsub) => unsub());
  };
}, [authReady, user, calendarSubtasks]);

useEffect(() => {
  if (!authReady || !user) return;

  let cancelled = false;

  const run = async () => {
    for (const subtask of linkedCalendarSubtasks) {
      if (cancelled) break;

      const linkedEventId =
        typeof subtask.linkedCalendarEventId === "string"
          ? subtask.linkedCalendarEventId.trim()
          : "";

      if (!linkedEventId) continue;

      const linkedEventExists = allGoogleEventsById.has(linkedEventId);

      const uid = auth.currentUser?.uid ?? null;

const isSharedAssignedSubtask =
  !!uid &&
  subtask.userId !== uid &&
  subtask.assignedToUid === uid;

if (isSharedAssignedSubtask) {
  return;
}

      const syncKey = `${subtask.goalId}:${subtask.id}:${linkedEventExists ? "present" : "missing"}`;

      if (syncingMissingLinkedEventKeysRef.current.has(syncKey)) {
        continue;
      }

      const lastKnownMissing =
        subtask.linkedCalendarLastKnownMissing === true;

      const currentEvent =
  linkedEventExists && subtask.linkedCalendarEventId
    ? linkedGoogleEventsById[subtask.linkedCalendarEventId] ??
      allGoogleEventsById.get(subtask.linkedCalendarEventId)
    : null;  

      if (!linkedEventExists && lastKnownMissing) {
        continue;
      }

      if (
        linkedEventExists &&
        subtask.linkedCalendarLastKnownMissing !== true &&
        subtask.linkedCalendarMissingAtMs == null
      ) {
        continue;
      }

      syncingMissingLinkedEventKeysRef.current.add(syncKey);

      try {
        const subtaskRef = doc(db, "goals", subtask.goalId, "subtasks", subtask.id);

       if (!linkedEventExists) {
  const now = Date.now();
  const nextMissingAtMs =
    typeof subtask.linkedCalendarMissingAtMs === "number"
      ? subtask.linkedCalendarMissingAtMs
      : now;

  await updateDoc(subtaskRef, {
    linkedCalendarLastKnownMissing: true,
    linkedCalendarMissingAtMs: nextMissingAtMs,
  });

  applyLocalSubtaskPatch(subtask.goalId, subtask.id, {
    linkedCalendarLastKnownMissing: true,
    linkedCalendarMissingAtMs: nextMissingAtMs,
  });

  if (!lastKnownMissing) {
    await writeLinkedEventHistory({
